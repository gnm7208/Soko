      "html": "<style>\n  :root{\n    --ink: #ffffff;\n    --ink-dim: rgba(255,255,255,0.82);\n    --ink-faint: rgba(255,255,255,0.6);\n    --pill-bg: rgba(20,28,34,0.45);\n    --pill-border: rgba(255,255,255,0.22);\n    --cta-bg: #ffffff;\n    --cta-ink: #14202a;\n    --font-sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, Helvetica, Arial, sans-serif;\n    --font-serif: \"Fraunces\", Georgia, \"Times New Roman\", serif;\n  }\n\n  *{ box-sizing:border-box; margin:0; padding:0; }\n  html,body{ height:100%; }\n  body{\n    font-family:var(--font-sans);\n    color:var(--ink);\n    -webkit-font-smoothing:antialiased;\n    background:#141d26;\n  }\n\n  .hero{\n    position:relative;\n    min-height:100vh;\n    display:flex;\n    flex-direction:column;\n    overflow:hidden;\n    isolation:isolate;\n  }\n  .hero-bg{\n    position:absolute;\n    inset:0;\n    z-index:-2;\n    width:100%;\n    height:100%;\n    object-fit:cover;\n    object-position:center 62%;\n  }\n  .hero::after{\n    content:\"\";\n    position:absolute;\n    inset:0;\n    z-index:-1;\n    background:\n      linear-gradient(to bottom, rgba(10,16,22,0.42) 0%, rgba(10,16,22,0.05) 32%, rgba(10,16,22,0.08) 62%, rgba(8,12,17,0.72) 100%);\n  }\n\n  /* ---------- Nav ---------- */\n  .nav{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:22px 40px;\n  }\n  .nav-left{ display:flex; align-items:center; gap:44px; }\n  .brand{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    font-size:20px;\n    font-weight:700;\n    letter-spacing:-0.02em;\n    color:var(--ink);\n    text-decoration:none;\n  }\n  .brand svg{ display:block; }\n  .nav-links{ display:flex; align-items:center; gap:30px; }\n  .nav-link{\n    display:flex;\n    align-items:center;\n    gap:6px;\n    color:var(--ink-dim);\n    font-size:15px;\n    font-weight:500;\n    text-decoration:none;\n  }\n  .nav-link:hover{ color:var(--ink); }\n  .nav-link svg{ opacity:0.7; }\n  .nav-right{ display:flex; align-items:center; gap:22px; }\n  .signin{\n    color:var(--ink-dim);\n    font-size:15px;\n    font-weight:500;\n    text-decoration:none;\n  }\n  .signin:hover{ color:var(--ink); }\n  .btn-nav{\n    background:var(--cta-bg);\n    color:var(--cta-ink);\n    font-size:15px;\n    font-weight:600;\n    padding:12px 22px;\n    border-radius:999px;\n    text-decoration:none;\n    transition:transform 0.15s ease;\n  }\n  .btn-nav:hover{ transform:translateY(-1px); }\n\n  /* ---------- Center ---------- */\n  .center{\n    flex:1;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    text-align:center;\n    padding:60px 24px 40px;\n  }\n  .badge{\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    background:var(--pill-bg);\n    border:1px solid var(--pill-border);\n    backdrop-filter:blur(8px);\n    color:var(--ink-dim);\n    font-size:12px;\n    font-weight:600;\n    letter-spacing:0.14em;\n    text-transform:uppercase;\n    padding:9px 18px;\n    border-radius:999px;\n    text-decoration:none;\n    margin-bottom:34px;\n  }\n  .badge .dot{\n    width:7px; height:7px;\n    border-radius:50%;\n    background:#fff;\n    box-shadow:0 0 8px rgba(255,255,255,0.9);\n  }\n  .badge svg{ opacity:0.7; }\n\n  h1{\n    font-family:var(--font-serif);\n    font-weight:300;\n    font-size:clamp(44px, 6.4vw, 92px);\n    line-height:1.08;\n    letter-spacing:-0.01em;\n    max-width:18ch;\n    text-shadow:0 2px 30px rgba(10,16,22,0.35);\n  }\n  .sub{\n    margin-top:22px;\n    font-size:17px;\n    font-weight:400;\n    color:var(--ink-dim);\n  }\n  .btn-hero{\n    margin-top:34px;\n    display:inline-block;\n    background:var(--cta-bg);\n    color:var(--cta-ink);\n    font-size:16px;\n    font-weight:600;\n    padding:15px 30px;\n    border-radius:999px;\n    text-decoration:none;\n    box-shadow:0 10px 34px -10px rgba(8,12,17,0.6);\n    transition:transform 0.15s ease;\n  }\n  .btn-hero:hover{ transform:translateY(-2px); }\n\n  /* ---------- Logo row ---------- */\n  .logos{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    flex-wrap:wrap;\n    gap:26px 56px;\n    padding:26px 40px 54px;\n  }\n  .logo-item{\n    display:flex;\n    align-items:center;\n    gap:9px;\n    color:rgba(255,255,255,0.78);\n    font-size:15px;\n    font-weight:700;\n    letter-spacing:0.06em;\n  }\n  .logo-item.spaced{ letter-spacing:0.3em; font-weight:500; font-size:13px; }\n  .logo-item.script{ font-family:var(--font-serif); font-style:italic; font-weight:400; font-size:19px; letter-spacing:0; text-transform:none; }\n  .logo-item svg{ display:block; opacity:0.85; }\n\n  @media (max-width:900px){\n    .nav{ padding:18px 20px; }\n    .nav-links{ display:none; }\n    .logos{ gap:18px 32px; }\n  }\n</style>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&display=swap\" rel=\"stylesheet\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n\n<section class=\"hero\">\n  <img class=\"hero-bg\" src=\"https://images.pexels.com/photos/5499545/pexels-photo-5499545.jpeg?auto=compress&cs=tinysrgb&w=2000\" alt=\"Misty mountain ridges under a soft pink dusk sky — Diana ✨ on Pexels\" style=\"width:100%;height:100%;\" width=\"1920\" height=\"1280\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n\n  <nav class=\"nav\">\n    <div class=\"nav-left\">\n      <a class=\"brand\" href=\"#\">\n        <svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\"><circle cx=\"13\" cy=\"13\" r=\"12\" fill=\"#fff\"/><path d=\"M13 4a9 9 0 0 0 0 18c-3.2-2.2-5-5.4-5-9s1.8-6.8 5-9Z\" fill=\"#141d26\"/><path d=\"M13 7.5a6.8 6.8 0 0 0 0 11c-1.9-1.5-3-3.4-3-5.5s1.1-4 3-5.5Z\" fill=\"#141d26\" opacity=\"0.55\"/></svg>\n        Halcyon\n      </a>\n      <div class=\"nav-links\">\n        <a class=\"nav-link\" href=\"#\">Product\n          <svg width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\"><path d=\"m1 1 4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </a>\n        <a class=\"nav-link\" href=\"#\">Company\n          <svg width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\"><path d=\"m1 1 4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </a>\n      </div>\n    </div>\n    <div class=\"nav-right\">\n      <a class=\"signin\" href=\"#\">Sign in</a>\n      <a class=\"btn-nav\" href=\"#\">Talk to us</a>\n    </div>\n  </nav>\n\n  <div class=\"center\">\n    <a class=\"badge\" href=\"#\">\n      <span class=\"dot\"></span>\n      Halcyon raises $48M Series A\n      <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"m9 6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </a>\n    <h1>AI that answers like a person. Resolves millions of calls.</h1>\n    <p class=\"sub\">Voice agents for enterprise support</p>\n    <a class=\"btn-hero\" href=\"#\">Talk to us</a>\n  </div>\n\n  <div class=\"logos\">\n    <span class=\"logo-item spaced\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><circle cx=\"8\" cy=\"8\" r=\"7\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M4.5 8h7M8 4.5v7\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>\n      NORTHBEAM\n    </span>\n    <span class=\"logo-item script\">Riviera</span>\n    <span class=\"logo-item\">\n      <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 12 7.5 2 13 12H2Z\" fill=\"currentColor\"/></svg>\n      LATTICEWORK\n    </span>\n    <span class=\"logo-item\">ferrostreet</span>\n    <span class=\"logo-item spaced\">\n      <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><rect x=\"2\" y=\"2\" width=\"11\" height=\"11\" rx=\"3\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg>\n      OTTOPAY\n    </span>\n  </div>\n</section>\n",
