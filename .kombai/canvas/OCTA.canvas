      "html": "<style>\n:root{\n  --page:#0b0a0c;\n  --card:#eee3f7;        /* main lilac */\n  --card-lite:#f6eefb;   /* pale lilac */\n  --chip:#ffffff;\n  --ink:#1e1526;\n  --ink-soft:#57495f;\n  --ink-faint:#8d7f96;\n  --plum:#a06cd5;\n  --plum-deep:#7c4bb0;\n  --rise:#1fa04c;\n  --dip:#d0578b;\n  --radius:20px;\n  --gap:12px;\n  --pad:20px;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nbutton:focus-visible,a:focus-visible,[role=\"button\"]:focus-visible{outline:2px solid currentColor;outline-offset:2px}\nbody{\n  font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n  background:var(--page);color:var(--ink);\n  -webkit-font-smoothing:antialiased;\n  min-height:100vh;display:flex;align-items:center;justify-content:center;\n  padding:clamp(10px,2.5vw,28px);overflow-x:hidden;\n}\n.bento{\n  width:min(1120px,100%);\n  display:grid;\n  grid-template-columns:1fr 1.05fr 1.05fr 1.15fr;\n  grid-template-rows:170px 150px 118px 142px;\n  gap:var(--gap);\n}\n.card{\n  background:var(--card);\n  border-radius:var(--radius);\n  position:relative;overflow:hidden;\n  transition:transform .25s ease;\n}\n.card:hover{transform:translateY(-3px)}\n\n/* ---- funding (c1 r1-2) ---- */\n.funding{grid-row:1 / 3;padding:var(--pad);display:flex;flex-direction:column;align-items:center;text-align:center}\n.funding .t{font-size:13px;font-weight:700;line-height:1.35}\n.funding .ring{position:relative;width:112px;height:112px;margin:14px 0 12px}\n.funding .ring svg{width:100%;height:100%;transform:rotate(-90deg)}\n.funding .ring .mid{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}\n.funding .ring .mid b{font-size:19px;font-weight:750}\n.funding .ring .mid span{font-size:7.5px;color:var(--ink-faint);letter-spacing:.04em}\n.funding .big{font-size:26px;font-weight:750;letter-spacing:-.02em}\n.funding .sub{font-size:10.5px;color:var(--ink-soft);line-height:1.4;margin-top:4px}\n\n/* ---- agency (c1 r3-4) ---- */\n.agency{grid-row:3 / 5;background:var(--card-lite);padding:18px;display:flex;flex-direction:column}\n.agency h2{font-size:15.5px;font-weight:700;line-height:1.55}\n.agency h2 span{background:#171219;color:#fff;padding:3px 9px;border-radius:7px;box-decoration-break:clone;-webkit-box-decoration-break:clone}\n.agency .ovals{margin-top:auto;display:flex;align-items:flex-end;gap:10px;position:relative}\n.agency .oval{border-radius:50% / 46%;overflow:hidden;position:relative;flex:0 0 auto}\n.agency .o1{width:96px;height:118px;background:linear-gradient(170deg,#cdb6e6 0%,#9d7cc4 60%,#5f4380 100%)}\n.agency .o2{width:74px;height:96px;background:linear-gradient(170deg,#3a2f45 0%,#241c2e 100%)}\n.agency .oval svg{position:absolute;left:50%;bottom:-2px;transform:translateX(-50%);width:82%}\n.agency .mini{position:absolute;right:2px;bottom:-4px;width:26px;height:26px;border-radius:50%;\n  background:linear-gradient(150deg,#e8d7f6,#b48ede);border:2px solid var(--card-lite)}\n\n/* ---- views (c2 r1) ---- */\n.views{background:var(--card-lite);padding:var(--pad)}\n.views .num{font-size:clamp(30px,3.2vw,40px);font-weight:750;letter-spacing:-.02em;display:flex;align-items:flex-start;gap:10px}\n.views .num svg{width:15px;height:15px;margin-top:8px}\n.views .lbl{font-size:12.5px;font-weight:700;margin-top:10px;line-height:1.35}\n\n/* ---- users (c3 r1) ---- */\n.users{background:var(--card-lite);padding:var(--pad);display:flex;flex-direction:column;align-items:flex-end;text-align:right}\n.users .lbl{font-size:13px;font-weight:600}\n.users .num{font-size:clamp(34px,3.6vw,46px);font-weight:750;letter-spacing:-.02em;margin-top:2px}\n.users .delta{font-size:14px;font-weight:700;color:var(--rise);margin-top:6px}\n\n/* ---- photo (c2-3 r2-3) ---- */\n.photo{grid-column:2 / 4;grid-row:2 / 4;\n  background:radial-gradient(75% 85% at 50% 62%,#e3d2f2 0%,#eee3f7 70%)}\n.photo .halo{position:absolute;left:50%;top:56%;transform:translate(-50%,-50%);width:64%;aspect-ratio:1;border-radius:50%;\n  background:radial-gradient(circle,#dcc6f0 0%,rgba(220,198,240,0) 72%)}\n.photo .fig{position:absolute;left:50%;bottom:0;transform:translateX(-50%);height:88%;}\n.chipf{position:absolute;background:var(--chip);border-radius:12px;box-shadow:0 10px 24px rgba(60,35,90,.16);z-index:3}\n.chip-age{top:8%;right:6%;padding:9px 12px;width:128px}\n.chip-age .ct{font-size:8.5px;font-weight:600;color:var(--ink-soft);margin-bottom:6px}\n.chip-trend{top:26%;left:5%;padding:10px;width:96px}\n.chip-play{top:60%;left:8%;padding:6px 12px 6px 6px;border-radius:99px;display:flex;align-items:center;gap:7px}\n.chip-play .pb{width:22px;height:22px;border-radius:50%;background:var(--plum-deep);display:flex;align-items:center;justify-content:center}\n.chip-play .pb svg{width:9px;height:9px;margin-left:1px}\n.chip-play b{font-size:11.5px}\n.chip-eng{bottom:7%;right:7%;padding:12px 14px;text-align:left}\n.chip-eng .pct{font-size:17px;font-weight:750}\n.chip-eng .lbl{font-size:9px;color:var(--ink-faint);margin:2px 0 6px}\n.chip-eng .delta{font-size:9.5px;font-weight:700;color:var(--rise)}\n.dot-acc{position:absolute;width:12px;height:12px;border-radius:50%;background:#e9c94d}\n.d1{right:22%;top:46%}\n\n/* ---- team (c4 r1-2) ---- */\n.team{grid-row:1 / 3;padding:var(--pad);display:flex;flex-direction:column}\n.team h2{font-size:16.5px;font-weight:700;line-height:1.4}\n.team .avs{display:flex;margin:16px 0}\n.team .av{width:32px;height:32px;border-radius:50%;border:2px solid var(--card);margin-left:-8px;flex:0 0 auto}\n.team .av:first-child{margin-left:0}\n.team .a1{background:linear-gradient(150deg,#f0c9a8,#c98d5a)}\n.team .a2{background:linear-gradient(150deg,#5c4a6e,#2e2438)}\n.team .a3{background:linear-gradient(150deg,#e8b4c8,#b06a8a)}\n.team .a4{background:linear-gradient(150deg,#b9d0e8,#6e8fb4)}\n.team .a5{background:linear-gradient(150deg,#d6c2ef,#9a72c8)}\n.team .plus{display:flex;align-items:center;justify-content:center;background:#dccbeb;font-size:10px;font-weight:700;color:var(--ink-soft)}\n.team .cl{font-size:15px;font-weight:700;line-height:1.3;margin-top:auto}\n.team .cn{font-size:clamp(30px,3vw,42px);font-weight:750;letter-spacing:-.02em;margin-top:2px}\n.team .cd{font-size:14px;font-weight:700;color:var(--dip);margin-top:4px}\n.team .spring{position:absolute;right:-26px;bottom:8%;width:104px;height:170px;pointer-events:none}\n\n/* ---- logo (c4 r3) ---- */\n.logo{background:var(--card-lite);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px}\n.logo svg{width:34px;height:30px}\n.logo .wm{font-size:25px;font-weight:750;letter-spacing:.06em}\n\n/* ---- font (c2 r4) ---- */\n.font{background:var(--card-lite);padding:var(--pad);display:flex;flex-direction:column}\n.font .t{font-size:21px;font-weight:750}\n.font .n{font-size:12px;color:var(--ink-soft);margin-top:4px}\n.font .sw{display:flex;gap:8px;margin-top:auto}\n.font .s{height:34px;flex:1;border-radius:9px}\n.font .s1{background:#2a2231}\n.font .s2{background:#aaa1b2}\n.font .s3{background:#b78ce0}\n.font .s4{background:#eadcf7;border:1px solid rgba(30,21,38,.08)}\n\n/* ---- wide (c3-4 r4) ---- */\n.wide{grid-column:3 / 5;padding:var(--pad) 24px;display:flex;align-items:center;gap:16px}\n.wide .tx h2{font-size:clamp(18px,2vw,23px);font-weight:750;letter-spacing:-.015em;line-height:1.25}\n.wide .tx p{font-size:11px;color:var(--ink-soft);margin-top:10px}\n.wide .ast{margin-left:auto;width:96px;height:96px;flex:0 0 auto}\n\n/* mini svg helpers */\n.bars rect{fill:#c9a8e8}\n.bars rect.hi{fill:#8250c0}\n\n/* responsive */\n@media (max-width:900px){\n  .bento{grid-template-columns:1fr 1fr;grid-template-rows:auto}\n  .funding{grid-row:auto;grid-column:1 / 2;min-height:300px}\n  .team{grid-row:auto;grid-column:2 / 3;min-height:300px}\n  .views{grid-column:1 / 2;min-height:150px}\n  .users{grid-column:2 / 3;min-height:150px}\n  .photo{grid-column:1 / 3;grid-row:auto;min-height:340px}\n  .agency{grid-row:auto;grid-column:1 / 2;min-height:280px}\n  .logo{grid-column:2 / 3;min-height:130px}\n  .font{grid-column:2 / 3;min-height:135px}\n  .wide{grid-column:1 / 3;min-height:150px}\n}\n@media (max-width:560px){\n  .bento{grid-template-columns:1fr}\n  .funding,.team,.views,.users,.photo,.agency,.logo,.font,.wide{grid-column:1 / 2}\n  .wide{flex-direction:column;align-items:flex-start}\n  .wide .ast{margin-left:0}\n}\n</style>\n\n<main class=\"bento\" aria-label=\"OCTA studio bento\">\n\n  <!-- funding -->\n  <section class=\"card funding\">\n    <p class=\"t\">Seed Round<br>progress</p>\n    <div class=\"ring\">\n      <svg viewBox=\"0 0 112 112\" aria-hidden=\"true\">\n        <circle cx=\"56\" cy=\"56\" r=\"48\" fill=\"none\" stroke=\"#241b2e\" stroke-width=\"9\"/>\n        <circle cx=\"56\" cy=\"56\" r=\"48\" fill=\"none\" stroke=\"#b78ce0\" stroke-width=\"9\" stroke-linecap=\"round\"\n          stroke-dasharray=\"205 302\"/>\n      </svg>\n      <div class=\"mid\"><b>68%</b><span>in progress</span></div>\n    </div>\n    <div class=\"big\">3.2K</div>\n    <p class=\"sub\">218 Backers in<br>the past year</p>\n  </section>\n\n  <!-- project views -->\n  <section class=\"card views\">\n    <div class=\"num\">5,214\n      <svg viewBox=\"0 0 24 24\" fill=\"#1e1526\" aria-hidden=\"true\"><path d=\"M12 21s-7.5-4.7-9.7-9.2C.8 8.6 2.9 5 6.4 5c2 0 3.7 1.1 4.6 2.8h2C13.9 6.1 15.6 5 17.6 5c3.5 0 5.6 3.6 4.1 6.8C19.5 16.3 12 21 12 21z\" transform=\"scale(.9) translate(1.3 1.3)\"/></svg>\n    </div>\n    <p class=\"lbl\">Case Views<br>last year</p>\n  </section>\n\n  <!-- new users -->\n  <section class=\"card users\">\n    <p class=\"lbl\">New Users</p>\n    <div class=\"num\">42K</div>\n    <div class=\"delta\">+12%</div>\n  </section>\n\n  <!-- team -->\n  <section class=\"card team\">\n    <h2>A crew of curious designers and engineers</h2>\n    <div class=\"avs\">\n      <span class=\"av a1\"></span><span class=\"av a2\"></span><span class=\"av a3\"></span>\n      <span class=\"av a4\"></span><span class=\"av a5\"></span><span class=\"av plus\">+2</span>\n    </div>\n    <p class=\"cl\">Weekly<br>New clients</p>\n    <div class=\"cn\">38</div>\n    <div class=\"cd\">+34%</div>\n    <svg class=\"spring\" viewBox=\"0 0 104 170\" aria-hidden=\"true\">\n      <defs>\n        <linearGradient id=\"chrome\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#fafafa\"/><stop offset=\".4\" stop-color=\"#9c9ca2\"/>\n          <stop offset=\".6\" stop-color=\"#e8e8ec\"/><stop offset=\"1\" stop-color=\"#77777d\"/>\n        </linearGradient>\n      </defs>\n      <g fill=\"none\" stroke=\"url(#chrome)\" stroke-width=\"11\" stroke-linecap=\"round\">\n        <path d=\"M18 22 C50 8 92 14 96 30\"/>\n        <path d=\"M14 52 C48 36 94 44 98 60\"/>\n        <path d=\"M12 82 C46 66 94 74 100 90\"/>\n        <path d=\"M14 112 C48 96 94 104 98 120\"/>\n        <path d=\"M18 142 C50 126 92 134 96 150\"/>\n      </g>\n    </svg>\n  </section>\n\n  <!-- center figure + chips -->\n  <section class=\"card photo\">\n    <div class=\"halo\"></div>\n    <svg class=\"fig\" viewBox=\"0 0 260 300\" aria-hidden=\"true\">\n      <defs>\n        <linearGradient id=\"figbody\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#b48ede\"/><stop offset=\"1\" stop-color=\"#7c4bb0\"/>\n        </linearGradient>\n        <linearGradient id=\"fighair\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#3d2f4c\"/><stop offset=\"1\" stop-color=\"#241b2e\"/>\n        </linearGradient>\n      </defs>\n      <!-- hair -->\n      <circle cx=\"130\" cy=\"64\" r=\"52\" fill=\"url(#fighair)\"/>\n      <!-- face -->\n      <circle cx=\"130\" cy=\"78\" r=\"30\" fill=\"#d9bef0\"/>\n      <!-- scarf -->\n      <path d=\"M86 116 C100 104 160 104 174 116 C182 122 182 136 172 140 L88 140 C78 136 78 122 86 116 Z\" fill=\"#cfaee9\"/>\n      <!-- torso -->\n      <path d=\"M62 300 C60 210 84 152 130 152 C176 152 200 210 198 300 Z\" fill=\"url(#figbody)\"/>\n      <!-- arms holding phone -->\n      <path d=\"M78 200 C86 230 106 246 128 248 L128 262 C98 262 72 240 66 208 Z\" fill=\"#8f60be\"/>\n      <path d=\"M182 200 C174 230 154 246 132 248 L132 262 C162 262 188 240 194 208 Z\" fill=\"#8f60be\"/>\n      <rect x=\"114\" y=\"234\" width=\"32\" height=\"48\" rx=\"7\" fill=\"#2a2133\"/>\n      <rect x=\"118\" y=\"239\" width=\"24\" height=\"38\" rx=\"4\" fill=\"#efe2fa\"/>\n    </svg>\n\n    <div class=\"chipf chip-age\">\n      <p class=\"ct\">Audience by Age</p>\n      <svg class=\"bars\" viewBox=\"0 0 104 34\" aria-hidden=\"true\">\n        <rect x=\"2\"  y=\"16\" width=\"9\" height=\"18\" rx=\"2.5\"/>\n        <rect x=\"18\" y=\"8\"  width=\"9\" height=\"26\" rx=\"2.5\" class=\"hi\"/>\n        <rect x=\"34\" y=\"2\"  width=\"9\" height=\"32\" rx=\"2.5\" class=\"hi\"/>\n        <rect x=\"50\" y=\"12\" width=\"9\" height=\"22\" rx=\"2.5\"/>\n        <rect x=\"66\" y=\"20\" width=\"9\" height=\"14\" rx=\"2.5\"/>\n        <rect x=\"82\" y=\"24\" width=\"9\" height=\"10\" rx=\"2.5\"/>\n      </svg>\n    </div>\n\n    <div class=\"chipf chip-trend\">\n      <svg viewBox=\"0 0 76 30\" aria-hidden=\"true\">\n        <path d=\"M2 26 L18 18 L32 22 L48 10 L62 14 L74 3\" fill=\"none\" stroke=\"#b0538c\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        <circle cx=\"74\" cy=\"3\" r=\"2.6\" fill=\"#b0538c\"/>\n      </svg>\n    </div>\n\n    <div class=\"chipf chip-play\">\n      <span class=\"pb\"><svg viewBox=\"0 0 10 10\" fill=\"#fff\"><path d=\"M1 0.5 9 5 1 9.5z\"/></svg></span>\n      <b>31,502</b>\n    </div>\n\n    <div class=\"chipf chip-eng\">\n      <div class=\"pct\">21.37%</div>\n      <div class=\"lbl\">Engagement Rate</div>\n      <div class=\"delta\">&#9650; 96.12%</div>\n    </div>\n    <span class=\"dot-acc d1\"></span>\n  </section>\n\n  <!-- agency headline + ovals -->\n  <section class=\"card agency\">\n    <h2><span>Bold Creative</span><br><span>Studio For Every</span><br><span>Brand</span></h2>\n    <div class=\"ovals\">\n      <div class=\"oval o1\">\n        <svg viewBox=\"0 0 80 70\" aria-hidden=\"true\">\n          <circle cx=\"40\" cy=\"24\" r=\"15\" fill=\"#33253f\"/>\n          <path d=\"M8 70 C10 48 22 40 40 40 C58 40 70 48 72 70 Z\" fill=\"#33253f\"/>\n        </svg>\n      </div>\n      <div class=\"oval o2\">\n        <svg viewBox=\"0 0 80 70\" aria-hidden=\"true\">\n          <circle cx=\"40\" cy=\"24\" r=\"15\" fill=\"#c7a6e6\"/>\n          <path d=\"M8 70 C10 48 22 40 40 40 C58 40 70 48 72 70 Z\" fill=\"#c7a6e6\"/>\n        </svg>\n      </div>\n      <span class=\"mini\"></span>\n    </div>\n  </section>\n\n  <!-- font specimen -->\n  <section class=\"card font\">\n    <div class=\"t\">Font</div>\n    <div class=\"n\">Nexa Grotesk</div>\n    <div class=\"sw\">\n      <span class=\"s s1\"></span><span class=\"s s2\"></span><span class=\"s s3\"></span><span class=\"s s4\"></span>\n    </div>\n  </section>\n\n  <!-- logo -->\n  <section class=\"card logo\">\n    <svg viewBox=\"0 0 34 30\" fill=\"none\" stroke=\"#1e1526\" stroke-width=\"1.8\" aria-hidden=\"true\">\n      <circle cx=\"12\" cy=\"11\" r=\"8\"/>\n      <circle cx=\"22\" cy=\"11\" r=\"8\"/>\n      <circle cx=\"17\" cy=\"19\" r=\"8\"/>\n    </svg>\n    <div class=\"wm\">OCTA</div>\n  </section>\n\n  <!-- wide statement -->\n  <section class=\"card wide\">\n    <div class=\"tx\">\n      <h2>We Shape What<br>Design Becomes</h2>\n      <p>Crafting Purposeful UX &nbsp;|&nbsp; Design</p>\n    </div>\n    <svg class=\"ast\" viewBox=\"0 0 96 96\" aria-hidden=\"true\">\n      <defs>\n        <radialGradient id=\"gloss\" cx=\"35%\" cy=\"28%\" r=\"80%\">\n          <stop offset=\"0\" stop-color=\"#4a4552\"/><stop offset=\".5\" stop-color=\"#1c1822\"/><stop offset=\"1\" stop-color=\"#0c0a10\"/>\n        </radialGradient>\n      </defs>\n      <g fill=\"url(#gloss)\">\n        <rect x=\"41\" y=\"4\" width=\"14\" height=\"88\" rx=\"7\"/>\n        <rect x=\"41\" y=\"4\" width=\"14\" height=\"88\" rx=\"7\" transform=\"rotate(60 48 48)\"/>\n        <rect x=\"41\" y=\"4\" width=\"14\" height=\"88\" rx=\"7\" transform=\"rotate(120 48 48)\"/>\n      </g>\n      <ellipse cx=\"42\" cy=\"16\" rx=\"4\" ry=\"7\" fill=\"rgba(255,255,255,.35)\" transform=\"rotate(14 42 16)\"/>\n    </svg>\n  </section>\n\n</main>\n",
