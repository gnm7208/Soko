y-center bg-[#141413]/45 px-4 backdrop-blur-sm\" data-dynamic=\"true\" data-kid=\"2\" data-name=\"create listing modal\" data-reason=\"toggled by script\" id=\"listing-modal\" role=\"dialog\">\n    <div class=\"w-full max-w-md rounded-2xl border border-[#e8e6dc] bg-white p-5 shadow-[0_20px_70px_rgba(20,20,19,.24)]\" data-kid=\"2-1\">\n        <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-1-1\">\n            <div data-kid=\"2-1-1-1\">\n                <p class=\"font-poppins text-[11px] font-semibold uppercase tracking-[.13em] text-[#d97757]\" data-kid=\"2-1-1-1-1\">\n                    Seller workspace\n                </p>\n                <h2 class=\"mt-1 font-poppins text-xl font-bold\" data-kid=\"2-1-1-1-2\" id=\"listing-modal-title\">\n                    Create new listing\n                </h2>\n                <p class=\"mt-1 text-xs text-[#69675f]\" data-kid=\"2-1-1-1-3\">\n                    Save a draft now and publish when it’s ready.\n                </p>\n            </div>\n            <button aria-label=\"Close new listing form\" class=\"flex h-8 w-8 items-center justify-center rounded-full text-[#69675f] hover:bg-[#faf9f5]\" data-kid=\"2-1-1-2\" id=\"close-listing-modal\" type=\"button\">\n                <i class=\"h-4 w-4\" data-kid=\"2-1-1-2-1\" data-lucide=\"x\">\n                </i>\n            </button>\n        </div>\n        <form class=\"mt-5 space-y-3\" data-kid=\"2-1-2\" id=\"new-listing-form\">\n            <label class=\"block\" data-kid=\"2-1-2-1\">\n                <span class=\"font-poppins text-xs font-semibold\" data-kid=\"2-1-2-1-1\">\n                    Product name\n                </span>\n                <input class=\"mt-1.5 h-10 w-full rounded-lg border border-[#e8e6dc] bg-[#faf9f5] px-3 text-sm outline-none placeholder:text-[#b0aea5] focus:border-[#d97757] focus:ring-2 focus:ring-[#d97757]/15\" data-kid=\"2-1-2-1-2\" id=\"draft-title\" placeholder=\"e.g. USB-C Fast Charger\" required=\"\" type=\"text\"/>\n            </label>\n            <div class=\"grid grid-cols-2 gap-3\" data-kid=\"2-1-2-2\">\n                <label class=\"block\" data-kid=\"2-1-2-2-1\">\n                    <span class=\"font-poppins text-xs font-semibold\" data-kid=\"2-1-2-2-1-1\">\n                        Price (KSh)\n                    </span>\n                    <input class=\"mt-1.5 h-10 w-full rounded-lg border border-[#e8e6dc] bg-[#faf9f5] px-3 text-sm outline-none placeholder:text-[#b0aea5] focus:border-[#d97757] focus:ring-2 focus:ring-[#d97757]/15\" data-kid=\"2-1-2-2-1-2\" id=\"draft-price\" min=\"1\" placeholder=\"2500\" required=\"\" type=\"number\"/>\n                </label>\n                <label class=\"block\" data-kid=\"2-1-2-2-2\">\n                    <span class=\"font-poppins text-xs font-semibold\" data-kid=\"2-1-2-2-2-1\">\n                        Category\n                    </span>\n                    <select class=\"mt-1.5 h-10 w-full rounded-lg border border-[#e8e6dc] bg-[#faf9f5] px-3 text-sm outline-none focus:border-[#d97757]\" data-kid=\"2-1-2-2-2-2\" id=\"draft-category\">\n                        <option data-kid=\"2-1-2-2-2-2-1\">\n                            Electronics\n                        </option>\n                        <option data-kid=\"2-1-2-2-2-2-2\">\n                            Fashion\n                        </option>\n                        <option data-kid=\"2-1-2-2-2-2-3\">\n                            Home\n                        </option>\n                        <option data-kid=\"2-1-2-2-2-2-4\">\n                            Services\n                        </option>\n                    </select>\n                </label>\n            </div>\n            <label class=\"block\" data-kid=\"2-1-2-3\">\n                <span class=\"font-poppins text-xs font-semibold\" data-kid=\"2-1-2-3-1\">\n                    Condition\n                </span>\n                <select class=\"mt-1.5 h-10 w-full rounded-lg border border-[#e8e6dc] bg-[#faf9f5] px-3 text-sm outline-none focus:border-[#d97757]\" data-kid=\"2-1-2-3-2\" id=\"draft-condition\">\n                    <option data-kid=\"2-1-2-3-2-1\">\n                        New\n                    </option>\n                    <option data-kid=\"2-1-2-3-2-2\">\n                        Used\n                    </option>\n                </select>\n            </label>\n            <div class=\"flex items-center justify-end gap-2 border-t border-[#e8e6dc] pt-4\" data-kid=\"2-1-2-4\">\n                <button class=\"rounded-lg px-3.5 py-2 font-poppins text-xs font-semibold text-[#69675f] hover:bg-[#faf9f5]\" data-kid=\"2-1-2-4-1\" id=\"cancel-listing\" type=\"button\">\n                    Cancel\n                </button>\n                <button class=\"inline-flex items-center gap-2 rounded-lg bg-[#d97757] px-4 py-2 font-poppins text-xs font-semibold text-[#faf9f5] hover:bg-[#c96749]\" data-kid=\"2-1-2-4-2\" type=\"submit\">\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"2-1-2-4-2-1\" data-lucide=\"save\">\n                    </i>\n                    Save draft\n                </button>\n            </div>\n        </form>\n    </div>\n</div>\n<div aria-live=\"polite\" class=\"fixed bottom-5 left-1/2 z-[60] hidden -translate-x-1/2 rounded-full bg-[#141413] px-4 py-2.5 font-poppins text-xs font-medium text-[#faf9f5] shadow-[0_12px_30px_rgba(20,20,19,.22)]\" data-dynamic=\"true\" data-kid=\"3\" data-name=\"toast notification box\" data-reason=\"populated and toggled by script\" id=\"toast\" role=\"status\">\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    const listingRows = [\n    { id: 'l1', title: 'Wireless Noise-Cancelling Headphones', category: 'Electronics', price: 6800, sold: 142, featured: true, status: 'Active', image: 'https://picsum.photos/seed/head/500/500' },\n    { id: 'l4', title: 'Smart LED TV 43\\\" 4K', category: 'Electronics', price: 28900, sold: 34, featured: false, status: 'Active', image: 'https://picsum.photos/seed/tv/500/500' },\n    { id: 'l7', title: 'Bluetooth Party Speaker', category: 'Electronics', price: 5400, sold: 76, featured: false, status: 'Active', image: 'https://picsum.photos/seed/speaker/500/500' }\n  ];\n  const orders = [\n    { id: 'SOKO-2481', listingTitle: 'Wireless Noise-Cancelling Headphones', shopName: 'Mama Njeri Electronics', total: 6950, status: 'Out for delivery', payment: 'M-Pesa', date: 'Today, 14:20', image: 'https://picsum.photos/seed/head/120/120', eta: 'Arriving in ~12 min' },\n    { id: 'SOKO-2470', listingTitle: 'Fresh Produce Basket (Weekly)', shopName: 'Kilimani Fresh Grocers', total: 1300, status: 'Delivered', payment: 'Card', date: 'Yesterday, 09:05', image: 'https://picsum.photos/seed/basket/120/120', eta: '' },\n    { id: 'SOKO-2455', listingTitle: 'Beaded Maasai Handbag', shopName: 'Threadline Fashion House', total: 2800, status: 'Preparing', payment: 'Cash on delivery', date: 'Today, 11:48', image: 'https://picsum.photos/seed/bag/120/120', eta: '' }\n  ];\n  const buyerProducts = [\n    { title: 'Wireless Noise-Cancelling Headphones', price: 6800, category: 'Electronics', image: 'https://picsum.photos/seed/head/500/500', shop: 'Mama Njeri Electronics', distance: '1.2 km' },\n    { title: 'Handwoven Cotton Kitenge Dress', price: 3500, category: 'Fashion', image: 'https://picsum.photos/seed/dress/500/500', shop: 'Threadline Fashion House', distance: '3.9 km' },\n    { title: 'Fresh Produce Basket (Weekly)', price: 1200, category: 'Groceries', image: 'https://picsum.photos/seed/basket/500/500', shop: 'Kilimani Fresh Grocers', distance: '2.6 km' },\n    { title: 'Beaded Maasai Handbag', price: 2600, category: 'Fashion', image: 'https://picsum.photos/seed/bag/500/500', shop: 'Threadline Fashion House', distance: '3.9 km' }\n  ];\n  let listingFilter = 'all';\n  let orderFilter = 'all';\n  let toastTimer;\n  const money = (value) => 'KSh ' + Number(value).toLocaleString('en-KE');\n  const iconRefresh = () => { if (window.lucide) window.lucide.createIcons(); };\n  const showToast = (message) => { const el = document.getElementById('toast'); el.textContent = message; el.classList.remove('hidden'); el.classList.add('toast-in'); clearTimeout(toastTimer); toastTimer = setTimeout(() => { el.classList.add('hidden'); el.classList.remove('toast-in'); }, 2800); };\n  const statusClass = (status) => ({\n    'Confirmed': 'border-transparent bg-[#e8e6dc] text-[#141413]',\n    'Preparing': 'border-[#6a9bcc]/30 bg-[#6a9bcc]/15 text-[#486f98]',\n    'Out for delivery': 'border-[#d97757]/30 bg-[#d97757]/15 text-[#b45c3f]',\n    'Delivered': 'border-[#788c5d]/30 bg-[#788c5d]/15 text-[#5d713f]'\n  }[status] || 'border-transparent bg-[#e8e6dc] text-[#141413]');\n  const statusDot = (status) => ({ 'Confirmed': '#141413', 'Preparing': '#6a9bcc', 'Out for delivery': '#d97757', 'Delivered': '#788c5d' }[status] || '#141413');\n\n  function renderListings() {\n    const query = document.getElementById('global-search').value.trim().toLowerCase();\n    const filtered = listingRows.filter((item) => {\n      const matchesSearch = !query || [item.title, item.category, item.status].some((value) => value.toLowerCase().includes(query));\n      const matchesFilter = listingFilter === 'all' || (listingFilter === 'featured' && item.featured) || (listingFilter === 'draft' && item.status === 'Draft');\n      return matchesSearch && matchesFilter;\n    });\n    document.getElementById('listing-count').textContent = `${filtered.length} ${filtered.length === 1 ? 'product' : 'products'} shown`;\n    const rows = filtered.map((item) => `\n      <div class=\"relative grid grid-cols-[minmax(0,1fr)_104px_98px_32px] items-center gap-3 px-4 py-3.5 hover:bg-[#faf9f5]\">\n        <div class=\"flex min-w-0 items-center gap-3\"><img src=\"${item.image}\" alt=\"${item.title}\" loading=\"lazy\" decoding=\"async\" class=\"h-11 w-11 shrink-0 rounded-lg object-cover\" /><div class=\"min-w-0\"><p class=\"truncate text-sm font-medium\">${item.title}</p><div class=\"mt-1 flex items-center gap-2 text-[10px] text-[#69675f]\"><span>${item.category}</span><span class=\"text-[#b0aea5]\">·</span><span class=\"${item.status === 'Draft' ? 'text-[#d97757]' : 'text-[#788c5d]'}\">${item.status}</span></div></div></div>\n        <div><p class=\"font-poppins text-xs font-semibold\">${item.sold} sold</p><p class=\"mt-1 text-[10px] text-[#b0aea5]\">${item.status === 'Draft' ? 'Not published' : 'All time'}</p></div>\n        <div><p class=\"font-poppins text-sm font-semibold text-[#d97757]\">${money(item.price)}</p>${item.featured ? '<span class=\"mt-1 inline-flex items-center gap-1 rounded-md bg-[#d97757]/10 px-1.5 py-0.5 font-poppins text-[9px] font-semibold text-[#b45c3f]\"><i data-lucide=\"sparkles\" class=\"h-2.5 w-2.5\"></i> Featured</span>' : ''}</div>\n        <div class=\"relative\"><button type=\"button\" data-overflow=\"${item.id}\" class=\"overflow-trigger flex h-8 w-8 items-center justify-center rounded-full text-[#b0aea5] hover:bg-[#e8e6dc] hover:text-[#141413]\" aria-label=\"More actions for ${item.title}\"><i data-lucide=\"more-horizontal\" class=\"h-4 w-4\"></i></button><div id=\"menu-${item.id}\" class=\"absolute right-0 top-9 z-20 hidden w-36 overflow-hidden rounded-xl border border-[#e8e6dc] bg-white p-1 shadow-[0_10px_28px_rgba(20,20,19,.12)]\"><button type=\"button\" data-menu-action=\"edit\" data-item=\"${item.id}\" class=\"flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-left text-[11px] hover:bg-[#faf9f5]\"><i data-lucide=\"pencil\" class=\"h-3 w-3 text-[#69675f]\"></i> Edit listing</button><button type=\"button\" data-menu-action=\"promote\" data-item=\"${item.id}\" class=\"flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-left text-[11px] hover:bg-[#faf9f5]\"><i data-lucide=\"sparkles\" class=\"h-3 w-3 text-[#d97757]\"></i> Promote</button></div></div>\n      </div>`).join('');\n    document.getElementById('listing-rows').innerHTML = rows || '<div class=\"px-4 py-12 text-center\"><i data-lucide=\"search-x\" class=\"mx-auto h-6 w-6 text-[#b0aea5]\"></i><p class=\"mt-2 font-poppins text-xs font-semibold\">No listings found</p><p class=\"mt-1 text-[11px] text-[#69675f]\">Try another search or filter.</p></div>';\n    iconRefresh();\n  }\n\n  function renderOrders() {\n    const filtered = orderFilter === 'all' ? orders : orders.filter((order) => order.status === orderFilter);\n    const rows = filtered.map((order) => `<div class=\"px-4 py-3.5\"><div class=\"flex items-start gap-3\"><img src=\"${order.image}\" alt=\"${order.listingTitle}\" loading=\"lazy\" decoding=\"async\" class=\"h-10 w-10 shrink-0 rounded-lg object-cover\" /><div class=\"min-w-0 flex-1\"><div class=\"flex items-start justify-between gap-2\"><div class=\"min-w-0\"><p class=\"font-poppins text-xs font-semibold\">${order.id}</p><p class=\"mt-1 truncate text-[11px] text-[#69675f]\">${order.listingTitle}</p></div><span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2 py-1 font-poppins text-[9px] font-semibold ${statusClass(order.status)}\"><span class=\"h-1.5 w-1.5 rounded-full\" style=\"background:${statusDot(order.status)}\"></span>${order.status}</span></div><div class=\"mt-2 flex items-center justify-between gap-2\"><span class=\"text-[10px] text-[#b0aea5]\">${order.payment} · ${order.date}</span><span class=\"font-poppins text-xs font-semibold text-[#d97757]\">${money(order.total)}</span></div>${order.eta ? `<p class=\"mt-2 inline-flex items-center gap-1 font-poppins text-[10px] font-semibold text-[#d97757]\"><i data-lucide=\"clock-3\" class=\"h-3 w-3\"></i>${order.eta}</p>` : ''}</div></div></div>`).join('');\n    document.getElementById('order-rows').innerHTML = rows || '<div class=\"px-4 py-10 text-center\"><i data-lucide=\"inbox\" class=\"mx-auto h-6 w-6 text-[#b0aea5]\"></i><p class=\"mt-2 font-poppins text-xs font-semibold\">No orders in this view</p><p class=\"mt-1 text-[11px] text-[#69675f]\">You’re all caught up.</p></div>';\n    iconRefresh();\n  }\n\n  function renderBuyerResults() {\n    const query = document.getElementById('global-search').value.trim().toLowerCase();\n    const filtered = buyerProducts.filter((item) => !query || [item.title, item.category, item.shop].some((value) => value.toLowerCase().includes(query)));\n    document.getElementById('buyer-results').innerHTML = filtered.map((item) => `<article class=\"group overflow-hidden rounded-xl border border-[#e8e6dc] bg-white\"><div class=\"relative aspect-square overflow-hidden bg-[#e8e6dc]\"><img src=\"${item.image}\" alt=\"${item.title}\" loading=\"lazy\" decoding=\"async\" class=\"h-full w-full object-cover transition-transform duration-300 group-hover:scale-105\" /><span class=\"absolute bottom-2 left-2 inline-flex items-center gap-1 rounded-md bg-[#141413]/80 px-2 py-1 font-poppins text-[10px] text-[#faf9f5]\"><i data-lucide=\"map-pin\" class=\"h-2.5 w-2.5\"></i>${item.distance}</span></div><div class=\"space-y-1.5 p-3\"><p class=\"min-h-[34px] text-xs leading-snug\">${item.title}</p><p class=\"font-poppins text-base font-bold text-[#d97757]\">${money(item.price)}</p><p class=\"truncate text-[10px] text-[#69675f]\">${item.shop}</p></div></article>`).join('') || '<div class=\"col-span-full rounded-xl border border-dashed border-[#e8e6dc] px-4 py-12 text-center\"><p class=\"font-poppins text-sm font-semibold\">No products found</p><p class=\"mt-1 text-xs text-[#69675f]\">Try a different search.</p></div>';\n    iconRefresh();\n  }\n\n  function updateMode(mode) {\n    const buy = document.getElementById('buy-toggle');\n    const sell = document.getElementById('sell-toggle');\n    const buyer = mode === 'buyer';\n    buy.className = buyer ? 'rounded-full bg-[#141413] px-3 py-1.5 font-poppins font-medium text-[#faf9f5]' : 'rounded-full px-3 py-1.5 font-poppins font-medium text-[#69675f] hover:bg-[#e8e6dc]';\n    sell.className = !buyer ? 'rounded-full bg-[#141413] px-3 py-1.5 font-poppins font-medium text-[#faf9f5]' : 'rounded-full px-3 py-1.5 font-poppins font-medium text-[#69675f] hover:bg-[#e8e6dc]';\n    document.getElementById('seller-view').classList.toggle('hidden', buyer);\n    document.getElementById('buyer-view').classList.toggle('hidden', !buyer);\n    if (buyer) renderBuyerResults(); else renderListings();\n  }\n\n  function toggleModal(open) {\n    const modal = document.getElementById('listing-modal');\n    modal.classList.toggle('hidden', !open); modal.classList.toggle('flex', open);\n    if (open) setTimeout(() => document.getElementById('draft-title').focus(), 50);\n  }\n\n  document.getElementById('global-search').addEventListener('input', () => { renderListings(); renderBuyerResults(); });\n  document.getElementById('new-listing-button').addEventListener('click', () => toggleModal(true));\n  document.getElementById('close-listing-modal').addEventListener('click', () => toggleModal(false));\n  document.getElementById('cancel-listing').addEventListener('click', () => toggleModal(false));\n  document.getElementById('listing-modal').addEventListener('click', (event) => { if (event.target.id === 'listing-modal') toggleModal(false); });\n  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { toggleModal(false); document.getElementById('notifications-popover').classList.add('hidden'); document.getElementById('account-popover').classList.add('hidden'); } });\n  document.getElementById('new-listing-form').addEventListener('submit', (event) => { event.preventDefault(); listingRows.push({ id: 'draft-' + Date.now(), title: document.getElementById('draft-title').value.trim(), category: document.getElementById('draft-category').value, price: Number(document.getElementById('draft-price').value), sold: 0, featured: false, status: 'Draft', image: 'https://picsum.photos/seed/speaker/500/500' }); event.target.reset(); toggleModal(false); listingFilter = 'draft'; document.querySelectorAll('[data-listing-filter]').forEach((button) => button.className = button.dataset.listingFilter === 'draft' ? 'listing-filter rounded-md bg-white px-2.5 py-1.5 font-poppins text-[11px] font-semibold text-[#141413] shadow-[0_1px_2px_rgba(20,20,19,.06)]' : 'listing-filter rounded-md px-2.5 py-1.5 font-poppins text-[11px] font-medium text-[#69675f] hover:bg-white'); renderListings(); showToast('Draft saved to your listings'); });\n  document.querySelectorAll('[data-listing-filter]').forEach((button) => button.addEventListener('click', () => { listingFilter = button.dataset.listingFilter; document.querySelectorAll('[data-listing-filter]').forEach((item) => item.className = item.dataset.listingFilter === listingFilter ? 'listing-filter rounded-md bg-white px-2.5 py-1.5 font-poppins text-[11px] font-semibold text-[#141413] shadow-[0_1px_2px_rgba(20,20,19,.06)]' : 'listing-filter rounded-md px-2.5 py-1.5 font-poppins text-[11px] font-medium text-[#69675f] hover:bg-white'); renderListings(); }));\n  document.querySelectorAll('[data-order-filter]').forEach((button) => button.addEventListener('click', () => { orderFilter = button.dataset.orderFilter; document.querySelectorAll('[data-order-filter]').forEach((item) => item.className = item.dataset.orderFilter === orderFilter ? 'order-filter shrink-0 rounded-full bg-[#141413] px-2.5 py-1.5 font-poppins text-[10px] font-semibold text-[#faf9f5]' : 'order-filter shrink-0 rounded-full px-2.5 py-1.5 font-poppins text-[10px] font-medium text-[#69675f] hover:bg-[#faf9f5]'); renderOrders(); }));\n  document.addEventListener('click', (event) => { const overflow = event.target.closest('[data-overflow]'); if (overflow) { event.stopPropagation(); const menu = document.getElementById('menu-' + overflow.dataset.overflow); document.querySelectorAll('[id^=\"menu-\"]').forEach((item) => { if (item !== menu) item.classList.add('hidden'); }); menu.classList.toggle('hidden'); return; } const action = event.target.closest('[data-menu-action]'); if (action) { document.querySelectorAll('[id^=\"menu-\"]').forEach((item) => item.classList.add('hidden')); showToast(action.dataset.menuAction === 'promote' ? 'Promotion tools are ready for this listing' : 'Listing editor opened'); return; } if (!event.target.closest('[id^=\"menu-\"]')) document.querySelectorAll('[id^=\"menu-\"]').forEach((item) => item.classList.add('hidden')); });\n  document.getElementById('request-payout').addEventListener('click', () => showToast('Payout request started — we’ll confirm it shortly'));\n  document.getElementById('feature-listing').addEventListener('click', () => showToast('Choose a listing to feature from the overflow menu'));\n  document.getElementById('buy-toggle').addEventListener('click', () => { updateMode('buyer'); showToast('Buyer preview is on'); });\n  document.getElementById('sell-toggle').addEventListener('click', () => { updateMode('seller'); showToast('Seller workspace is on'); });\n  document.getElementById('return-seller').addEventListener('click', () => updateMode('seller'));\n  document.getElementById('brand-button').addEventListener('click', () => { updateMode('seller'); window.scrollTo({ top: 0, behavior: 'smooth' }); });\n  document.getElementById('notifications-button').addEventListener('click', (event) => { event.stopPropagation(); const pop = document.getElementById('notifications-popover'); pop.classList.toggle('hidden'); document.getElementById('account-popover').classList.add('hidden'); });\n  document.getElementById('account-button').addEventListener('click', (event) => { event.stopPropagation(); const pop = document.getElementById('account-popover'); pop.classList.toggle('hidden'); document.getElementById('notifications-popover').classList.add('hidden'); });\n  document.getElementById('mark-read').addEventListener('click', () => { document.querySelector('#notifications-button .pulse-dot').classList.add('hidden'); document.getElementById('notifications-popover').classList.add('hidden'); showToast('Notifications marked as read'); });\n  document.addEventListener('click', (event) => { if (!event.target.closest('#notifications-popover') && !event.target.closest('#notifications-button')) document.getElementById('notifications-popover').classList.add('hidden'); if (!event.target.closest('#account-popover') && !event.target.closest('#account-button')) document.getElementById('account-popover').classList.add('hidden'); });\n  renderListings(); renderOrders(); renderBuyerResults(); iconRefresh();\n</script>\n",
