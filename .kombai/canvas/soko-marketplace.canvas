      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap');\n  .font-heading { font-family: 'Poppins', Arial, sans-serif; letter-spacing: -0.012em; }\n  .font-body { font-family: 'Lora', Georgia, serif; }\n  .soko-map-grid {\n    background-color: #e8e6dc;\n    background-image: linear-gradient(rgba(176,174,165,.32) 1px, transparent 1px), linear-gradient(90deg, rgba(176,174,165,.32) 1px, transparent 1px);\n    background-size: 24px 24px;\n  }\n  .map-road { position: absolute; height: 14px; border-radius: 999px; background: rgba(250,249,245,.92); box-shadow: 0 0 0 1px rgba(176,174,165,.2); transform-origin: left center; }\n  .map-road::after { content: ''; position: absolute; inset: 5px 0; border-top: 1px dashed rgba(176,174,165,.72); }\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { scrollbar-width: none; }\n</style>\n<div class=\"min-h-screen bg-[#faf9f5] text-[#141413] font-body\" data-kid=\"1\">\n    <header class=\"sticky top-0 z-40 border-b border-[#e8e6dc] bg-[#faf9f5]/95 backdrop-blur-xl\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-[72px] max-w-[1180px] items-center gap-3 px-6\" data-kid=\"1-1-1\">\n            <button aria-label=\"Go to browse\" class=\"group flex shrink-0 items-center gap-2.5 rounded-xl outline-none focus-visible:ring-2 focus-visible:ring-[#d97757]\" data-kid=\"1-1-1-1\" id=\"logo-button\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-[11px] bg-[#141413] font-heading text-lg font-bold text-[#faf9f5]\" data-kid=\"1-1-1-1-1\">\n                    S\n                </span>\n                <span class=\"hidden font-heading text-[21px] font-bold tracking-[-.03em] sm:block\" data-kid=\"1-1-1-1-2\">\n                    Soko\n                </span>\n            </button>\n            <nav aria-label=\"Primary\" class=\"ml-5 hidden items-center gap-1 lg:flex\" data-kid=\"1-1-1-2\">\n                <button class=\"nav-button inline-flex h-9 items-center gap-2 rounded-lg px-3 text-[13px] font-medium text-[#6b6961] hover:bg-[#e8e6dc]/65 hover:text-[#141413]\" data-kid=\"1-1-1-2-1\" id=\"browse-nav\" type=\"button\">\n                    <i class=\"h-4 w-4 text-[#6b6961]\" data-kid=\"1-1-1-2-1-1\" data-lucide=\"store\">\n                    </i>\n                    Browse\n                </button>\n                <button aria-current=\"page\" class=\"nav-button inline-flex h-9 items-center gap-2 rounded-lg bg-[#e8e6dc] px-3 text-[13px] font-semibold text-[#141413]\" data-kid=\"1-1-1-2-2\" id=\"orders-nav\" type=\"button\">\n                    <i class=\"h-4 w-4 text-[#141413]\" data-kid=\"1-1-1-2-2-1\" data-lucide=\"package-check\">\n                    </i>\n                    Orders\n                </button>\n                <button class=\"nav-button inline-flex h-9 items-center gap-2 rounded-lg px-3 text-[13px] font-medium text-[#6b6961] hover:bg-[#e8e6dc]/65 hover:text-[#141413]\" data-kid=\"1-1-1-2-3\" id=\"messages-nav\" type=\"button\">\n                    <i class=\"h-4 w-4 text-[#6b6961]\" data-kid=\"1-1-1-2-3-1\" data-lucide=\"message-circle\">\n                    </i>\n                    Messages\n                    <span class=\"flex h-4 min-w-4 items-center justify-center rounded-full bg-[#d97757] px-1 font-heading text-[10px] font-bold text-[#faf9f5]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-3-2\" data-name=\"unread messages badge count\" data-reason=\"count text injected by script\">\n                        2\n                    </span>\n                </button>\n            </nav>\n            <div class=\"relative ml-auto hidden w-[240px] xl:block\" data-kid=\"1-1-1-3\">\n                <i class=\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8d8b83]\" data-kid=\"1-1-1-3-1\" data-lucide=\"search\">\n                </i>\n                <input aria-label=\"Search your orders\" class=\"h-9 w-full rounded-full border border-[#d8d5cc] bg-white/70 pl-9 pr-4 text-[13px] outline-none placeholder:text-[#9b988f] focus:border-[#d97757] focus:ring-2 focus:ring-[#d97757]/15\" data-kid=\"1-1-1-3-2\" id=\"order-search\" placeholder=\"Search your orders\" type=\"search\"/>\n            </div>\n            <button class=\"hidden h-9 items-center gap-1.5 rounded-full border border-[#e8e6dc] bg-[#e8e6dc]/50 px-3 text-[12px] font-medium text-[#6b6961] md:flex\" data-kid=\"1-1-1-4\" id=\"location-button\" type=\"button\">\n                <i class=\"h-3.5 w-3.5 text-[#d97757]\" data-kid=\"1-1-1-4-1\" data-lucide=\"map-pin\">\n                </i>\n                Nairobi\n            </button>\n            <div class=\"relative\" data-kid=\"1-1-1-5\">\n                <button aria-expanded=\"false\" aria-label=\"Notifications\" class=\"relative flex h-9 w-9 items-center justify-center rounded-full text-[#6b6961] hover:bg-[#e8e6dc]\" data-kid=\"1-1-1-5-1\" id=\"notification-button\" type=\"button\">\n                    <i class=\"h-[17px] w-[17px] text-[#6b6961]\" data-kid=\"1-1-1-5-1-1\" data-lucide=\"bell\">\n                    </i>\n                    <span class=\"absolute right-[7px] top-[6px] h-1.5 w-1.5 rounded-full bg-[#d97757] ring-2 ring-[#faf9f5]\" data-dynamic=\"true\" data-kid=\"1-1-1-5-1-2\" data-name=\"notification dot\" data-reason=\"visibility toggled by script\">\n                    </span>\n                </button>\n                <div class=\"absolute right-0 top-12 hidden w-[310px] overflow-hidden rounded-2xl border border-[#e8e6dc] bg-white shadow-[0_16px_40px_rgba(20,20,19,.12)]\" data-kid=\"1-1-1-5-2\" id=\"notification-popover\">\n                    <div class=\"flex items-center justify-between border-b border-[#e8e6dc] px-4 py-3\" data-kid=\"1-1-1-5-2-1\">\n                        <p class=\"font-heading text-sm font-semibold\" data-kid=\"1-1-1-5-2-1-1\">\n                            Notifications\n                        </p>\n                        <button class=\"text-[11px] font-medium text-[#6a9bcc] hover:underline\" data-kid=\"1-1-1-5-2-1-2\" id=\"mark-read\" type=\"button\">\n                            Mark all read\n                        </button>\n                    </div>\n                    <div class=\"space-y-1 p-2\" data-kid=\"1-1-1-5-2-2\">\n                        <button class=\"flex w-full gap-3 rounded-xl bg-[#d97757]/[.07] p-3 text-left hover:bg-[#d97757]/[.12]\" data-kid=\"1-1-1-5-2-2-1\" type=\"button\">\n                            <span class=\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#d97757]/15 text-[#d97757]\" data-kid=\"1-1-1-5-2-2-1-1\">\n                                <i class=\"h-3.5 w-3.5 text-[#d97757]\" data-kid=\"1-1-1-5-2-2-1-1-1\" data-lucide=\"truck\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-1-1-5-2-2-1-2\">\n                                <span class=\"block font-heading text-[12px] font-semibold\" data-kid=\"1-1-1-5-2-2-1-2-1\">\n                                    Your order is on the way\n                                </span>\n                                <span class=\"mt-0.5 block text-[11px] leading-snug text-[#85827a]\" data-kid=\"1-1-1-5-2-2-1-2-2\">\n                                    SOKO-2481 is arriving in about 12 minutes.\n                                </span>\n                            </span>\n                        </button>\n                        <button class=\"flex w-full gap-3 rounded-xl p-3 text-left hover:bg-[#faf9f5]\" data-kid=\"1-1-1-5-2-2-2\" type=\"button\">\n                            <span class=\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#788c5d]/15 text-[#788c5d]\" data-kid=\"1-1-1-5-2-2-2-1\">\n                                <i class=\"h-3.5 w-3.5 text-[#788c5d]\" data-kid=\"1-1-1-5-2-2-2-1-1\" data-lucide=\"check-circle-2\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-1-1-5-2-2-2-2\">\n                                <span class=\"block font-heading text-[12px] font-semibold\" data-kid=\"1-1-1-5-2-2-2-2-1\">\n                                    Order delivered\n                                </span>\n                                <span class=\"mt-0.5 block text-[11px] leading-snug text-[#85827a]\" data-kid=\"1-1-1-5-2-2-2-2-2\">\n                                    Your produce basket was delivered yesterday.\n                                </span>\n                            </span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-center rounded-full border border-[#d8d5cc] bg-white/60 p-0.5 text-[11px] font-heading font-semibold\" data-kid=\"1-1-1-6\">\n                <button class=\"rounded-full bg-[#141413] px-3.5 py-1.5 text-[#faf9f5]\" data-kid=\"1-1-1-6-1\" id=\"buy-toggle\" type=\"button\">\n                    Buy\n                </button>\n                <button class=\"rounded-full px-3.5 py-1.5 text-[#6b6961] hover:text-[#141413]\" data-kid=\"1-1-1-6-2\" id=\"sell-toggle\" type=\"button\">\n                    Sell\n                </button>\n            </div>\n            <button aria-label=\"Open account menu\" class=\"hidden h-9 w-9 items-center justify-center rounded-full bg-[#6a9bcc] font-heading text-xs font-bold text-[#faf9f5] sm:flex\" data-kid=\"1-1-1-7\" id=\"avatar-button\" type=\"button\">\n                AM\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1040px] px-6 pb-16 pt-9\" data-kid=\"1-2\" id=\"orders-view\">\n        <div class=\"mb-8 flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <p class=\"mb-2 font-heading text-[11px] font-semibold uppercase tracking-[.18em] text-[#d97757]\" data-kid=\"1-2-1-1-1\">\n                    Your Soko activity\n                </p>\n                <h1 class=\"font-heading text-[32px] font-bold leading-tight tracking-[-.035em]\" data-kid=\"1-2-1-1-2\">\n                    My orders\n                </h1>\n                <p class=\"mt-2 text-[14px] text-[#77746b]\" data-dynamic=\"true\" data-kid=\"1-2-1-1-3\" data-name=\"result copy text\" data-reason=\"text content updated based on search results by script\" id=\"result-copy\">\n                    Keep an eye on your deliveries, from checkout to doorstep.\n                </p>\n            </div>\n            <button class=\"inline-flex h-10 items-center gap-2 rounded-lg border border-[#d8d5cc] bg-white px-4 font-heading text-[12px] font-semibold text-[#141413] hover:border-[#d97757]/50 hover:bg-[#fffaf6]\" data-kid=\"1-2-1-2\" id=\"browse-action\" type=\"button\">\n                <i class=\"h-4 w-4 text-[#d97757]\" data-kid=\"1-2-1-2-1\" data-lucide=\"arrow-left\">\n                </i>\n                Back to browse\n            </button>\n        </div>\n        <div class=\"mb-7 flex flex-wrap items-center justify-between gap-3 border-b border-[#e8e6dc]\" data-kid=\"1-2-2\">\n            <div aria-label=\"Filter orders\" class=\"no-scrollbar flex gap-6 overflow-x-auto\" data-kid=\"1-2-2-1\" id=\"status-tabs\" role=\"tablist\">\n                <button aria-selected=\"true\" class=\"status-tab relative pb-3 font-heading text-[13px] font-semibold text-[#141413]\" data-filter=\"all\" data-kid=\"1-2-2-1-1\" role=\"tab\" type=\"button\">\n                    All orders\n                    <span class=\"ml-1 text-[11px] text-[#9b988f]\" data-kid=\"1-2-2-1-1-1\">\n                        3\n                    </span>\n                    <span class=\"tab-line absolute inset-x-0 -bottom-px h-0.5 rounded-full bg-[#d97757]\" data-kid=\"1-2-2-1-1-2\">\n                    </span>\n                </button>\n                <button aria-selected=\"false\" class=\"status-tab relative pb-3 font-heading text-[13px] font-medium text-[#8d8b83] hover:text-[#141413]\" data-filter=\"progress\" data-kid=\"1-2-2-1-2\" role=\"tab\" type=\"button\">\n                    In progress\n                    <span class=\"ml-1 text-[11px] text-[#9b988f]\" data-kid=\"1-2-2-1-2-1\">\n                        2\n                    </span>\n                    <span class=\"tab-line absolute inset-x-0 -bottom-px hidden h-0.5 rounded-full bg-[#d97757]\" data-kid=\"1-2-2-1-2-2\">\n                    </span>\n                </button>\n                <button aria-selected=\"false\" class=\"status-tab relative pb-3 font-heading text-[13px] font-medium text-[#8d8b83] hover:text-[#141413]\" data-filter=\"delivered\" data-kid=\"1-2-2-1-3\" role=\"tab\" type=\"button\">\n                    Delivered\n                    <span class=\"ml-1 text-[11px] text-[#9b988f]\" data-kid=\"1-2-2-1-3-1\">\n                        1\n                    </span>\n                    <span class=\"tab-line absolute inset-x-0 -bottom-px hidden h-0.5 rounded-full bg-[#d97757]\" data-kid=\"1-2-2-1-3-2\">\n                    </span>\n                </button>\n            </div>\n            <span class=\"pb-3 text-[11px] text-[#9b988f]\" data-dynamic=\"true\" data-kid=\"1-2-2-2\" data-name=\"search result count status\" data-reason=\"text content injected by script\" id=\"search-status\">\n            </span>\n        </div>\n        <section aria-live=\"polite\" class=\"space-y-4\" data-dynamic=\"true\" data-kid=\"1-2-3\" data-name=\"order list container\" data-reason=\"list content rendered dynamically by script\" id=\"order-list\">\n        </section>\n        <div class=\"hidden rounded-2xl border border-dashed border-[#d8d5cc] bg-white/50 px-6 py-16 text-center\" data-dynamic=\"true\" data-kid=\"1-2-4\" data-name=\"empty state container\" data-reason=\"visibility toggled by script\" id=\"empty-state\">\n            <span class=\"mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#e8e6dc] text-[#6b6961]\" data-kid=\"1-2-4-1\">\n                <i class=\"h-5 w-5 text-[#6b6961]\" data-kid=\"1-2-4-1-1\" data-lucide=\"search-x\">\n                </i>\n            </span>\n            <h2 class=\"mt-4 font-heading text-lg font-semibold\" data-kid=\"1-2-4-2\">\n                No orders found\n            </h2>\n            <p class=\"mt-1 text-sm text-[#77746b]\" data-kid=\"1-2-4-3\">\n                Try another search or switch to a different status.\n            </p>\n            <button class=\"mt-4 text-xs font-semibold text-[#d97757] hover:underline\" data-dynamic=\"true\" data-kid=\"1-2-4-4\" data-name=\"clear search button\" data-reason=\"visibility toggled by script\" id=\"clear-search\" type=\"button\">\n                Clear search\n            </button>\n        </div>\n        <div class=\"mt-9 flex items-center justify-between rounded-2xl bg-[#141413] px-6 py-5 text-[#faf9f5]\" data-kid=\"1-2-5\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-5-1\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#d97757]/20 text-[#d97757]\" data-kid=\"1-2-5-1-1\">\n                    <i class=\"h-4 w-4 text-[#d97757]\" data-kid=\"1-2-5-1-1-1\" data-lucide=\"shopping-bag\">\n                    </i>\n                </span>\n                <div data-kid=\"1-2-5-1-2\">\n                    <p class=\"font-heading text-sm font-semibold\" data-kid=\"1-2-5-1-2-1\">\n                        Need something else?\n                    </p>\n                    <p class=\"mt-0.5 text-xs text-[#faf9f5]/60\" data-kid=\"1-2-5-1-2-2\">\n                        Discover trusted retailers near you.\n                    </p>\n                </div>\n            </div>\n            <button class=\"inline-flex items-center gap-1.5 rounded-lg bg-[#d97757] px-3.5 py-2 font-heading text-xs font-semibold text-[#faf9f5] hover:bg-[#c9694d]\" data-kid=\"1-2-5-2\" id=\"dark-browse\" type=\"button\">\n                Browse marketplace\n                <i class=\"h-3.5 w-3.5 text-[#faf9f5]\" data-kid=\"1-2-5-2-1\" data-lucide=\"arrow-up-right\">\n                </i>\n            </button>\n        </div>\n    </main>\n    <section class=\"mx-auto hidden max-w-[1040px] px-6 pb-16 pt-10\" data-kid=\"1-3\" id=\"browse-view\">\n        <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <p class=\"mb-2 font-heading text-[11px] font-semibold uppercase tracking-[.18em] text-[#d97757]\" data-kid=\"1-3-1-1-1\">\n                    Soko marketplace\n                </p>\n                <h1 class=\"font-heading text-[32px] font-bold tracking-[-.035em]\" data-kid=\"1-3-1-1-2\">\n                    Find your next favourite.\n                </h1>\n                <p class=\"mt-2 text-sm text-[#77746b]\" data-kid=\"1-3-1-1-3\">\n                    Browse local shops and products around Nairobi.\n                </p>\n            </div>\n            <button class=\"inline-flex h-10 items-center gap-2 rounded-lg border border-[#d8d5cc] bg-white px-4 font-heading text-[12px] font-semibold hover:border-[#d97757]/50\" data-kid=\"1-3-1-2\" id=\"orders-action\" type=\"button\">\n                <i class=\"h-4 w-4 text-[#d97757]\" data-kid=\"1-3-1-2-1\" data-lucide=\"package-check\">\n                </i>\n                View my orders\n            </button>\n        </div>\n        <div class=\"mt-8 grid gap-4 md:grid-cols-[1.3fr_1fr]\" data-kid=\"1-3-2\">\n            <div class=\"relative overflow-hidden rounded-2xl bg-[#141413] px-7 py-8 text-[#faf9f5]\" data-kid=\"1-3-2-1\">\n                <div class=\"relative z-10 max-w-md\" data-kid=\"1-3-2-1-1\">\n                    <p class=\"font-heading text-[11px] font-semibold uppercase tracking-[.17em] text-[#d97757]\" data-kid=\"1-3-2-1-1-1\">\n                        Local, made simple\n                    </p>\n                    <h2 class=\"mt-3 font-heading text-2xl font-bold leading-tight\" data-kid=\"1-3-2-1-1-2\">\n                        Everything your neighbourhood sells — in one place.\n                    </h2>\n                    <p class=\"mt-3 max-w-sm text-sm leading-relaxed text-[#faf9f5]/65\" data-kid=\"1-3-2-1-1-3\">\n                        Find local retailers, get directions, chat, and pay by M-Pesa, card, or cash on delivery.\n                    </p>\n                    <button class=\"mt-6 inline-flex items-center gap-2 rounded-lg bg-[#d97757] px-4 py-2.5 font-heading text-xs font-semibold text-[#faf9f5] hover:bg-[#c9694d]\" data-kid=\"1-3-2-1-1-4\" id=\"browse-products\" type=\"button\">\n                        Start shopping\n                        <i class=\"h-3.5 w-3.5 text-[#faf9f5]\" data-kid=\"1-3-2-1-1-4-1\" data-lucide=\"arrow-right\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"absolute -right-10 -top-10 h-44 w-44 rounded-full bg-[#d97757]/30 blur-2xl\" data-kid=\"1-3-2-1-2\">\n                </div>\n                <div class=\"absolute -bottom-12 right-20 h-36 w-36 rounded-full bg-[#6a9bcc]/25 blur-2xl\" data-kid=\"1-3-2-1-3\">\n                </div>\n            </div>\n            <div class=\"rounded-2xl border border-[#e8e6dc] bg-white p-6\" data-kid=\"1-3-2-2\">\n                <div class=\"flex items-center justify-between\" data-kid=\"1-3-2-2-1\">\n                    <h2 class=\"font-heading text-base font-semibold\" data-kid=\"1-3-2-2-1-1\">\n                        Popular near you\n                    </h2>\n                    <span class=\"rounded-full bg-[#e8e6dc] px-2.5 py-1 text-[10px] font-heading font-semibold text-[#6b6961]\" data-kid=\"1-3-2-2-1-2\">\n                        Nairobi\n                    </span>\n                </div>\n                <div class=\"mt-5 space-y-4\" data-kid=\"1-3-2-2-2\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-2-2-1\">\n                        <img alt=\"Mama Njeri Electronics\" class=\"h-11 w-11 rounded-xl object-cover\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"mama njeri electronics store image\" decoding=\"async\" loading=\"lazy\" src=\"https://picsum.photos/seed/logo1/80/80\"/>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-3-2-2-2-1-2\">\n                            <p class=\"truncate font-heading text-sm font-semibold\" data-kid=\"1-3-2-2-2-1-2-1\">\n                                Mama Njeri Electronics\n                            </p>\n                            <p class=\"mt-0.5 text-xs text-[#77746b]\" data-kid=\"1-3-2-2-2-1-2-2\">\n                                1.2 km · 4.8 ★ · 25–35 min\n                            </p>\n                        </div>\n                        <i class=\"h-4 w-4 text-[#9b988f]\" data-kid=\"1-3-2-2-2-1-3\" data-lucide=\"chevron-right\">\n                        </i>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-2-2-2\">\n                        <img alt=\"Kilimani Fresh Grocers\" class=\"h-11 w-11 rounded-xl object-cover\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"kilimani fresh grocers store image\" decoding=\"async\" loading=\"lazy\" src=\"https://picsum.photos/seed/logo2/80/80\"/>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-3-2-2-2-2-2\">\n                            <p class=\"truncate font-heading text-sm font-semibold\" data-kid=\"1-3-2-2-2-2-2-1\">\n                                Kilimani Fresh Grocers\n                            </p>\n                            <p class=\"mt-0.5 text-xs text-[#77746b]\" data-kid=\"1-3-2-2-2-2-2-2\">\n                                2.6 km · 4.6 ★ · 15–25 min\n                            </p>\n                        </div>\n                        <i class=\"h-4 w-4 text-[#9b988f]\" data-kid=\"1-3-2-2-2-2-3\" data-lucide=\"chevron-right\">\n                        </i>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-2-2-3\">\n                        <img alt=\"Threadline Fashion House\" class=\"h-11 w-11 rounded-xl object-cover\" data-kid=\"1-3-2-2-2-3-1\" data-name=\"threadline fashion house store image\" decoding=\"async\" loading=\"lazy\" src=\"https://picsum.photos/seed/logo3/80/80\"/>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-3-2-2-2-3-2\">\n                            <p class=\"truncate font-heading text-sm font-semibold\" data-kid=\"1-3-2-2-2-3-2-1\">\n                                Threadline Fashion House\n                            </p>\n                            <p class=\"mt-0.5 text-xs text-[#77746b]\" data-kid=\"1-3-2-2-2-3-2-2\">\n                                3.9 km · 4.9 ★ · 30–45 min\n                            </p>\n                        </div>\n                        <i class=\"h-4 w-4 text-[#9b988f]\" data-kid=\"1-3-2-2-2-3-3\" data-lucide=\"chevron-right\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <footer class=\"border-t border-[#e8e6dc] py-6 text-center text-[11px] text-[#9b988f]\" data-kid=\"1-4\">\n        Soko · local shopping, made easier\n    </footer>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    const orders = [\n    { id: 'SOKO-2481', title: 'Wireless Noise-Cancelling Headphones', shop: 'Mama Njeri Electronics', total: 'KSh 6,950', status: 'Out for delivery', payment: 'M-Pesa', date: 'Today, 14:20', image: 'https://picsum.photos/seed/head/500/500', eta: 'Arriving in ~12 min', address: 'Kilimani, Nairobi', delivery: 'KSh 150', featured: true, expanded: true },\n    { id: 'SOKO-2470', title: 'Fresh Produce Basket (Weekly)', shop: 'Kilimani Fresh Grocers', total: 'KSh 1,300', status: 'Delivered', payment: 'Card', date: 'Yesterday, 09:05', image: 'https://picsum.photos/seed/basket/120/120', eta: '', address: 'Kilimani, Nairobi', delivery: 'KSh 100', featured: false, expanded: false },\n    { id: 'SOKO-2455', title: 'Beaded Maasai Handbag', shop: 'Threadline Fashion House', total: 'KSh 2,800', status: 'Preparing', payment: 'Cash on delivery', date: 'Today, 11:48', image: 'https://picsum.photos/seed/bag/120/120', eta: 'Preparing for dispatch', address: 'Kilimani, Nairobi', delivery: 'KSh 200', featured: false, expanded: false }\n  ];\n\n  const statusClass = (status) => ({\n    'Confirmed': 'border-[#d8d5cc] bg-[#e8e6dc] text-[#141413]',\n    'Preparing': 'border-[#6a9bcc]/35 bg-[#6a9bcc]/10 text-[#557fa8]',\n    'Out for delivery': 'border-[#d97757]/35 bg-[#d97757]/10 text-[#c9694d]',\n    'Delivered': 'border-[#788c5d]/35 bg-[#788c5d]/10 text-[#64784b]'\n  }[status] || 'border-[#d8d5cc] bg-[#e8e6dc] text-[#141413]');\n\n  const steps = ['Confirmed', 'Preparing', 'Out for delivery', 'Delivered'];\n  const stepIcon = ['clipboard-check', 'package-open', 'truck', 'check-circle-2'];\n  let activeFilter = 'all';\n  let query = '';\n\n  function orderMatches(order) {\n    const matchesFilter = activeFilter === 'all' || (activeFilter === 'delivered' ? order.status === 'Delivered' : order.status !== 'Delivered');\n    const haystack = `${order.id} ${order.title} ${order.shop} ${order.status} ${order.payment}`.toLowerCase();\n    return matchesFilter && haystack.includes(query.toLowerCase().trim());\n  }\n\n  function tracker(order, compact = false) {\n    const current = steps.indexOf(order.status);\n    return `<div class=\"${compact ? 'mt-4' : 'mt-5'}\">\n      <div class=\"mb-2 flex items-center justify-between font-heading text-[10px] font-medium text-[#9b988f]\"><span>Order progress</span><span class=\"text-[#77746b]\">${order.status === 'Delivered' ? 'Complete' : `${Math.max(current, 0) + 1} of ${steps.length}`}</span></div>\n      <div class=\"flex items-start gap-0.5\">\n        ${steps.map((step, i) => `<div class=\"flex min-w-0 flex-1 items-start ${i === steps.length - 1 ? 'flex-none' : ''}\">\n          <div class=\"flex min-w-0 flex-col items-center gap-1.5\"><span class=\"flex h-7 w-7 items-center justify-center rounded-full ${i <= current ? 'bg-[#d97757] text-[#faf9f5]' : 'border border-[#d8d5cc] bg-white text-[#b0aea5]'}\"><i data-lucide=\"${stepIcon[i]}\" class=\"h-3.5 w-3.5 ${i <= current ? 'text-[#faf9f5]' : 'text-[#b0aea5]'}\"></i></span><span class=\"w-16 text-center font-heading text-[9px] leading-tight ${i <= current ? 'font-semibold text-[#141413]' : 'text-[#9b988f]'}\">${step}</span></div>\n          ${i < steps.length - 1 ? `<span class=\"mt-3.5 h-0.5 min-w-[18px] flex-1 ${i < current ? 'bg-[#d97757]' : 'bg-[#e8e6dc]'}\"></span>` : ''}\n        </div>`).join('')}\n      </div>\n    </div>`;\n  }\n\n  function trackingPanel(order) {\n    const delivered = order.status === 'Delivered';\n    return `<div class=\"h-full rounded-xl bg-[#faf9f5] p-5\">\n      <div class=\"flex items-start justify-between gap-3\"><div><p class=\"font-heading text-[11px] font-semibold uppercase tracking-[.14em] text-[#d97757]\">${delivered ? 'Delivery complete' : 'Live delivery'}</p><h3 class=\"mt-1 font-heading text-base font-semibold\">${delivered ? 'Delivered safely' : 'Your order is on the way'}</h3></div><span class=\"flex h-8 w-8 items-center justify-center rounded-full ${delivered ? 'bg-[#788c5d]/15' : 'bg-[#d97757]/15'}\"><i data-lucide=\"${delivered ? 'check-circle-2' : 'navigation'}\" class=\"h-4 w-4 ${delivered ? 'text-[#788c5d]' : 'text-[#d97757]'}\"></i></span></div>\n      <div class=\"mt-4 overflow-hidden rounded-xl border border-[#e8e6dc] bg-[#e8e6dc]/75\">\n        <div class=\"relative h-[138px] soko-map-grid overflow-hidden\">\n          <span class=\"map-road left-[-10px] top-[55px] w-[280px] rotate-[15deg]\"></span><span class=\"map-road left-[110px] top-[5px] w-[170px] rotate-[79deg]\"></span><span class=\"map-road left-[145px] top-[112px] w-[160px] rotate-[-32deg]\"></span>\n          <span class=\"absolute left-[24%] top-[34%] flex h-7 w-7 items-center justify-center rounded-full border-4 border-[#faf9f5] bg-[#6a9bcc] shadow-sm\"><i data-lucide=\"map-pin\" class=\"h-3.5 w-3.5 text-[#faf9f5]\"></i></span>\n          <span class=\"absolute right-[19%] top-[25%] flex h-8 w-8 items-center justify-center rounded-full border-4 border-[#faf9f5] bg-[#d97757] shadow-sm\"><i data-lucide=\"shopping-bag\" class=\"h-3.5 w-3.5 text-[#faf9f5]\"></i></span>\n          <span class=\"absolute bottom-2 left-2 rounded-md bg-[#faf9f5]/95 px-2 py-1 font-heading text-[9px] font-semibold text-[#6b6961] shadow-sm\">${delivered ? 'Kilimani drop-off' : 'Kilimani · Nairobi'}</span>\n        </div>\n        <div class=\"flex items-center gap-2 border-t border-[#e8e6dc] bg-white/80 px-3 py-2\"><i data-lucide=\"map-pin\" class=\"h-3 w-3 text-[#d97757]\"></i><span class=\"text-[10px] text-[#77746b]\">${order.address}</span><span class=\"ml-auto font-heading text-[10px] font-semibold text-[#141413]\">${delivered ? 'Delivered' : '1.2 km away'}</span></div>\n      </div>\n      <div class=\"mt-4 space-y-3\">\n        <div class=\"flex items-center gap-3\"><span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#d97757]/10\"><i data-lucide=\"truck\" class=\"h-3.5 w-3.5 text-[#d97757]\"></i></span><div class=\"min-w-0 flex-1\"><p class=\"font-heading text-[11px] font-semibold\">${delivered ? 'Order handed over' : 'Rider is heading to you'}</p><p class=\"mt-0.5 text-[10px] text-[#8d8b83]\">${delivered ? 'Delivered just now' : 'M-Pesa payment confirmed'}</p></div><span class=\"font-heading text-[10px] font-semibold ${delivered ? 'text-[#788c5d]' : 'text-[#d97757]'}\">${delivered ? 'Done' : '12 min'}</span></div>\n        <div class=\"flex items-center gap-3\"><span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#e8e6dc]\"><i data-lucide=\"phone\" class=\"h-3.5 w-3.5 text-[#6b6961]\"></i></span><div class=\"min-w-0 flex-1\"><p class=\"font-heading text-[11px] font-semibold\">${delivered ? 'Delivery details' : 'Need help with delivery?'}</p><p class=\"mt-0.5 text-[10px] text-[#8d8b83]\">${delivered ? 'Leave a review for the shop' : 'Chat with Mama Njeri Electronics'}</p></div><i data-lucide=\"chevron-right\" class=\"h-3.5 w-3.5 text-[#9b988f]\"></i></div>\n      </div>\n    </div>`;\n  }\n\n  function standardCard(order) {\n    const current = steps.indexOf(order.status);\n    return `<article class=\"order-card overflow-hidden rounded-2xl border border-[#e8e6dc] bg-white shadow-[0_2px_10px_rgba(20,20,19,.025)]\" data-id=\"${order.id}\">\n      <button class=\"order-toggle flex w-full items-center gap-4 p-4 text-left hover:bg-[#faf9f5]/70 sm:p-5\" data-id=\"${order.id}\" type=\"button\" aria-expanded=\"${order.expanded}\">\n        <img src=\"${order.image}\" alt=\"${order.title}\" loading=\"lazy\" decoding=\"async\" class=\"h-16 w-16 shrink-0 rounded-xl object-cover\" />\n        <div class=\"min-w-0 flex-1\"><div class=\"flex flex-wrap items-center gap-2\"><p class=\"font-heading text-[13px] font-semibold leading-tight\">${order.title}</p><span class=\"inline-flex items-center gap-1 rounded-full border px-2 py-0.5 font-heading text-[10px] font-semibold ${statusClass(order.status)}\"><span class=\"h-1.5 w-1.5 rounded-full bg-current opacity-70\"></span>${order.status}</span></div><p class=\"mt-1 text-[11px] text-[#77746b]\">${order.shop} · ${order.id}</p><p class=\"mt-2 text-[11px] text-[#9b988f]\">${order.date} · ${order.payment}</p></div>\n        <div class=\"hidden shrink-0 text-right sm:block\"><p class=\"font-heading text-sm font-semibold text-[#d97757]\">${order.total}</p><p class=\"mt-1 text-[10px] text-[#9b988f]\">${order.status === 'Delivered' ? 'Completed' : order.eta}</p></div>\n        <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#faf9f5] text-[#9b988f]\"><i data-lucide=\"chevron-down\" class=\"order-chevron h-4 w-4 text-[#9b988f] ${order.expanded ? 'rotate-180' : ''}\"></i></span>\n      </button>\n      <div class=\"order-body ${order.expanded ? '' : 'hidden'} border-t border-[#e8e6dc] px-5 pb-5 pt-1 sm:pl-[100px]\"><div class=\"flex items-center justify-between gap-4\"><p class=\"font-heading text-[11px] font-semibold text-[#6b6961]\">Delivery to ${order.address}</p><p class=\"font-heading text-xs font-semibold text-[#141413]\">${order.total}</p></div>${tracker(order, true)}</div>\n    </article>`;\n  }\n\n  function featuredCard(order) {\n    return `<article class=\"order-card overflow-hidden rounded-2xl border border-[#d97757]/25 bg-white shadow-[0_8px_24px_rgba(20,20,19,.055)]\" data-id=\"${order.id}\">\n      <div class=\"flex items-center justify-between border-b border-[#e8e6dc] bg-[#fffaf6] px-5 py-3\"><div class=\"flex items-center gap-2\"><span class=\"flex h-6 w-6 items-center justify-center rounded-full bg-[#d97757]/15\"><i data-lucide=\"radio\" class=\"h-3 w-3 text-[#d97757]\"></i></span><span class=\"font-heading text-[10px] font-bold uppercase tracking-[.14em] text-[#c9694d]\">Tracking now</span></div><span class=\"font-heading text-[10px] text-[#9b988f]\">Updated a moment ago</span></div>\n      <button class=\"order-toggle flex w-full items-start gap-4 p-5 text-left hover:bg-[#faf9f5]/40\" data-id=\"${order.id}\" type=\"button\" aria-expanded=\"${order.expanded}\">\n        <img src=\"${order.image}\" alt=\"${order.title}\" loading=\"lazy\" decoding=\"async\" class=\"h-[76px] w-[76px] shrink-0 rounded-xl object-cover\" />\n        <div class=\"min-w-0 flex-1\"><div class=\"flex flex-wrap items-center gap-2\"><p class=\"font-heading text-[15px] font-semibold leading-tight\">${order.title}</p><span class=\"inline-flex items-center gap-1 rounded-full border px-2.5 py-1 font-heading text-[10px] font-semibold ${statusClass(order.status)}\"><span class=\"h-1.5 w-1.5 rounded-full bg-current opacity-70\"></span>${order.status}</span></div><p class=\"mt-1 text-[12px] text-[#77746b]\">${order.shop} · ${order.id}</p><p class=\"mt-3 font-heading text-[13px] font-semibold text-[#d97757]\">${order.total} <span class=\"font-body text-[11px] font-normal text-[#9b988f]\">· ${order.payment}</span></p></div>\n        <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#faf9f5] text-[#9b988f]\"><i data-lucide=\"chevron-down\" class=\"order-chevron h-4 w-4 text-[#9b988f] ${order.expanded ? 'rotate-180' : ''}\"></i></span>\n      </button>\n      <div class=\"order-body ${order.expanded ? '' : 'hidden'} border-t border-[#e8e6dc] px-5 pb-5 pt-5\"><div class=\"grid gap-5 lg:grid-cols-[1fr_350px]\"><div><div class=\"flex items-center justify-between gap-4\"><div><p class=\"font-heading text-[12px] font-semibold\">${order.status === 'Delivered' ? 'Delivery complete' : 'Arriving in ~12 min'}</p><p class=\"mt-1 text-[11px] text-[#77746b]\">${order.status === 'Delivered' ? 'Thanks for shopping local.' : 'Your rider is on the way to Kilimani.'}</p></div><button id=\"deliver-${order.id}\" class=\"${order.status === 'Delivered' ? 'hidden' : ''} inline-flex h-8 items-center gap-1.5 rounded-lg border border-[#788c5d]/35 bg-[#788c5d]/10 px-3 font-heading text-[10px] font-semibold text-[#64784b] hover:bg-[#788c5d]/15\" data-deliver=\"${order.id}\" type=\"button\"><i data-lucide=\"check\" class=\"h-3.5 w-3.5 text-[#788c5d]\"></i> Mark as delivered</button></div>${tracker(order)}<div class=\"mt-5 flex flex-wrap gap-2\"><button class=\"inline-flex h-8 items-center gap-1.5 rounded-lg border border-[#d8d5cc] px-3 font-heading text-[10px] font-semibold text-[#6b6961] hover:border-[#d97757]/50 hover:text-[#141413]\" type=\"button\"><i data-lucide=\"message-circle\" class=\"h-3.5 w-3.5 text-[#6a9bcc]\"></i> Message seller</button><button class=\"inline-flex h-8 items-center gap-1.5 rounded-lg border border-[#d8d5cc] px-3 font-heading text-[10px] font-semibold text-[#6b6961] hover:border-[#d97757]/50 hover:text-[#141413]\" type=\"button\"><i data-lucide=\"receipt\" class=\"h-3.5 w-3.5 text-[#6a9bcc]\"></i> View receipt</button></div></div><div>${trackingPanel(order)}</div></div></div>\n    </article>`;\n  }\n\n  function render() {\n    const list = orders.filter(orderMatches);\n    const container = document.getElementById('order-list');\n    container.innerHTML = list.map(order => order.featured ? featuredCard(order) : standardCard(order)).join('');\n    document.getElementById('empty-state').classList.toggle('hidden', list.length > 0);\n    document.getElementById('result-copy').textContent = query ? `${list.length} ${list.length === 1 ? 'order' : 'orders'} matching “${query}”.` : 'Keep an eye on your deliveries, from checkout to doorstep.';\n    document.getElementById('search-status').textContent = query ? `${list.length} result${list.length === 1 ? '' : 's'}` : '';\n    if (window.lucide) window.lucide.createIcons();\n    document.querySelectorAll('.order-toggle').forEach(button => button.addEventListener('click', () => {\n      const item = orders.find(o => o.id === button.dataset.id);\n      if (!item) return;\n      item.expanded = !item.expanded;\n      render();\n    }));\n    document.querySelectorAll('[data-deliver]').forEach(button => button.addEventListener('click', (event) => {\n      event.stopPropagation();\n      const item = orders.find(o => o.id === button.dataset.deliver);\n      if (!item) return;\n      item.status = 'Delivered'; item.eta = ''; item.expanded = true;\n      render();\n    }));\n  }\n\n  function setFilter(filter) {\n    activeFilter = filter;\n    document.querySelectorAll('.status-tab').forEach(tab => {\n      const active = tab.dataset.filter === filter;\n      tab.classList.toggle('font-semibold', active); tab.classList.toggle('font-medium', !active); tab.classList.toggle('text-[#141413]', active); tab.classList.toggle('text-[#8d8b83]', !active);\n      tab.setAttribute('aria-selected', active ? 'true' : 'false');\n      tab.querySelector('.tab-line').classList.toggle('hidden', !active);\n    });\n    render();\n  }\n\n  function showBrowse() {\n    document.getElementById('orders-view').classList.add('hidden');\n    document.getElementById('browse-view').classList.remove('hidden');\n    document.getElementById('orders-nav').className = 'nav-button inline-flex h-9 items-center gap-2 rounded-lg px-3 text-[13px] font-medium text-[#6b6961] hover:bg-[#e8e6dc]/65 hover:text-[#141413]';\n    document.getElementById('browse-nav').className = 'nav-button inline-flex h-9 items-center gap-2 rounded-lg bg-[#e8e6dc] px-3 text-[13px] font-semibold text-[#141413]';\n  }\n\n  function showOrders() {\n    document.getElementById('browse-view').classList.add('hidden');\n    document.getElementById('orders-view').classList.remove('hidden');\n    document.getElementById('orders-nav').className = 'nav-button inline-flex h-9 items-center gap-2 rounded-lg bg-[#e8e6dc] px-3 text-[13px] font-semibold text-[#141413]';\n    document.getElementById('browse-nav').className = 'nav-button inline-flex h-9 items-center gap-2 rounded-lg px-3 text-[13px] font-medium text-[#6b6961] hover:bg-[#e8e6dc]/65 hover:text-[#141413]';\n    render();\n  }\n\n  document.querySelectorAll('.status-tab').forEach(tab => tab.addEventListener('click', () => setFilter(tab.dataset.filter)));\n  document.getElementById('order-search').addEventListener('input', (event) => { query = event.target.value; render(); });\n  document.getElementById('clear-search').addEventListener('click', () => { query = ''; document.getElementById('order-search').value = ''; render(); });\n  ['browse-action', 'dark-browse', 'browse-nav', 'logo-button', 'browse-products'].forEach(id => document.getElementById(id).addEventListener('click', showBrowse));\n  ['orders-action', 'orders-nav'].forEach(id => document.getElementById(id).addEventListener('click', showOrders));\n  document.getElementById('notification-button').addEventListener('click', (event) => { event.stopPropagation(); const pop = document.getElementById('notification-popover'); const open = pop.classList.toggle('hidden') === false; document.getElementById('notification-button').setAttribute('aria-expanded', open ? 'true' : 'false'); });\n  document.getElementById('mark-read').addEventListener('click', () => { document.querySelector('#notification-button span').classList.add('hidden'); document.getElementById('notification-popover').classList.add('hidden'); });\n  document.getElementById('sell-toggle').addEventListener('click', () => { document.getElementById('sell-toggle').className = 'rounded-full bg-[#141413] px-3.5 py-1.5 text-[#faf9f5]'; document.getElementById('buy-toggle').className = 'rounded-full px-3.5 py-1.5 text-[#6b6961]'; });\n  document.getElementById('buy-toggle').addEventListener('click', () => { document.getElementById('buy-toggle').className = 'rounded-full bg-[#141413] px-3.5 py-1.5 text-[#faf9f5]'; document.getElementById('sell-toggle').className = 'rounded-full px-3.5 py-1.5 text-[#6b6961]'; });\n  document.addEventListener('click', (event) => { if (!event.target.closest('#notification-button') && !event.target.closest('#notification-popover')) { document.getElementById('notification-popover').classList.add('hidden'); document.getElementById('notification-button').setAttribute('aria-expanded', 'false'); } });\n  if (window.lucide) window.lucide.createIcons();\n  render();\n</script>\n",
      "comments": [],
      "created": "2026-08-23T21:59:19.526701+00:00",
      "modified": "2026-08-23T22:00:22.411922+00:00",
      "id": "var_1a1a2046ac76"
    },
    "var_7b4e4873f995": {
      "type": "variant",
      "label": "Soko — Buyer Browse",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap');\n  :root {\n    --soko-paper: #faf9f5;\n    --soko-ink: #141413;\n    --soko-card: #ffffff;\n    --soko-orange: #d97757;\n    --soko-blue: #6a9bcc;\n    --soko-green: #788c5d;\n    --soko-sand: #e8e6dc;\n    --soko-muted: #706e67;\n    --soko-line: #d9d6cb;\n    --soko-radius: 14px;\n  }\n  .soko-shell { min-height: 100vh; background: var(--soko-paper); color: var(--soko-ink); font-family: 'Lora', Georgia, serif; }\n  .soko-heading, .soko-shell h1, .soko-shell h2, .soko-shell h3, .soko-shell button, .soko-shell input, .soko-shell select, .soko-shell .sans { font-family: 'Poppins', Arial, sans-serif; }\n  .soko-shell button { cursor: pointer; }\n  .soko-icon { width: 17px; height: 17px; stroke-width: 1.9; flex: 0 0 auto; }\n  .soko-icon-sm { width: 14px; height: 14px; stroke-width: 2; flex: 0 0 auto; }\n  .soko-icon-lg { width: 20px; height: 20px; stroke-width: 1.85; flex: 0 0 auto; }\n  .soko-topbar { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid rgba(20,20,19,.11); background: rgba(250,249,245,.93); backdrop-filter: blur(16px); }\n  .soko-topbar-inner { max-width: 1180px; height: 74px; margin: 0 auto; padding: 0 26px; display: flex; align-items: center; gap: 17px; }\n  .soko-brand { display: inline-flex; align-items: center; gap: 10px; flex: 0 0 auto; border: 0; padding: 0; background: transparent; color: var(--soko-ink); }\n  .soko-mark { width: 37px; height: 37px; display: grid; place-items: center; border-radius: 11px; background: var(--soko-orange); color: var(--soko-paper); font: 700 19px/1 'Poppins', sans-serif; }\n  .soko-brand-word { font: 700 20px/1 'Poppins', sans-serif; letter-spacing: -.04em; }\n  .soko-search { min-width: 180px; flex: 1 1 auto; max-width: 440px; position: relative; }\n  .soko-search input { width: 100%; height: 42px; border: 1px solid var(--soko-line); border-radius: 999px; background: rgba(255,255,255,.76); color: var(--soko-ink); outline: none; padding: 0 17px 0 42px; font-size: 12px; }\n  .soko-search input::placeholder { color: #8e8b83; }\n  .soko-search input:focus { border-color: var(--soko-orange); box-shadow: 0 0 0 3px rgba(217,119,87,.14); }\n  .soko-search .soko-search-icon { position: absolute; left: 15px; top: 13px; color: var(--soko-muted); pointer-events: none; }\n  .soko-location { display: inline-flex; align-items: center; gap: 6px; border: 0; border-radius: 999px; padding: 10px 13px; background: #eeece4; color: var(--soko-muted); font: 500 11px/1 'Poppins', sans-serif; white-space: nowrap; }\n  .soko-location .soko-icon-sm { color: var(--soko-orange); }\n  .soko-nav { display: flex; align-items: center; gap: 3px; margin-left: auto; }\n  .soko-nav button, .soko-ghost-btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 0; border-radius: 9px; padding: 9px 10px; background: transparent; color: var(--soko-muted); font: 500 11px/1 'Poppins', sans-serif; }\n  .soko-nav button:hover, .soko-ghost-btn:hover { background: #eeece4; color: var(--soko-ink); }\n  .soko-nav button[data-active='true'] { background: #e8e6dc; color: var(--soko-ink); }\n  .soko-notification-wrap { position: relative; }\n  .soko-notification { width: 36px; height: 36px; position: relative; display: grid; place-items: center; border: 0; border-radius: 10px; background: transparent; color: var(--soko-ink); }\n  .soko-notification:hover { background: #eeece4; }\n  .soko-notification-dot { width: 7px; height: 7px; position: absolute; top: 7px; right: 7px; border: 2px solid var(--soko-paper); border-radius: 999px; background: var(--soko-orange); }\n  .soko-popover { position: absolute; top: 47px; right: 0; width: 278px; border: 1px solid var(--soko-line); border-radius: 14px; padding: 14px; background: var(--soko-card); box-shadow: 0 18px 35px rgba(20,20,19,.12); }\n  .soko-popover[hidden], .soko-drawer[hidden], .soko-toast[hidden], .soko-seller-teaser[hidden], .soko-filter-panel[hidden], .soko-empty[hidden] { display: none; }\n  .soko-popover-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 10px; border-bottom: 1px solid #eceae2; }\n  .soko-popover-head strong { font: 600 12px/1 'Poppins', sans-serif; }\n  .soko-popover-head span { color: var(--soko-orange); font: 500 10px/1 'Poppins', sans-serif; }\n  .soko-notice { display: flex; gap: 10px; padding: 11px 0 3px; }\n  .soko-notice-mark { width: 28px; height: 28px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 9px; background: rgba(106,155,204,.15); color: var(--soko-blue); }\n  .soko-notice p { margin: 0; font: 500 11px/1.45 'Poppins', sans-serif; }\n  .soko-notice small { display: block; margin-top: 3px; color: var(--soko-muted); font: 400 10px/1.3 'Lora', serif; }\n  .soko-mode { display: inline-flex; flex: 0 0 auto; align-items: center; border: 1px solid var(--soko-line); border-radius: 999px; padding: 3px; background: var(--soko-card); }\n  .soko-mode button { min-width: 43px; border: 0; border-radius: 999px; padding: 7px 10px; background: transparent; color: var(--soko-muted); font: 600 10px/1 'Poppins', sans-serif; }\n  .soko-mode button[data-active='true'] { background: var(--soko-ink); color: var(--soko-paper); }\n  .soko-main { max-width: 1180px; margin: 0 auto; padding: 34px 26px 52px; }\n  .soko-hero { min-height: 274px; position: relative; overflow: hidden; display: flex; align-items: center; border-radius: 23px; padding: 42px 48px; background: var(--soko-ink); color: var(--soko-paper); }\n  .soko-hero-copy { position: relative; z-index: 1; max-width: 575px; }\n  .soko-eyebrow { margin: 0 0 12px; color: var(--soko-orange); font: 600 10px/1 'Poppins', sans-serif; letter-spacing: .21em; text-transform: uppercase; }\n  .soko-hero h1 { max-width: 600px; margin: 0; font: 700 38px/1.1 'Poppins', sans-serif; letter-spacing: -.045em; }\n  .soko-hero p { max-width: 515px; margin: 14px 0 0; color: rgba(250,249,245,.7); font: 400 14px/1.6 'Lora', serif; }\n  .soko-hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 23px; }\n  .soko-primary-btn, .soko-outline-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border-radius: 10px; padding: 12px 17px; font: 600 11px/1 'Poppins', sans-serif; }\n  .soko-primary-btn { border: 1px solid var(--soko-orange); background: var(--soko-orange); color: var(--soko-paper); }\n  .soko-primary-btn:hover { background: #c96749; border-color: #c96749; }\n  .soko-outline-btn { border: 1px solid rgba(250,249,245,.3); background: transparent; color: var(--soko-paper); }\n  .soko-outline-btn:hover { border-color: rgba(250,249,245,.62); background: rgba(250,249,245,.08); }\n  .soko-hero-orb { position: absolute; border-radius: 999px; pointer-events: none; filter: blur(1px); opacity: .7; }\n  .soko-hero-orb.orange { width: 210px; height: 210px; right: 108px; top: -90px; background: rgba(217,119,87,.37); filter: blur(29px); }\n  .soko-hero-orb.blue { width: 180px; height: 180px; right: -30px; bottom: -100px; background: rgba(106,155,204,.34); filter: blur(24px); }\n  .soko-hero-orb-ring { width: 270px; height: 270px; position: absolute; right: 65px; top: 29px; border: 1px solid rgba(250,249,245,.12); border-radius: 999px; transform: rotate(19deg); }\n  .soko-section { margin-top: 34px; }\n  .soko-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 14px; }\n  .soko-section-head h2 { margin: 0; font: 600 20px/1.2 'Poppins', sans-serif; letter-spacing: -.035em; }\n  .soko-section-head p { margin: 5px 0 0; color: var(--soko-muted); font: 400 11px/1.35 'Lora', serif; }\n  .soko-section-actions { display: flex; align-items: center; gap: 7px; }\n  .soko-filter-btn { display: inline-flex; align-items: center; gap: 7px; border: 0; border-radius: 8px; padding: 8px 10px; background: transparent; color: var(--soko-muted); font: 500 10px/1 'Poppins', sans-serif; }\n  .soko-filter-btn:hover, .soko-filter-btn[data-active='true'] { background: #eeece4; color: var(--soko-ink); }\n  .soko-filter-panel { display: flex; align-items: center; gap: 9px; margin: -4px 0 16px; padding: 10px 12px; border: 1px solid var(--soko-line); border-radius: 11px; background: rgba(255,255,255,.6); }\n  .soko-filter-panel span { color: var(--soko-muted); font: 400 11px/1.3 'Lora', serif; }\n  .soko-filter-tag { border: 1px solid var(--soko-line); border-radius: 999px; padding: 6px 10px; background: var(--soko-card); color: var(--soko-ink); font: 500 10px/1 'Poppins', sans-serif; }\n  .soko-filter-tag:hover, .soko-filter-tag[data-active='true'] { border-color: var(--soko-orange); background: rgba(217,119,87,.09); color: var(--soko-orange); }\n  .soko-categories { display: flex; flex-wrap: wrap; gap: 8px; }\n  .soko-category { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--soko-line); border-radius: 999px; padding: 10px 14px; background: var(--soko-card); color: var(--soko-ink); font: 500 11px/1 'Poppins', sans-serif; transition: border-color .18s, background .18s, color .18s; }\n  .soko-category:hover { border-color: rgba(217,119,87,.55); background: #f3f0e8; }\n  .soko-category[data-active='true'] { border-color: var(--soko-orange); background: var(--soko-orange); color: var(--soko-paper); }\n  .soko-category .soko-icon-sm { color: var(--soko-blue); }\n  .soko-category[data-active='true'] .soko-icon-sm { color: var(--soko-paper); }\n  .soko-products { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; }\n  .soko-products.all-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n  .soko-product { position: relative; overflow: hidden; border: 1px solid rgba(20,20,19,.11); border-radius: var(--soko-radius); background: var(--soko-card); cursor: pointer; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }\n  .soko-product:hover { transform: translateY(-2px); border-color: rgba(217,119,87,.44); box-shadow: 0 11px 23px rgba(20,20,19,.08); }\n  .soko-product:focus-visible { outline: 3px solid rgba(106,155,204,.45); outline-offset: 3px; }\n  .soko-product-image { position: relative; overflow: hidden; aspect-ratio: 1 / .92; background: #efede6; }\n  .soko-product-image img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .28s ease; }\n  .soko-product:hover .soko-product-image img { transform: scale(1.045); }\n  .soko-featured-pill, .soko-distance-pill { position: absolute; display: inline-flex; align-items: center; gap: 5px; border-radius: 7px; font: 500 9px/1 'Poppins', sans-serif; }\n  .soko-featured-pill { top: 10px; left: 10px; padding: 6px 7px; background: var(--soko-orange); color: var(--soko-paper); }\n  .soko-distance-pill { left: 10px; bottom: 10px; padding: 5px 7px; background: rgba(20,20,19,.79); color: var(--soko-paper); backdrop-filter: blur(8px); }\n  .soko-product-body { padding: 13px 13px 14px; }\n  .soko-product-title { min-height: 32px; margin: 0; display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: var(--soko-ink); font: 500 12px/1.35 'Lora', serif; }\n  .soko-product-price { margin: 8px 0 9px; color: var(--soko-orange); font: 700 17px/1 'Poppins', sans-serif; letter-spacing: -.035em; }\n  .soko-product-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\n  .soko-stars { display: inline-flex; align-items: center; gap: 4px; color: var(--soko-orange); font: 500 10px/1 'Poppins', sans-serif; }\n  .soko-stars .soko-icon-sm { width: 13px; height: 13px; fill: var(--soko-orange); }\n  .soko-sold { color: var(--soko-muted); font: 400 10px/1 'Lora', serif; }\n  .soko-shop-name { overflow: hidden; margin: 9px 0 0; color: var(--soko-muted); font: 400 10px/1.2 'Lora', serif; text-overflow: ellipsis; white-space: nowrap; }\n  .soko-empty { margin-top: 18px; padding: 28px; border: 1px dashed var(--soko-line); border-radius: var(--soko-radius); text-align: center; background: rgba(255,255,255,.48); }\n  .soko-empty strong { display: block; font: 600 14px/1.2 'Poppins', sans-serif; }\n  .soko-empty p { margin: 7px 0 13px; color: var(--soko-muted); font: 400 12px/1.4 'Lora', serif; }\n  .soko-empty button { border: 0; border-radius: 8px; padding: 9px 12px; background: var(--soko-ink); color: var(--soko-paper); font: 500 10px/1 'Poppins', sans-serif; }\n  .soko-seller-teaser { margin-top: 28px; overflow: hidden; border-radius: 20px; background: var(--soko-ink); color: var(--soko-paper); }\n  .soko-seller-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding: 28px 30px 22px; }\n  .soko-seller-top h2 { margin: 0; font: 600 24px/1.15 'Poppins', sans-serif; letter-spacing: -.04em; }\n  .soko-seller-top p { max-width: 460px; margin: 8px 0 0; color: rgba(250,249,245,.64); font: 400 12px/1.5 'Lora', serif; }\n  .soko-seller-top .soko-primary-btn { flex: 0 0 auto; }\n  .soko-seller-grid { display: grid; grid-template-columns: 1.2fr .8fr .8fr .8fr; gap: 1px; background: rgba(250,249,245,.13); }\n  .soko-seller-stat { padding: 18px 20px; background: rgba(250,249,245,.045); }\n  .soko-seller-stat span { display: block; color: rgba(250,249,245,.58); font: 500 10px/1.2 'Poppins', sans-serif; }\n  .soko-seller-stat strong { display: block; margin-top: 8px; font: 600 22px/1 'Poppins', sans-serif; }\n  .soko-seller-stat strong.orange { color: var(--soko-orange); }\n  .soko-seller-stat strong.green { color: #a9bc88; }\n  .soko-footer { display: flex; align-items: center; justify-content: space-between; max-width: 1180px; margin: 0 auto; padding: 18px 26px 26px; border-top: 1px solid rgba(20,20,19,.11); color: var(--soko-muted); font: 400 10px/1.3 'Lora', serif; }\n  .soko-footer strong { color: var(--soko-ink); font: 600 11px/1 'Poppins', sans-serif; }\n  .soko-drawer-backdrop { position: fixed; inset: 0; z-index: 40; background: rgba(20,20,19,.34); backdrop-filter: blur(2px); }\n  .soko-drawer { width: min(420px, calc(100vw - 24px)); height: 100vh; position: fixed; top: 0; right: 0; z-index: 41; overflow-y: auto; padding: 17px; background: var(--soko-paper); box-shadow: -15px 0 36px rgba(20,20,19,.17); }\n  .soko-drawer-close { width: 35px; height: 35px; display: grid; place-items: center; border: 1px solid var(--soko-line); border-radius: 10px; background: var(--soko-card); color: var(--soko-ink); }\n  .soko-drawer-header { display: flex; align-items: center; justify-content: space-between; }\n  .soko-drawer-image { overflow: hidden; margin-top: 18px; border-radius: 16px; background: #efede6; }\n  .soko-drawer-image img { width: 100%; height: 310px; display: block; object-fit: cover; }\n  .soko-drawer-content { padding: 20px 3px; }\n  .soko-drawer-tags { display: flex; align-items: center; gap: 7px; }\n  .soko-drawer-tag { border-radius: 6px; padding: 6px 8px; background: #e8e6dc; color: var(--soko-ink); font: 500 9px/1 'Poppins', sans-serif; }\n  .soko-drawer-tag.outline { border: 1px solid var(--soko-line); background: transparent; color: var(--soko-muted); }\n  .soko-drawer h2 { margin: 11px 0 0; font: 600 25px/1.16 'Poppins', sans-serif; letter-spacing: -.04em; }\n  .soko-drawer-price { margin: 12px 0 0; color: var(--soko-orange); font: 700 27px/1 'Poppins', sans-serif; }\n  .soko-drawer-details { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 13px; color: var(--soko-muted); font: 400 11px/1.3 'Lora', serif; }\n  .soko-drawer-detail { display: inline-flex; align-items: center; gap: 5px; }\n  .soko-drawer-detail .soko-icon-sm { color: var(--soko-blue); }\n  .soko-seller-card { display: flex; align-items: center; gap: 10px; margin-top: 20px; padding: 11px; border: 1px solid var(--soko-line); border-radius: 12px; background: var(--soko-card); }\n  .soko-seller-card img { width: 38px; height: 38px; border-radius: 10px; object-fit: cover; }\n  .soko-seller-card strong { display: flex; align-items: center; gap: 4px; font: 600 11px/1.2 'Poppins', sans-serif; }\n  .soko-seller-card p { margin: 4px 0 0; color: var(--soko-muted); font: 400 10px/1.2 'Lora', serif; }\n  .soko-drawer-actions { display: flex; gap: 8px; margin-top: 18px; }\n  .soko-drawer-actions button { flex: 1; }\n  .soko-secondary-action { display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid var(--soko-line); border-radius: 10px; padding: 12px 13px; background: var(--soko-card); color: var(--soko-ink); font: 600 10px/1 'Poppins', sans-serif; }\n  .soko-secondary-action:hover { border-color: var(--soko-orange); color: var(--soko-orange); }\n  .soko-toast { position: fixed; right: 24px; bottom: 23px; z-index: 60; display: flex; align-items: center; gap: 9px; max-width: 340px; border: 1px solid rgba(120,140,93,.35); border-radius: 11px; padding: 12px 14px; background: var(--soko-card); color: var(--soko-ink); box-shadow: 0 12px 26px rgba(20,20,19,.13); font: 500 11px/1.35 'Poppins', sans-serif; }\n  .soko-toast .soko-icon-sm { color: var(--soko-green); }\n  @media (max-width: 960px) {\n    .soko-topbar-inner { gap: 11px; }\n    .soko-location { display: none; }\n    .soko-nav button span { display: none; }\n    .soko-nav button { width: 34px; height: 34px; padding: 0; }\n    .soko-products.all-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n    .soko-seller-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  }\n  @media (max-width: 680px) {\n    .soko-topbar-inner { height: auto; flex-wrap: wrap; padding: 12px 16px; }\n    .soko-search { order: 3; min-width: 100%; max-width: none; }\n    .soko-nav { margin-left: auto; }\n    .soko-main { padding: 20px 16px 40px; }\n    .soko-hero { min-height: 310px; padding: 30px 24px; }\n    .soko-hero h1 { font-size: 29px; }\n    .soko-hero p { font-size: 13px; }\n    .soko-products, .soko-products.all-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }\n    .soko-product-body { padding: 11px; }\n    .soko-section-head { align-items: flex-start; }\n    .soko-section-head h2 { font-size: 17px; }\n    .soko-filter-panel { flex-wrap: wrap; }\n    .soko-seller-top { display: block; padding: 24px; }\n    .soko-seller-top .soko-primary-btn { margin-top: 17px; }\n    .soko-footer { padding-right: 16px; padding-left: 16px; }\n  }\n</style>\n<div class=\"soko-shell\" data-kid=\"1\" data-name=\"marketplace shell container\" id=\"sokoApp\">\n    <header class=\"soko-topbar\" data-kid=\"1-1\" data-name=\"main top navigation bar\">\n        <div class=\"soko-topbar-inner\" data-kid=\"1-1-1\" data-name=\"navigation layout wrapper\">\n            <button aria-label=\"Go to Soko home\" class=\"soko-brand\" data-action=\"home\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name button\">\n                <span class=\"soko-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand letter mark\">\n                    S\n                </span>\n                <span class=\"soko-brand-word\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    Soko\n                </span>\n            </button>\n            <label aria-label=\"Search marketplace\" class=\"soko-search\" data-kid=\"1-1-1-2\" data-name=\"marketplace search bar\">\n                <i class=\"soko-icon soko-search-icon\" data-kid=\"1-1-1-2-1\" data-lucide=\"search\" data-name=\"search magnifying glass icon\">\n                </i>\n                <input autocomplete=\"off\" data-kid=\"1-1-1-2-2\" data-name=\"search input field\" id=\"searchInput\" placeholder=\"Search products, shops, categories…\" type=\"search\"/>\n            </label>\n            <button aria-label=\"Current location Nairobi\" class=\"soko-location\" data-action=\"location\" data-kid=\"1-1-1-3\" data-name=\"location display button\">\n                <i class=\"soko-icon-sm\" data-kid=\"1-1-1-3-1\" data-lucide=\"map-pin\" data-name=\"map pin icon\">\n                </i>\n                <span data-kid=\"1-1-1-3-2\" data-name=\"location name text\">\n                    Nairobi\n                </span>\n            </button>\n            <nav aria-label=\"Primary navigation\" class=\"soko-nav\" data-kid=\"1-1-1-4\" data-name=\"primary navigation menu\">\n                <button data-action=\"nav\" data-active=\"true\" data-kid=\"1-1-1-4-1\" data-name=\"browse navigation button\" data-screen=\"browse\">\n                    <i class=\"soko-icon-sm\" data-kid=\"1-1-1-4-1-1\" data-lucide=\"home\" data-name=\"browse home icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-4-1-2\" data-name=\"browse label text\">\n                        Browse\n                    </span>\n                </button>\n                <button data-action=\"nav\" data-kid=\"1-1-1-4-2\" data-name=\"orders navigation button\" data-screen=\"orders\">\n                    <i class=\"soko-icon-sm\" data-kid=\"1-1-1-4-2-1\" data-lucide=\"package\" data-name=\"orders package icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-4-2-2\" data-name=\"orders label text\">\n                        Orders\n                    </span>\n                </button>\n                <button data-action=\"nav\" data-kid=\"1-1-1-4-3\" data-name=\"messages navigation button\" data-screen=\"messages\">\n                    <i class=\"soko-icon-sm\" data-kid=\"1-1-1-4-3-1\" data-lucide=\"message-circle\" data-name=\"messages chat icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-4-3-2\" data-name=\"messages label text\">\n                        Messages\n                    </span>\n                </button>\n            </nav>\n            <div class=\"soko-notification-wrap\" data-kid=\"1-1-1-5\" data-name=\"notification wrapper\">\n                <button aria-expanded=\"false\" aria-label=\"Open notifications\" class=\"soko-notification\" data-kid=\"1-1-1-5-1\" data-name=\"notification trigger button\" id=\"notificationButton\">\n                    <i class=\"soko-icon\" data-kid=\"1-1-1-5-1-1\" data-lucide=\"bell\" data-name=\"bell notification icon\">\n                    </i>\n                    <span class=\"soko-notification-dot\" data-kid=\"1-1-1-5-1-2\" data-name=\"notification indicator dot\">\n                    </span>\n                </button>\n                <div class=\"soko-popover\" data-dynamic=\"true\" data-kid=\"1-1-1-5-2\" data-name=\"notification popover panel\" data-reason=\"hidden state toggled by script\" hidden=\"\" id=\"notificationPopover\">\n                    <div class=\"soko-popover-head\" data-kid=\"1-1-1-5-2-1\" data-name=\"popover header\">\n                        <strong data-kid=\"1-1-1-5-2-1-1\" data-name=\"popover title\">\n                            Notifications\n                        </strong>\n                        <span data-kid=\"1-1-1-5-2-1-2\" data-name=\"popover new count label\">\n                            1 new\n                        </span>\n                    </div>\n                    <div class=\"soko-notice\" data-kid=\"1-1-1-5-2-2\" data-name=\"notification notice item\">\n                        <span class=\"soko-notice-mark\" data-kid=\"1-1-1-5-2-2-1\" data-name=\"notice mark container\">\n                            <i class=\"soko-icon-sm\" data-kid=\"1-1-1-5-2-2-1-1\" data-lucide=\"truck\" data-name=\"notice truck icon\">\n                            </i>\n                        </span>\n                        <p data-kid=\"1-1-1-5-2-2-2\" data-name=\"notice text content\">\n                            Your order is on the way.\n                            <small data-kid=\"1-1-1-5-2-2-2-1\" data-name=\"notice timestamp text\">\n                                SOKO-2481 · Arriving in ~12 min\n                            </small>\n                        </p>\n                    </div>\n                    <button class=\"soko-ghost-btn\" data-action=\"toast\" data-kid=\"1-1-1-5-2-3\" data-message=\"Notifications marked as read\" data-name=\"mark as read button\" style=\"padding-left:0; margin-top:5px;\">\n                        Mark all as read\n                    </button>\n                </div>\n            </div>\n            <div aria-label=\"Choose marketplace mode\" class=\"soko-mode\" data-kid=\"1-1-1-6\" data-name=\"marketplace mode selector\">\n                <button data-active=\"true\" data-kid=\"1-1-1-6-1\" data-mode=\"buyer\" data-name=\"buy mode switch\" id=\"buyMode\">\n                    Buy\n                </button>\n                <button data-active=\"false\" data-kid=\"1-1-1-6-2\" data-mode=\"seller\" data-name=\"sell mode switch\" id=\"sellMode\">\n                    Sell\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"soko-main\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-label=\"Soko buyer marketplace\" data-dynamic=\"true\" data-kid=\"1-2-1\" data-name=\"buyer marketplace section\" data-reason=\"hidden state toggled by script\" id=\"buyerContent\">\n            <section class=\"soko-hero\" data-kid=\"1-2-1-1\" data-name=\"hero banner section\">\n                <div class=\"soko-hero-copy\" data-kid=\"1-2-1-1-1\" data-name=\"hero text container\">\n                    <p class=\"soko-eyebrow\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero eyebrow label\">\n                        Soko marketplace\n                    </p>\n                    <h1 data-kid=\"1-2-1-1-1-2\" data-name=\"hero main headline\">\n                        Everything your neighbourhood sells — in one place.\n                    </h1>\n                    <p data-kid=\"1-2-1-1-1-3\" data-name=\"hero description text\">\n                        Find local retailers, get directions, chat, and pay by M-Pesa, card, or cash on delivery.\n                    </p>\n                    <div class=\"soko-hero-actions\" data-kid=\"1-2-1-1-1-4\" data