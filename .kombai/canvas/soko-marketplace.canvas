1\" data-name=\"product image area\">\n                            <img alt=\"Bluetooth Party Speaker\" data-kid=\"1-2-1-4-2-7-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://picsum.photos/seed/speaker/500/500\"/>\n                            <span class=\"soko-distance-pill\" data-kid=\"1-2-1-4-2-7-1-2\" data-name=\"product distance pill\">\n                                <i class=\"soko-icon-sm\" data-kid=\"1-2-1-4-2-7-1-2-1\" data-lucide=\"map-pin\" data-name=\"product location pin icon\">\n                                </i>\n                                1.2 km\n                            </span>\n                        </div>\n                        <div class=\"soko-product-body\" data-kid=\"1-2-1-4-2-7-2\" data-name=\"product details body\">\n                            <p class=\"soko-product-title\" data-kid=\"1-2-1-4-2-7-2-1\" data-name=\"product title text\">\n                                Bluetooth Party Speaker\n                            </p>\n                            <p class=\"soko-product-price\" data-kid=\"1-2-1-4-2-7-2-2\" data-name=\"product price text\">\n                                KSh 5,400\n                            </p>\n                            <div class=\"soko-product-meta\" data-kid=\"1-2-1-4-2-7-2-3\" data-name=\"product meta data\">\n                                <span class=\"soko-stars\" data-kid=\"1-2-1-4-2-7-2-3-1\" data-name=\"product rating stars group\">\n                                    <i class=\"soko-icon-sm\" data-kid=\"1-2-1-4-2-7-2-3-1-1\" data-lucide=\"star\" data-name=\"rating star icon\">\n                                    </i>\n                                    4.6\n                                </span>\n                                <span class=\"soko-sold\" data-kid=\"1-2-1-4-2-7-2-3-2\" data-name=\"units sold text\">\n                                    76 sold\n                                </span>\n                            </div>\n                            <p class=\"soko-shop-name\" data-kid=\"1-2-1-4-2-7-2-4\" data-name=\"shop name text\">\n                                Mama Njeri Electronics\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"soko-product\" data-address=\"Westgate Mall, Westlands\" data-category=\"Fashion\" data-condition=\"New\" data-delivery=\"KSh 200\" data-distance=\"3.9\" data-dynamic=\"true\" data-eta=\"30–45 min\" data-featured=\"true\" data-image=\"https://picsum.photos/seed/bag/500/500\" data-kid=\"1-2-1-4-2-8\" data-name=\"regular product card\" data-price=\"KSh 2,600\" data-rating=\"5.0\" data-reason=\"hidden state toggled by script\" data-shop=\"Threadline Fashion House\" data-sold=\"43 sold\" data-title=\"Beaded Maasai Handbag\" tabindex=\"0\">\n                        <div class=\"soko-product-image\" data-kid=\"1-2-1-4-2-8-1\" data-name=\"product image area\">\n                            <img alt=\"Beaded Maasai Handbag\" data-kid=\"1-2-1-4-2-8-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://picsum.photos/seed/bag/500/500\"/>\n                            <span class=\"soko-featured-pill\" data-kid=\"1-2-1-4-2-8-1-2\" data-name=\"featured pill badge\">\n                                <i class=\"soko-icon-sm\" data-kid=\"1-2-1-4-2-8-1-2-1\" data-lucide=\"sparkles\" data-name=\"featured sparkles icon\">\n                                </i>\n                                Featured\n                            </span>\n                            <span class=\"soko-distance-pill\" data-kid=\"1-2-1-4-2-8-1-3\" data-name=\"product distance pill\">\n                                <i class=\"soko-icon-sm\" data-kid=\"1-2-1-4-2-8-1-3-1\" data-lucide=\"map-pin\" data-name=\"product location pin icon\">\n                                </i>\n                                3.9 km\n                            </span>\n                        </div>\n                        <div class=\"soko-product-body\" data-kid=\"1-2-1-4-2-8-2\" data-name=\"product details body\">\n                            <p class=\"soko-product-title\" data-kid=\"1-2-1-4-2-8-2-1\" data-name=\"product title text\">\n                                Beaded Maasai Handbag\n                            </p>\n                            <p class=\"soko-product-price\" data-kid=\"1-2-1-4-2-8-2-2\" data-name=\"product price text\">\n                                KSh 2,600\n                            </p>\n                            <div class=\"soko-product-meta\" data-kid=\"1-2-1-4-2-8-2-3\" data-name=\"product meta data\">\n                                <span class=\"soko-stars\" data-kid=\"1-2-1-4-2-8-2-3-1\" data-name=\"product rating stars group\">\n                                    <i class=\"soko-icon-sm\" data-kid=\"1-2-1-4-2-8-2-3-1-1\" data-lucide=\"star\" data-name=\"rating star icon\">\n                                    </i>\n                                    5.0\n                                </span>\n                                <span class=\"soko-sold\" data-kid=\"1-2-1-4-2-8-2-3-2\" data-name=\"units sold text\">\n                                    43 sold\n                                </span>\n                            </div>\n                            <p class=\"soko-shop-name\" data-kid=\"1-2-1-4-2-8-2-4\" data-name=\"shop name text\">\n                                Threadline Fashion House\n                            </p>\n                        </div>\n                    </article>\n                </div>\n                <div class=\"soko-empty\" data-dynamic=\"true\" data-kid=\"1-2-1-4-3\" data-name=\"no results empty state\" data-reason=\"hidden state toggled by script\" hidden=\"\" id=\"emptyState\">\n                    <strong data-kid=\"1-2-1-4-3-1\" data-name=\"empty title\">\n                        No listings match that search.\n                    </strong>\n                    <p data-kid=\"1-2-1-4-3-2\" data-name=\"empty description\">\n                        Try another product, shop, or category near Nairobi.\n                    </p>\n                    <button data-action=\"reset-search\" data-kid=\"1-2-1-4-3-3\" data-name=\"clear search button\">\n                        Clear search\n                    </button>\n                </div>\n            </section>\n        </section>\n        <section aria-label=\"Soko seller dashboard preview\" class=\"soko-seller-teaser\" data-dynamic=\"true\" data-kid=\"1-2-2\" data-name=\"seller dashboard teaser section\" data-reason=\"hidden state toggled by script\" hidden=\"\" id=\"sellerTeaser\">\n            <div class=\"soko-seller-top\" data-kid=\"1-2-2-1\" data-name=\"seller section top header\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"seller text content\">\n                    <p class=\"soko-eyebrow\" data-kid=\"1-2-2-1-1-1\" data-name=\"seller eyebrow label\">\n                        Soko seller space\n                    </p>\n                    <h2 data-kid=\"1-2-2-1-1-2\" data-name=\"seller headline\">\n                        Turn your stock into your next customer.\n                    </h2>\n                    <p data-kid=\"1-2-2-1-1-3\" data-name=\"seller description text\">\n                        Your shop dashboard is ready for listings, orders, promotions, and wallet payouts — all in one place.\n                    </p>\n                </div>\n                <button class=\"soko-primary-btn\" data-action=\"toast\" data-kid=\"1-2-2-1-2\" data-message=\"Seller onboarding started — your shop draft is saved\" data-name=\"new listing primary button\">\n                    <i class=\"soko-icon-sm\" data-kid=\"1-2-2-1-2-1\" data-lucide=\"plus\" data-name=\"add plus icon\">\n                    </i>\n                    New listing\n                </button>\n            </div>\n            <div class=\"soko-seller-grid\" data-kid=\"1-2-2-2\" data-name=\"seller dashboard stats grid\">\n                <div class=\"soko-seller-stat\" data-kid=\"1-2-2-2-1\" data-name=\"shop name stat card\">\n                    <span data-kid=\"1-2-2-2-1-1\" data-name=\"shop name label\">\n                        Shop\n                    </span>\n                    <strong data-kid=\"1-2-2-2-1-2\" data-name=\"shop name value\">\n                        Mama Njeri Electronics\n                    </strong>\n                </div>\n                <div class=\"soko-seller-stat\" data-kid=\"1-2-2-2-2\" data-name=\"wallet balance stat card\">\n                    <span data-kid=\"1-2-2-2-2-1\" data-name=\"wallet balance label\">\n                        Wallet balance\n                    </span>\n                    <strong class=\"orange\" data-kid=\"1-2-2-2-2-2\" data-name=\"wallet balance value\">\n                        KSh 48,250\n                    </strong>\n                </div>\n                <div class=\"soko-seller-stat\" data-kid=\"1-2-2-2-3\" data-name=\"weekly sales stat card\">\n                    <span data-kid=\"1-2-2-2-3-1\" data-name=\"weekly sales label\">\n                        Sales this week\n                    </span>\n                    <strong data-kid=\"1-2-2-2-3-2\" data-name=\"weekly sales value\">\n                        KSh 21,400\n                    </strong>\n                </div>\n                <div class=\"soko-seller-stat\" data-kid=\"1-2-2-2-4\" data-name=\"rating stat card\">\n                    <span data-kid=\"1-2-2-2-4-1\" data-name=\"rating label\">\n                        Shop rating\n                    </span>\n                    <strong class=\"green\" data-kid=\"1-2-2-2-4-2\" data-name=\"rating value\">\n                        4.8 ★\n                    </strong>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"soko-footer\" data-kid=\"1-3\" data-name=\"footer section\">\n        <span data-kid=\"1-3-1\" data-name=\"copyright name notice\">\n            <strong data-kid=\"1-3-1-1\" data-name=\"company name\">\n                Soko\n            </strong>\n            · Local finds, delivered with care.\n        </span>\n        <span data-kid=\"1-3-2\" data-name=\"prototype metadata text\">\n            Prototype UI · Nairobi\n        </span>\n    </footer>\n    <div class=\"soko-drawer-backdrop\" data-dynamic=\"true\" data-kid=\"1-4\" data-name=\"drawer backdrop layer\" data-reason=\"hidden state toggled by script\" hidden=\"\" id=\"drawerBackdrop\">\n    </div>\n    <aside aria-label=\"Product details\" aria-modal=\"true\" class=\"soko-drawer\" data-dynamic=\"true\" data-kid=\"1-5\" data-name=\"product detail drawer panel\" data-reason=\"hidden state toggled by script\" hidden=\"\" id=\"productDrawer\" role=\"dialog\">\n        <div class=\"soko-drawer-header\" data-kid=\"1-5-1\" data-name=\"drawer header\">\n            <span class=\"soko-eyebrow\" data-kid=\"1-5-1-1\" data-name=\"drawer eyebrow label\" style=\"margin:0;\">\n                Product details\n            </span>\n            <button aria-label=\"Close product details\" class=\"soko-drawer-close\" data-kid=\"1-5-1-2\" data-name=\"drawer close button\" id=\"drawerClose\">\n                <i class=\"soko-icon\" data-kid=\"1-5-1-2-1\" data-lucide=\"x\" data-name=\"close icon\">\n                </i>\n            </button>\n        </div>\n        <div class=\"soko-drawer-image\" data-kid=\"1-5-2\" data-name=\"drawer image container\">\n            <img alt=\"\" data-dynamic=\"true\" data-kid=\"1-5-2-1\" data-name=\"drawer product image\" data-reason=\"src and alt updated by script\" decoding=\"async\" id=\"drawerImage\" loading=\"lazy\" src=\"https://picsum.photos/seed/head/500/500\"/>\n        </div>\n        <div class=\"soko-drawer-content\" data-kid=\"1-5-3\" data-name=\"drawer content wrapper\">\n            <div class=\"soko-drawer-tags\" data-kid=\"1-5-3-1\" data-name=\"drawer tag list\">\n                <span class=\"soko-drawer-tag\" data-dynamic=\"true\" data-kid=\"1-5-3-1-1\" data-name=\"drawer category tag\" data-reason=\"text updated by script\" id=\"drawerCategory\">\n                    Electronics\n                </span>\n                <span class=\"soko-drawer-tag outline\" data-dynamic=\"true\" data-kid=\"1-5-3-1-2\" data-name=\"drawer condition tag\" data-reason=\"text updated by script\" id=\"drawerCondition\">\n                    New\n                </span>\n            </div>\n            <h2 data-dynamic=\"true\" data-kid=\"1-5-3-2\" data-name=\"drawer product title\" data-reason=\"text updated by script\" id=\"drawerTitle\">\n                Wireless Noise-Cancelling Headphones\n            </h2>\n            <p class=\"soko-drawer-price\" data-dynamic=\"true\" data-kid=\"1-5-3-3\" data-name=\"drawer product price\" data-reason=\"text updated by script\" id=\"drawerPrice\">\n                KSh 6,800\n            </p>\n            <div class=\"soko-drawer-details\" data-kid=\"1-5-3-4\" data-name=\"drawer product metadata detail\">\n                <span class=\"soko-drawer-detail\" data-kid=\"1-5-3-4-1\" data-name=\"drawer rating container\">\n                    <i class=\"soko-icon-sm\" data-kid=\"1-5-3-4-1-1\" data-lucide=\"star\" data-name=\"drawer star icon\" style=\"fill:currentColor\">\n                    </i>\n                    <span data-dynamic=\"true\" data-kid=\"1-5-3-4-1-2\" data-name=\"drawer rating text\" data-reason=\"text updated by script\" id=\"drawerRating\">\n                        4.7\n                    </span>\n                </span>\n                <span class=\"soko-drawer-detail\" data-kid=\"1-5-3-4-2\" data-name=\"drawer distance container\">\n                    <i class=\"soko-icon-sm\" data-kid=\"1-5-3-4-2-1\" data-lucide=\"map-pin\" data-name=\"drawer distance icon\">\n                    </i>\n                    <span data-dynamic=\"true\" data-kid=\"1-5-3-4-2-2\" data-name=\"drawer distance text\" data-reason=\"text updated by script\" id=\"drawerDistance\">\n                        1.2 km away\n                    </span>\n                </span>\n                <span class=\"soko-drawer-detail\" data-kid=\"1-5-3-4-3\" data-name=\"drawer delivery container\">\n                    <i class=\"soko-icon-sm\" data-kid=\"1-5-3-4-3-1\" data-lucide=\"truck\" data-name=\"drawer truck icon\">\n                    </i>\n                    Delivery\n                    <span data-dynamic=\"true\" data-kid=\"1-5-3-4-3-2\" data-name=\"drawer delivery price\" data-reason=\"text updated by script\" id=\"drawerDelivery\">\n                        KSh 150\n                    </span>\n                </span>\n            </div>\n            <div class=\"soko-seller-card\" data-kid=\"1-5-3-5\" data-name=\"seller information card\">\n                <img alt=\"\" data-dynamic=\"true\" data-kid=\"1-5-3-5-1\" data-name=\"drawer seller logo image\" data-reason=\"src updated by script\" decoding=\"async\" id=\"drawerLogo\" loading=\"lazy\" src=\"https://picsum.photos/seed/logo1/80/80\"/>\n                <div data-kid=\"1-5-3-5-2\" data-name=\"drawer seller text block\">\n                    <strong data-dynamic=\"true\" data-kid=\"1-5-3-5-2-1\" data-name=\"drawer shop name\" data-reason=\"text updated by script\" id=\"drawerShop\">\n                        Mama Njeri Electronics\n                        <i class=\"soko-icon-sm\" data-kid=\"1-5-3-5-2-1-1\" data-lucide=\"badge-check\" data-name=\"verified check badge icon\" style=\"color:var(--soko-blue)\">\n                        </i>\n                    </strong>\n                    <p data-dynamic=\"true\" data-kid=\"1-5-3-5-2-2\" data-name=\"drawer shop meta details\" data-reason=\"text updated by script\" id=\"drawerShopMeta\">\n                        Verified retailer · 25–35 min\n                    </p>\n                </div>\n            </div>\n            <div class=\"soko-drawer-actions\" data-kid=\"1-5-3-6\" data-name=\"drawer action buttons\">\n                <button class=\"soko-primary-btn\" data-kid=\"1-5-3-6-1\" data-name=\"buy now primary button\" id=\"drawerBuy\">\n                    Buy now\n                    <i class=\"soko-icon-sm\" data-kid=\"1-5-3-6-1-1\" data-lucide=\"arrow-right\" data-name=\"drawer arrow right icon\">\n                    </i>\n                </button>\n                <button class=\"soko-secondary-action\" data-kid=\"1-5-3-6-2\" data-name=\"message seller action button\" id=\"drawerMessage\">\n                    <i class=\"soko-icon-sm\" data-kid=\"1-5-3-6-2-1\" data-lucide=\"message-circle\" data-name=\"drawer message icon\">\n                    </i>\n                    Message\n                </button>\n            </div>\n            <button class=\"soko-ghost-btn\" data-dynamic=\"true\" data-kid=\"1-5-3-7\" data-name=\"add to favorites button\" data-reason=\"text and state updated by script\" id=\"drawerFavorite\" style=\"margin-top:11px; padding-left:2px;\">\n                <i class=\"soko-icon-sm\" data-dynamic=\"true\" data-kid=\"1-5-3-7-1\" data-lucide=\"heart\" data-name=\"drawer heart icon\" data-reason=\"styling updated by script\">\n                </i>\n                <span data-dynamic=\"true\" data-kid=\"1-5-3-7-2\" data-name=\"favorite button text\" data-reason=\"text updated by script\">\n                    Add to favorites\n                </span>\n            </button>\n        </div>\n    </aside>\n    <div class=\"soko-toast\" data-dynamic=\"true\" data-kid=\"1-6\" data-name=\"toast notification component\" data-reason=\"hidden state toggled by script\" hidden=\"\" id=\"toast\">\n        <i class=\"soko-icon-sm\" data-kid=\"1-6-1\" data-lucide=\"check-circle-2\" data-name=\"toast success icon\">\n        </i>\n        <span data-dynamic=\"true\" data-kid=\"1-6-2\" data-name=\"toast message text\" data-reason=\"text updated by script\" id=\"toastText\">\n            Done\n        </span>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    (() => {\n    const app = document.getElementById('sokoApp');\n    const searchInput = document.getElementById('searchInput');\n    const featuredSection = document.getElementById('featuredSection');\n    const featuredCards = [...document.querySelectorAll('#featuredGrid .soko-product')];\n    const allCards = [...document.querySelectorAll('#allListingsGrid .soko-product')];\n    const allListingHeading = document.getElementById('listingHeading');\n    const listingCount = document.getElementById('listingCount');\n    const filterSummary = document.getElementById('filterSummary');\n    const emptyState = document.getElementById('emptyState');\n    const categoryButtons = [...document.querySelectorAll('[data-category]')];\n    const filterButton = document.getElementById('filterButton');\n    const filterPanel = document.getElementById('filterPanel');\n    const buyerContent = document.getElementById('buyerContent');\n    const sellerTeaser = document.getElementById('sellerTeaser');\n    const buyMode = document.getElementById('buyMode');\n    const sellMode = document.getElementById('sellMode');\n    const notificationButton = document.getElementById('notificationButton');\n    const notificationPopover = document.getElementById('notificationPopover');\n    const productDrawer = document.getElementById('productDrawer');\n    const drawerBackdrop = document.getElementById('drawerBackdrop');\n    const toast = document.getElementById('toast');\n    let activeCategory = 'All';\n    let quickFilter = null;\n    let toastTimer;\n\n    const icons = () => window.lucide && window.lucide.createIcons({ attrs: { 'stroke-width': 1.9 } });\n    icons();\n\n    function showToast(message) {\n      document.getElementById('toastText').textContent = message;\n      toast.hidden = false;\n      clearTimeout(toastTimer);\n      toastTimer = setTimeout(() => { toast.hidden = true; }, 3200);\n      icons();\n    }\n\n    function matches(card) {\n      const query = searchInput.value.trim().toLowerCase();\n      const searchable = `${card.dataset.title} ${card.dataset.category} ${card.dataset.shop}`.toLowerCase();\n      const categoryMatch = activeCategory === 'All' || card.dataset.category === activeCategory;\n      const queryMatch = !query || searchable.includes(query);\n      const quickMatch = quickFilter === 'near' ? Number(card.dataset.distance) <= 5 : quickFilter === 'new' ? card.dataset.condition === 'New' : true;\n      return categoryMatch && queryMatch && quickMatch;\n    }\n\n    function renderListings() {\n      const visibleAll = allCards.filter(matches);\n      const visibleFeatured = featuredCards.filter(matches);\n      allCards.forEach(card => { card.hidden = !matches(card); });\n      featuredCards.forEach(card => { card.hidden = !matches(card); });\n      featuredSection.hidden = activeCategory !== 'All' || Boolean(searchInput.value.trim()) || Boolean(quickFilter) || visibleFeatured.length === 0;\n      emptyState.hidden = visibleAll.length !== 0;\n      const query = searchInput.value.trim();\n      const activeFilterLabel = quickFilter === 'near' ? ' within 5 km' : quickFilter === 'new' ? ' with new items' : '';\n      listingCount.textContent = `${visibleAll.length} ${visibleAll.length === 1 ? 'product' : 'products'}${activeCategory !== 'All' ? ` in ${activeCategory}` : ''}${activeFilterLabel} around Nairobi`;\n      filterSummary.textContent = query ? `Search results for “${query}”` : activeCategory === 'All' ? 'Showing all listings near Nairobi' : `Showing ${activeCategory.toLowerCase()} near Nairobi`;\n      allListingHeading.textContent = activeCategory === 'All' ? 'All listings' : activeCategory;\n    }\n\n    function setCategory(category) {\n      activeCategory = category;\n      categoryButtons.forEach(button => { button.dataset.active = button.dataset.category === category ? 'true' : 'false'; });\n      renderListings();\n      document.getElementById('allListingsSection').scrollIntoView({ behavior: 'smooth', block: 'start' });\n    }\n\n    categoryButtons.forEach(button => button.addEventListener('click', () => setCategory(button.dataset.category)));\n    searchInput.addEventListener('input', renderListings);\n    document.querySelectorAll('[data-quick-filter]').forEach(button => button.addEventListener('click', () => {\n      const selected = button.dataset.quickFilter;\n      if (selected === 'reset') { quickFilter = null; searchInput.value = ''; setCategory('All'); }\n      else { quickFilter = quickFilter === selected ? null : selected; document.querySelectorAll('[data-quick-filter]').forEach(item => item.dataset.active = item.dataset.quickFilter === quickFilter ? 'true' : 'false'); renderListings(); }\n    }));\n    filterButton.addEventListener('click', () => { filterPanel.hidden = !filterPanel.hidden; filterButton.dataset.active = String(!filterPanel.hidden); });\n\n    function openDrawer(card) {\n      document.getElementById('drawerImage').src = card.dataset.image;\n      document.getElementById('drawerImage').alt = card.dataset.title;\n      document.getElementById('drawerTitle').textContent = card.dataset.title;\n      document.getElementById('drawerCategory').textContent = card.dataset.category;\n      document.getElementById('drawerCondition').textContent = card.dataset.condition;\n      document.getElementById('drawerPrice').textContent = card.dataset.price;\n      document.getElementById('drawerRating').textContent = card.dataset.rating;\n      document.getElementById('drawerDistance').textContent = `${card.dataset.distance} km away`;\n      document.getElementById('drawerDelivery').textContent = card.dataset.delivery;\n      document.getElementById('drawerShop').childNodes[0].textContent = `${card.dataset.shop} `;\n      document.getElementById('drawerShopMeta').textContent = `Verified retailer · ${card.dataset.eta}`;\n      const logoSeed = card.dataset.shop.includes('Threadline') ? 'logo3' : card.dataset.shop.includes('Kilimani') ? 'logo2' : 'logo1';\n      document.getElementById('drawerLogo').src = `https://picsum.photos/seed/${logoSeed}/80/80`;\n      productDrawer.hidden = false;\n      drawerBackdrop.hidden = false;\n      document.body.style.overflow = 'hidden';\n      icons();\n    }\n    function closeDrawer() { productDrawer.hidden = true; drawerBackdrop.hidden = true; document.body.style.overflow = ''; }\n\n    [...document.querySelectorAll('.soko-product')].forEach(card => {\n      card.addEventListener('click', () => openDrawer(card));\n      card.addEventListener('keydown', event => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openDrawer(card); } });\n    });\n    document.getElementById('drawerClose').addEventListener('click', closeDrawer);\n    drawerBackdrop.addEventListener('click', closeDrawer);\n    document.addEventListener('keydown', event => { if (event.key === 'Escape') { closeDrawer(); notificationPopover.hidden = true; notificationButton.setAttribute('aria-expanded', 'false'); } });\n    document.getElementById('drawerBuy').addEventListener('click', () => { closeDrawer(); showToast('Checkout started — choose M-Pesa, card, or cash on delivery.'); });\n    document.getElementById('drawerMessage').addEventListener('click', () => { closeDrawer(); showToast('Message thread opened with the seller.'); });\n    document.getElementById('drawerFavorite').addEventListener('click', event => { const button = event.currentTarget; const isSaved = button.dataset.saved === 'true'; button.dataset.saved = String(!isSaved); button.innerHTML = `<i data-lucide=\"heart\" class=\"soko-icon-sm\"${!isSaved ? ' style=\"fill:var(--soko-orange); color:var(--soko-orange)\"' : ''}></i> <span>${isSaved ? 'Add to favorites' : 'Saved to favorites'}</span>`; icons(); showToast(isSaved ? 'Removed from favorites' : 'Saved to favorites'); });\n\n    function setMode(mode) {\n      const seller = mode === 'seller';\n      buyMode.dataset.active = String(!seller);\n      sellMode.dataset.active = String(seller);\n      buyerContent.hidden = seller;\n      sellerTeaser.hidden = !seller;\n      document.querySelectorAll('.soko-nav button').forEach(button => button.dataset.active = String(!seller && button.dataset.screen === 'browse'));\n      window.scrollTo({ top: 0, behavior: 'smooth' });\n      showToast(seller ? 'Seller dashboard preview' : 'Buyer marketplace');\n    }\n    buyMode.addEventListener('click', () => setMode('buyer'));\n    sellMode.addEventListener('click', () => setMode('seller'));\n    document.querySelector('[data-action=\"switch-seller\"]').addEventListener('click', () => setMode('seller'));\n    document.querySelector('[data-action=\"start-shopping\"]').addEventListener('click', () => { document.getElementById('categorySection').scrollIntoView({ behavior: 'smooth', block: 'start' }); showToast('Browse local picks near Nairobi'); });\n    document.querySelector('[data-action=\"home\"]').addEventListener('click', () => { setMode('buyer'); window.scrollTo({ top: 0, behavior: 'smooth' }); });\n    document.querySelector('[data-action=\"location\"]').addEventListener('click', () => showToast('Location set to Nairobi'));\n    document.querySelectorAll('[data-action=\"nav\"]').forEach(button => button.addEventListener('click', () => showToast(`${button.dataset.screen === 'messages' ? 'Messages' : button.dataset.screen[0].toUpperCase() + button.dataset.screen.slice(1)} view is ready to open`)));\n    document.querySelectorAll('[data-action=\"toast\"]').forEach(button => button.addEventListener('click', () => showToast(button.dataset.message)));\n    document.querySelector('[data-action=\"reset-search\"]').addEventListener('click', () => { searchInput.value = ''; quickFilter = null; setCategory('All'); document.querySelectorAll('[data-quick-filter]').forEach(item => item.dataset.active = 'false'); });\n\n    notificationButton.addEventListener('click', event => { event.stopPropagation(); notificationPopover.hidden = !notificationPopover.hidden; notificationButton.setAttribute('aria-expanded', String(!notificationPopover.hidden)); icons(); });\n    document.addEventListener('click', event => { if (!event.target.closest('.soko-notification-wrap')) { notificationPopover.hidden = true; notificationButton.setAttribute('aria-expanded', 'false'); } });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-23T21:59:20.318644+00:00",
      "modified": "2026-08-23T22:01:09.314840+00:00",
      "id": "var_7b4e4873f995"
    },
    "var_1b5b825369a6": {
      "type": "variant",
      "label": "Soko — Seller Dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap');\n  .font-poppins { font-family: 'Poppins', Arial, sans-serif; letter-spacing: -0.012em; }\n  .font-lora { font-family: 'Lora', Georgia, serif; }\n  .soko-map-grid { background-image: linear-gradient(rgba(176,174,165,.18) 1px, transparent 1px), linear-gradient(90deg, rgba(176,174,165,.18) 1px, transparent 1px); background-size: 22px 22px; }\n  .pulse-dot { animation: pulse-dot 2.2s ease-in-out infinite; }\n  @keyframes pulse-dot { 0%,100% { box-shadow: 0 0 0 0 rgba(120,140,93,.35); } 50% { box-shadow: 0 0 0 6px rgba(120,140,93,0); } }\n  .toast-in { animation: toast-in .22s ease-out both; }\n  @keyframes toast-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n</style>\n<div class=\"min-h-screen bg-[#faf9f5] text-[#141413] font-lora\" data-kid=\"1\" id=\"app\">\n    <header class=\"sticky top-0 z-40 border-b border-[#e8e6dc] bg-[#faf9f5]/95 backdrop-blur-md\" data-kid=\"1-1\">\n        <div class=\"relative mx-auto flex max-w-6xl items-center gap-3 px-5 py-3\" data-kid=\"1-1-1\">\n            <button aria-label=\"Go to Soko dashboard\" class=\"flex shrink-0 items-center gap-2 text-left\" data-kid=\"1-1-1-1\" id=\"brand-button\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[#d97757] font-poppins text-lg font-bold text-[#faf9f5]\" data-kid=\"1-1-1-1-1\">\n                    S\n                </span>\n                <span class=\"hidden font-poppins text-xl font-bold sm:block\" data-kid=\"1-1-1-1-2\">\n                    Soko\n                </span>\n            </button>\n            <div class=\"relative min-w-0 max-w-[480px] flex-1\" data-kid=\"1-1-1-2\">\n                <i class=\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#b0aea5]\" data-kid=\"1-1-1-2-1\" data-lucide=\"search\" data-name=\"search icon\">\n                </i>\n                <input autocomplete=\"off\" class=\"h-10 w-full rounded-full border border-[#e8e6dc] bg-white pl-9 pr-4 text-sm text-[#141413] outline-none placeholder:text-[#b0aea5] focus:border-[#d97757] focus:ring-2 focus:ring-[#d97757]/15\" data-kid=\"1-1-1-2-2\" id=\"global-search\" placeholder=\"Search products, shops, categories…\" type=\"search\"/>\n            </div>\n            <span class=\"hidden items-center gap-1.5 rounded-full border border-[#e8e6dc] bg-white px-3 py-2 text-xs text-[#69675f] md:inline-flex\" data-kid=\"1-1-1-3\" data-name=\"location display tag\">\n                <i class=\"h-3.5 w-3.5 text-[#d97757]\" data-kid=\"1-1-1-3-1\" data-lucide=\"map-pin\">\n                </i>\n                Nairobi\n            </span>\n            <div class=\"hidden items-center gap-2 rounded-full border border-[#e8e6dc] bg-white p-1 text-xs sm:flex\" data-kid=\"1-1-1-4\">\n                <span class=\"px-2 text-[#b0aea5]\" data-kid=\"1-1-1-4-1\">\n                    Mode\n                </span>\n                <button class=\"rounded-full px-3 py-1.5 font-poppins font-medium text-[#69675f] hover:bg-[#e8e6dc]\" data-kid=\"1-1-1-4-2\" id=\"buy-toggle\" type=\"button\">\n                    Buy\n                </button>\n                <button class=\"rounded-full bg-[#141413] px-3 py-1.5 font-poppins font-medium text-[#faf9f5]\" data-kid=\"1-1-1-4-3\" id=\"sell-toggle\" type=\"button\">\n                    Sell\n                </button>\n            </div>\n            <button aria-expanded=\"false\" aria-label=\"Open notifications\" class=\"relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-[#69675f] hover:bg-[#e8e6dc]\" data-kid=\"1-1-1-5\" id=\"notifications-button\" type=\"button\">\n                <i class=\"h-[18px] w-[18px]\" data-kid=\"1-1-1-5-1\" data-lucide=\"bell\">\n                </i>\n                <span class=\"pulse-dot absolute right-2 top-2 h-2 w-2 rounded-full bg-[#d97757]\" data-dynamic=\"true\" data-kid=\"1-1-1-5-2\" data-name=\"notification pulse dot\" data-reason=\"hidden by script when marked as read\">\n                </span>\n            </button>\n            <button aria-expanded=\"false\" aria-label=\"Open account menu\" class=\"flex shrink-0 items-center gap-2 rounded-full border border-[#e8e6dc] bg-white py-1 pl-1 pr-2 hover:border-[#d97757]/60\" data-kid=\"1-1-1-6\" id=\"account-button\" type=\"button\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#6a9bcc]/20 font-poppins text-[11px] font-semibold text-[#486f98]\" data-kid=\"1-1-1-6-1\">\n                    GM\n                </span>\n                <span class=\"hidden text-left lg:block\" data-kid=\"1-1-1-6-2\">\n                    <span class=\"block font-poppins text-xs font-semibold leading-none\" data-kid=\"1-1-1-6-2-1\">\n                        Grace M.\n                    </span>\n                    <span class=\"mt-1 block text-[10px] text-[#b0aea5]\" data-kid=\"1-1-1-6-2-2\">\n                        Seller account\n                    </span>\n                </span>\n                <i class=\"hidden h-3.5 w-3.5 text-[#b0aea5] lg:block\" data-kid=\"1-1-1-6-3\" data-lucide=\"chevron-down\">\n                </i>\n            </button>\n            <div class=\"absolute right-[104px] top-[62px] hidden w-80 overflow-hidden rounded-2xl border border-[#e8e6dc] bg-white shadow-[0_14px_40px_rgba(20,20,19,.12)]\" data-dynamic=\"true\" data-kid=\"1-1-1-7\" data-name=\"notifications popover\" data-reason=\"toggled by script\" id=\"notifications-popover\">\n                <div class=\"flex items-center justify-between border-b border-[#e8e6dc] px-4 py-3\" data-kid=\"1-1-1-7-1\">\n                    <p class=\"font-poppins text-sm font-semibold\" data-kid=\"1-1-1-7-1-1\">\n                        Notifications\n                    </p>\n                    <span class=\"rounded-full bg-[#d97757]/10 px-2 py-1 text-[10px] font-medium text-[#d97757]\" data-dynamic=\"true\" data-kid=\"1-1-1-7-1-2\" data-name=\"new notifications count tag\" data-reason=\"text updated based on count\">\n                        2 new\n                    </span>\n                </div>\n                <div class=\"divide-y divide-[#e8e6dc]\" data-dynamic=\"true\" data-kid=\"1-1-1-7-2\" data-name=\"notifications list container\" data-reason=\"populated by script\">\n                    <button class=\"flex w-full gap-3 px-4 py-3 text-left hover:bg-[#faf9f5]\" data-kid=\"1-1-1-7-2-1\" type=\"button\">\n                        <span class=\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#d97757]/10 text-[#d97757]\" data-kid=\"1-1-1-7-2-1-1\">\n                            <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-7-2-1-1-1\" data-lucide=\"package-check\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-1-1-7-2-1-2\">\n                            <span class=\"block text-xs font-semibold\" data-kid=\"1-1-1-7-2-1-2-1\">\n                                New order received\n                            </span>\n                            <span class=\"mt-1 block text-[11px] text-[#69675f]\" data-kid=\"1-1-1-7-2-1-2-2\">\n                                SOKO-2481 · KSh 6,950\n                            </span>\n                        </span>\n                    </button>\n                    <button class=\"flex w-full gap-3 px-4 py-3 text-left hover:bg-[#faf9f5]\" data-kid=\"1-1-1-7-2-2\" type=\"button\">\n                        <span class=\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#788c5d]/15 text-[#788c5d]\" data-kid=\"1-1-1-7-2-2-1\">\n                            <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-7-2-2-1-1\" data-lucide=\"wallet-cards\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-1-1-7-2-2-2\">\n                            <span class=\"block text-xs font-semibold\" data-kid=\"1-1-1-7-2-2-2-1\">\n                                Wallet payout is ready\n                            </span>\n                            <span class=\"mt-1 block text-[11px] text-[#69675f]\" data-kid=\"1-1-1-7-2-2-2-2\">\n                                Your available balance is KSh 48,250\n                            </span>\n                        </span>\n                    </button>\n                </div>\n                <button class=\"w-full border-t border-[#e8e6dc] px-4 py-2.5 text-left text-xs font-medium text-[#6a9bcc] hover:bg-[#faf9f5]\" data-kid=\"1-1-1-7-3\" id=\"mark-read\" type=\"button\">\n                    Mark all as read\n                </button>\n            </div>\n            <div class=\"absolute right-5 top-[62px] hidden w-52 overflow-hidden rounded-2xl border border-[#e8e6dc] bg-white p-1.5 shadow-[0_14px_40px_rgba(20,20,19,.12)]\" data-dynamic=\"true\" data-kid=\"1-1-1-8\" data-name=\"account menu popover\" data-reason=\"toggled by script\" id=\"account-popover\">\n                <div class=\"px-3 py-2\" data-kid=\"1-1-1-8-1\">\n                    <p class=\"font-poppins text-xs font-semibold\" data-kid=\"1-1-1-8-1-1\">\n                        Grace Mwangi\n                    </p>\n                    <p class=\"mt-0.5 text-[11px] text-[#69675f]\" data-kid=\"1-1-1-8-1-2\">\n                        Mama Njeri Electronics\n                    </p>\n                </div>\n                <div class=\"border-t border-[#e8e6dc] pt-1.5\" data-kid=\"1-1-1-8-2\">\n                    <button class=\"flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-xs hover:bg-[#faf9f5]\" data-kid=\"1-1-1-8-2-1\" type=\"button\">\n                        <i class=\"h-3.5 w-3.5 text-[#d97757]\" data-kid=\"1-1-1-8-2-1-1\" data-lucide=\"store\">\n                        </i>\n                        Store profile\n                    </button>\n                    <button class=\"flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-xs hover:bg-[#faf9f5]\" data-kid=\"1-1-1-8-2-2\" type=\"button\">\n                        <i class=\"h-3.5 w-3.5 text-[#69675f]\" data-kid=\"1-1-1-8-2-2-1\" data-lucide=\"settings-2\">\n                        </i>\n                        Account settings\n                    </button>\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-6xl space-y-6 px-5 py-8\" data-kid=\"1-2\" id=\"seller-view\">\n        <section class=\"flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <div class=\"mb-2 flex items-center gap-2\" data-kid=\"1-2-1-1-1\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#788c5d]\" data-kid=\"1-2-1-1-1-1\">\n                    </span>\n                    <span class=\"font-poppins text-[11px] font-semibold uppercase tracking-[.14em] text-[#788c5d]\" data-kid=\"1-2-1-1-1-2\">\n                        Seller workspace\n                    </span>\n                </div>\n                <h1 class=\"font-poppins text-3xl font-bold leading-tight sm:text-[34px]\" data-kid=\"1-2-1-1-2\">\n                    Seller dashboard\n                </h1>\n                <p class=\"mt-1 text-sm text-[#69675f]\" data-kid=\"1-2-1-1-3\">\n                    Mama Njeri Electronics\n                    <span class=\"mx-1 text-[#b0aea5]\" data-kid=\"1-2-1-1-3-1\">\n                        ·\n                    </span>\n                    Your shop is live in Nairobi\n                </p>\n            </div>\n            <button class=\"inline-flex h-10 items-center gap-2 rounded-lg bg-[#d97757] px-4 font-poppins text-sm font-semibold text-[#faf9f5] shadow-[0_3px_0_rgba(169,80,54,.2)] hover:bg-[#c96749]\" data-kid=\"1-2-1-2\" id=\"new-listing-button\" type=\"button\">\n                <i class=\"h-4 w-4\" data-kid=\"1-2-1-2-1\" data-lucide=\"plus\">\n                </i>\n                New listing\n            </button>\n        </section>\n        <section aria-label=\"Shop performance\" class=\"grid grid-cols-2 gap-4 lg:grid-cols-4\" data-kid=\"1-2-2\">\n            <article class=\"rounded-2xl border border-[#e8e6dc] bg-white p-4\" data-kid=\"1-2-2-1\">\n                <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-1-1\">\n                    <span class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[#d97757]/15 text-[#d97757]\" data-kid=\"1-2-2-1-1-1\">\n                        <i class=\"h-[17px] w-[17px]\" data-kid=\"1-2-2-1-1-1-1\" data-lucide=\"wallet\">\n                        </i>\n                    </span>\n                    <span class=\"inline-flex items-center gap-0.5 font-poppins text-[11px] font-semibold text-[#788c5d]\" data-kid=\"1-2-2-1-1-2\">\n                        <i class=\"h-3 w-3\" data-kid=\"1-2-2-1-1-2-1\" data-lucide=\"arrow-up-right\">\n                        </i>\n                        12%\n                    </span>\n                </div>\n                <p class=\"mt-3 font-poppins text-[23px] font-bold\" data-kid=\"1-2-2-1-2\">\n                    KSh 48,250\n                </p>\n                <p class=\"mt-0.5 text-xs text-[#69675f]\" data-kid=\"1-2-2-1-3\">\n                    Wallet balance\n                </p>\n            </article>\n            <article class=\"rounded-2xl border border-[#e8e6dc] bg-white p-4\" data-kid=\"1-2-2-2\">\n                <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-2-1\">\n                    <span class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[#6a9bcc]/15 text-[#6a9bcc]\" data-kid=\"1-2-2-2-1-1\">\n                        <i class=\"h-[17px] w-[17px]\" data-kid=\"1-2-2-2-1-1-1\" data-lucide=\"trending-up\">\n                        </i>\n                    </span>\n                    <span class=\"inline-