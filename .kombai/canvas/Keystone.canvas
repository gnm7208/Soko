      "html": "<style>\n  :root{\n    --bg: #ffffff;\n    --ink: #16181d;\n    --ink-soft: #5b6270;\n    --border: #d7dae0;\n    --border-focus: #16181d;\n    --accent: #17805e;\n    --accent-hover: #126a4d;\n    --accent-tint: #e3f3ec;\n    --link: #0f7a54;\n    --panel-bg: #0b2320;\n    --panel-shape: #2fd08a;\n    --radius-lg: 28px;\n    --radius-md: 14px;\n    --radius-sm: 10px;\n    --font: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  *{ box-sizing: border-box; }\n  html,body{ margin:0; padding:0; }\n  body{\n    font-family: var(--font);\n    color: var(--ink);\n    background: var(--bg);\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .page{\n    display:flex;\n    min-height:100vh;\n    width:100%;\n    overflow-x:hidden;\n  }\n\n  /* -------- Left: auth panel -------- */\n  .panel-left{\n    flex: 1 1 58%;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    padding: 48px 24px;\n    background: var(--bg);\n    min-width: 0;\n  }\n\n  .auth-card{\n    width:100%;\n    max-width: 460px;\n  }\n\n  .logo-mark{\n    width: 56px;\n    height: 56px;\n    border-radius: 50%;\n    background: var(--accent-tint);\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    margin: 0 auto 28px;\n  }\n  .logo-mark svg{ width: 26px; height: 26px; display:block; }\n\n  h1.title{\n    margin: 0 0 10px;\n    text-align:center;\n    font-size: 34px;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: -0.02em;\n  }\n\n  p.subtitle{\n    margin: 0 0 32px;\n    text-align:center;\n    font-size: 15px;\n    color: var(--ink-soft);\n  }\n  p.subtitle a{\n    color: var(--link);\n    text-decoration: underline;\n    font-weight: 600;\n  }\n\n  form{ display:flex; flex-direction:column; gap: 18px; }\n\n  .field{ position: relative; }\n  .field input{\n    width:100%;\n    padding: 18px 20px;\n    font-size: 16px;\n    font-family: inherit;\n    color: var(--ink);\n    background: #fff;\n    border: 1.5px solid var(--border);\n    border-radius: var(--radius-md);\n    outline: none;\n    transition: border-color .15s ease;\n  }\n  .field input::placeholder{ color: #8b909b; }\n  .field input:focus{ border-color: var(--border-focus); }\n\n  .field.has-toggle input{ padding-right: 52px; }\n  .toggle-visibility{\n    position:absolute;\n    right: 16px;\n    top: 50%;\n    transform: translateY(-50%);\n    background: none;\n    border: none;\n    padding: 6px;\n    cursor: pointer;\n    color: #6b7280;\n    display:flex;\n  }\n  .toggle-visibility svg{ width: 20px; height: 20px; }\n  .toggle-visibility:hover{ color: var(--ink); }\n\n  .row-between{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    flex-wrap: wrap;\n    gap: 10px;\n    margin-top: 2px;\n  }\n\n  .checkbox-wrap{\n    display:flex;\n    align-items:center;\n    gap: 10px;\n    font-size: 15px;\n    color: var(--ink);\n    cursor: pointer;\n    user-select:none;\n  }\n  .checkbox-wrap input[type=\"checkbox\"]{\n    appearance:none;\n    -webkit-appearance:none;\n    width: 20px;\n    height: 20px;\n    border: 1.5px solid var(--border);\n    border-radius: 6px;\n    margin: 0;\n    display:grid;\n    place-content:center;\n    cursor:pointer;\n  }\n  .checkbox-wrap input[type=\"checkbox\"]::before{\n    content:\"\";\n    width: 11px;\n    height: 11px;\n    transform: scale(0);\n    background: var(--accent);\n    border-radius: 3px;\n    transition: transform .1s ease;\n  }\n  .checkbox-wrap input[type=\"checkbox\"]:checked::before{ transform: scale(1); }\n\n  a.link{\n    color: var(--link);\n    font-size: 15px;\n    font-weight: 600;\n    text-decoration: none;\n  }\n  a.link:hover{ text-decoration: underline; }\n\n  .btn-primary{\n    margin-top: 6px;\n    width:100%;\n    padding: 17px 20px;\n    font-size: 16px;\n    font-weight: 700;\n    font-family: inherit;\n    color: #fff;\n    background: var(--accent);\n    border: none;\n    border-radius: var(--radius-lg);\n    cursor: pointer;\n    transition: background .15s ease, transform .05s ease;\n  }\n  .btn-primary:hover{ background: var(--accent-hover); }\n  .btn-primary:active{ transform: translateY(1px); }\n\n  .divider{\n    display:flex;\n    align-items:center;\n    gap: 16px;\n    margin: 22px 0 4px;\n    color: var(--ink-soft);\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .06em;\n  }\n  .divider::before, .divider::after{\n    content:\"\";\n    flex:1;\n    height:1px;\n    background: var(--border);\n  }\n\n  .sso-link{\n    display:block;\n    text-align:center;\n    margin-top: 6px;\n    color: var(--link);\n    font-size: 15px;\n    font-weight: 700;\n    text-decoration: none;\n  }\n  .sso-link:hover{ text-decoration: underline; }\n\n  /* -------- Right: decorative panel -------- */\n  .panel-right{\n    flex: 1 1 42%;\n    position: relative;\n    background: var(--panel-bg);\n    overflow: hidden;\n    min-height: 100vh;\n  }\n\n  .pattern{\n    position:absolute;\n    inset:0;\n    background-image:\n      linear-gradient(135deg, transparent 45%, rgba(255,255,255,0.02) 45%),\n      repeating-linear-gradient(\n        0deg,\n        transparent 0, transparent 0\n      );\n    background-color: var(--panel-bg);\n  }\n\n  .pattern svg{\n    position:absolute;\n    inset:0;\n    width:100%;\n    height:100%;\n    display:block;\n  }\n\n  .brand-badge{\n    position:absolute;\n    left: 40px;\n    bottom: 36px;\n    display:flex;\n    align-items:center;\n    gap: 10px;\n    color: #fff;\n    font-weight: 800;\n    font-size: 18px;\n    letter-spacing: -0.01em;\n    z-index: 2;\n  }\n  .brand-badge .mark{\n    width: 32px;\n    height: 32px;\n    border-radius: 9px;\n    background: var(--panel-shape);\n    display:flex;\n    align-items:center;\n    justify-content:center;\n  }\n  .brand-badge .mark svg{ width:16px; height:16px; }\n\n  @media (max-width: 900px){\n    .page{ flex-direction: column; }\n    .panel-right{ order: -1; min-height: 220px; }\n    .panel-left{ padding: 40px 20px; }\n  }\n\n  @media (max-width: 480px){\n    h1.title{ font-size: 28px; }\n    .auth-card{ max-width: 100%; }\n  }\n</style>\n\n  <div class=\"page\" data-kid=\"0\">\n    <main class=\"panel-left\" data-kid=\"1\">\n      <div class=\"auth-card\" data-kid=\"2\">\n        <div class=\"logo-mark\" aria-hidden=\"true\" data-kid=\"3\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" data-kid=\"4\">\n            <path d=\"M6 20V4h6.2a5 5 0 0 1 3.4 8.6L20 20h-3.6l-4-6.8H9V20H6Zm3-9.4h3.2a2.2 2.2 0 0 0 0-4.4H9v4.4Z\" fill=\"#17805e\" data-kid=\"5\"></path>\n          </svg>\n        </div>\n\n        <h1 class=\"title\" data-kid=\"6\">Welcome back</h1>\n        <p class=\"subtitle\" data-kid=\"7\">First time at Solace? <a href=\"#\" data-kid=\"8\">Create an account</a></p>\n\n        <form data-kid=\"9\">\n          <div class=\"field\" data-kid=\"10\">\n            <input type=\"email\" name=\"email\" placeholder=\"Work email\" autocomplete=\"username\" data-kid=\"11\">\n          </div>\n\n          <div class=\"field has-toggle\" data-kid=\"12\">\n            <input id=\"pw\" type=\"password\" name=\"password\" placeholder=\"Password\" autocomplete=\"current-password\" data-kid=\"13\">\n            <button type=\"button\" class=\"toggle-visibility\" aria-label=\"Show password\" onclick=\"\n              const i=document.getElementById('pw');\n              i.type = i.type==='password' ? 'text' : 'password';\n            \" data-kid=\"14\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"15\">\n                <path d=\"M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12Z\" data-kid=\"16\"></path>\n                <circle cx=\"12\" cy=\"12\" r=\"3.2\" data-kid=\"17\"></circle>\n              </svg>\n            </button>\n          </div>\n\n          <div class=\"row-between\" data-kid=\"18\">\n            <label class=\"checkbox-wrap\" data-kid=\"19\">\n              <input type=\"checkbox\" name=\"remember\" data-kid=\"20\">\n              Keep me signed in\n            </label>\n            <a class=\"link\" href=\"#\" data-kid=\"21\">Forgot password?</a>\n          </div>\n\n          <button type=\"submit\" class=\"btn-primary\" data-kid=\"22\">Sign in</button>\n        </form>\n\n        <div class=\"divider\" data-kid=\"23\">OR</div>\n        <a class=\"sso-link\" href=\"#\" data-kid=\"24\">Sign in with SSO</a>\n      </div>\n    </main>\n\n    <aside class=\"panel-right\" aria-hidden=\"true\" data-kid=\"25\">\n      <div class=\"pattern\" data-kid=\"26\">\n        <svg viewBox=\"0 0 540 1920\" preserveAspectRatio=\"xMidYMin slice\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"27\">\n          <defs data-kid=\"28\">\n            <pattern id=\"wave\" width=\"180\" height=\"180\" patternUnits=\"userSpaceOnUse\" data-kid=\"29\">\n              <rect width=\"180\" height=\"180\" fill=\"#0b2320\" data-kid=\"30\"></rect>\n              <path d=\"M180,0 L180,180 C110,180 30,150 0,60 C-6,40 -4,18 4,0 Z\" fill=\"#2fd08a\" data-kid=\"31\"></path>\n            </pattern>\n          </defs>\n          <rect width=\"540\" height=\"1920\" fill=\"url(#wave)\" data-kid=\"32\"></rect>\n        </svg>\n      </div>\n      <div class=\"brand-badge\" data-kid=\"33\">\n        <span class=\"mark\" data-kid=\"34\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" data-kid=\"35\">\n            <path d=\"M6 20V4h6.2a5 5 0 0 1 3.4 8.6L20 20h-3.6l-4-6.8H9V20H6Zm3-9.4h3.2a2.2 2.2 0 0 0 0-4.4H9v4.4Z\" fill=\"#0b2320\" data-kid=\"36\"></path>\n          </svg>\n        </span>\n        Solace\n      </div>\n    </aside>\n  </div>\n",
