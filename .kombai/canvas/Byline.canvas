      "html": "<style>\n  :root{\n    --bg: #e9ebef;\n    --surface: #ffffff;\n    --ink: #15171c;\n    --ink-soft: #4c5058;\n    --muted: #8a8e97;\n    --border: #e4e6ea;\n    --border-soft: #edeef1;\n    --accent: #3652ff;\n    --accent-soft: #eaedff;\n    --danger: #c4432b;\n    --radius-lg: 18px;\n    --radius-md: 10px;\n    --radius-sm: 8px;\n    --shadow-modal: 0 30px 70px -20px rgba(20,22,30,0.35), 0 8px 24px -8px rgba(20,22,30,0.15);\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  }\n\n  *{ box-sizing: border-box; }\n  html,body{ margin:0; padding:0; }\n  body{\n    background: var(--bg);\n    color: var(--ink);\n    min-height: 100vh;\n    overflow-x: hidden;\n  }\n\n  /* dimmed page chrome behind the modal, for context */\n  .page-chrome{\n    position: relative;\n    padding: 22px clamp(16px,4vw,40px) 0;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    color: #b8bac0;\n    font-size: 14px;\n    font-weight: 600;\n    filter: saturate(0.6);\n  }\n  .page-chrome svg{ width:16px; height:16px; stroke:#b8bac0; }\n\n  .scrim{\n    position: fixed;\n    inset: 0;\n    background: radial-gradient(ellipse at 50% 0%, rgba(0,0,0,0.04), rgba(0,0,0,0.10));\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  .modal-wrap{\n    position: relative;\n    z-index: 1;\n    display: flex;\n    justify-content: center;\n    padding: clamp(20px,4vw,48px) clamp(16px,6vw,64px) 56px;\n  }\n\n  .modal{\n    width: 100%;\n    max-width: 1180px;\n    background: var(--surface);\n    border-radius: var(--radius-lg);\n    box-shadow: var(--shadow-modal);\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n  }\n\n  /* ---------- Cover ---------- */\n  .cover{\n    /* cover photo: Nidheesh Kavalan on Unsplash */\n    position: relative;\n    height: clamp(220px, 28vw, 340px);\n    background:\n      linear-gradient(120deg, rgba(16,35,61,0.55) 0%, rgba(20,58,77,0.30) 45%, rgba(28,143,124,0.30) 100%),\n      url(\"https://images.unsplash.com/photo-1574071216925-911b63088da0?crop=entropy&cs=srgb&fm=jpg&q=80&w=1600\") center/cover no-repeat,\n      linear-gradient(120deg, #10233d 0%, #143a4d 35%, #0f6b63 65%, #1c8f7c 100%);\n    overflow: hidden;\n  }\n  .cover::before{\n    /* subtle marbled streaks, purely decorative gradient shapes */\n    content:\"\";\n    position:absolute; inset:-10%;\n    background:\n      repeating-linear-gradient(105deg, rgba(255,255,255,0.05) 0 2px, transparent 2px 34px),\n      repeating-linear-gradient(35deg, rgba(255,255,255,0.04) 0 1px, transparent 1px 46px);\n    mix-blend-mode: screen;\n  }\n  .cover-actions{\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    display: flex;\n    gap: 10px;\n    z-index: 2;\n  }\n  .cover-btn{\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: rgba(15,17,20,0.55);\n    backdrop-filter: blur(6px);\n    color: #fff;\n    border: 1px solid rgba(255,255,255,0.18);\n    padding: 9px 14px;\n    border-radius: var(--radius-sm);\n    font-size: 13.5px;\n    font-weight: 600;\n    cursor: pointer;\n    white-space: nowrap;\n  }\n  .cover-btn.icon-only{ padding: 9px 10px; }\n  .cover-btn svg{ width:15px; height:15px; }\n\n  .identity{\n    position: absolute;\n    left: clamp(20px,3vw,40px);\n    bottom: 22px;\n    display: flex;\n    align-items: center;\n    gap: 18px;\n    z-index: 2;\n  }\n  .avatar{\n    width: 84px;\n    height: 84px;\n    border-radius: 50%;\n    border: 3px solid rgba(255,255,255,0.85);\n    background: linear-gradient(150deg,#ffd9a8,#ff8fa3 45%,#8f7bff 100%);\n    box-shadow: 0 6px 18px rgba(0,0,0,0.25);\n    flex-shrink: 0;\n  }\n  .identity h1{\n    margin: 0;\n    color: #fff;\n    font-size: clamp(24px,3vw,32px);\n    font-weight: 800;\n    letter-spacing: -0.01em;\n    text-shadow: 0 2px 10px rgba(0,0,0,0.25);\n  }\n  .identity p{\n    margin: 4px 0 0;\n    color: rgba(255,255,255,0.85);\n    font-size: 15px;\n    font-weight: 500;\n  }\n\n  /* ---------- Body ---------- */\n  .body{\n    position: relative;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 0 clamp(24px, 5vw, 72px);\n    padding: 40px clamp(20px,3vw,48px) 28px;\n    max-height: 46vh;\n    min-height: 320px;\n    overflow: hidden;\n  }\n  .body::after{\n    content:\"\";\n    position:absolute;\n    left:0; right:0; bottom:0;\n    height: 64px;\n    background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0.96));\n    pointer-events: none;\n  }\n\n  .col h2{\n    margin: 0 0 22px;\n    font-size: 19px;\n    font-weight: 800;\n    letter-spacing: -0.01em;\n  }\n\n  .field{ margin-bottom: 26px; }\n  .field label{\n    display: block;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--muted);\n    margin-bottom: 10px;\n  }\n  .field input{\n    width: 100%;\n    border: none;\n    border-bottom: 1px solid var(--border);\n    background: transparent;\n    padding: 4px 2px 10px;\n    font-size: 16px;\n    color: var(--ink);\n    font-family: inherit;\n    outline: none;\n  }\n  .field input:focus{ border-bottom-color: var(--accent); }\n  .field input::placeholder{ color: #c3c6cc; }\n  .field .hint{\n    margin: 8px 0 0;\n    font-size: 12.5px;\n    color: var(--muted);\n  }\n\n  /* ---------- Footer ---------- */\n  .footer{\n    display: flex;\n    justify-content: flex-end;\n    gap: 12px;\n    padding: 18px clamp(20px,3vw,48px);\n    border-top: 1px solid var(--border-soft);\n    background: var(--surface);\n    position: relative;\n    z-index: 1;\n  }\n  .btn{\n    border: none;\n    border-radius: var(--radius-sm);\n    padding: 12px 22px;\n    font-size: 14.5px;\n    font-weight: 700;\n    cursor: pointer;\n    font-family: inherit;\n  }\n  .btn-secondary{\n    background: var(--surface);\n    color: var(--ink);\n    border: 1px solid var(--border);\n  }\n  .btn-secondary:hover{ background: #f6f7f8; }\n  .btn-primary{\n    background: var(--ink);\n    color: #fff;\n  }\n  .btn-primary:hover{ background: #262a32; }\n\n  @media (max-width: 760px){\n    .body{ grid-template-columns: 1fr; max-height: none; padding-bottom: 40px; }\n    .body::after{ display:none; }\n    .col + .col{ margin-top: 8px; }\n    .identity{ position: static; margin-top: -46px; padding: 0 20px 18px; }\n    .cover{ height: 200px; }\n    .cover-btn span.label-full{ display:none; }\n    .footer{ flex-direction: column-reverse; }\n    .footer .btn{ width: 100%; text-align: center; }\n  }\n</style>\n\n\n  <div class=\"page-chrome\" aria-hidden=\"true\" data-kid=\"0\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"1\"><path d=\"M19 12H5M12 19l-7-7 7-7\" data-kid=\"2\"></path></svg>\n    Back to workspace\n  </div>\n\n  <div class=\"scrim\" data-kid=\"3\"></div>\n\n  <div class=\"modal-wrap\" data-kid=\"4\">\n    <div class=\"modal\" role=\"dialog\" aria-label=\"Edit profile\" data-kid=\"5\">\n\n      <div class=\"cover\" data-kid=\"6\">\n        <div class=\"cover-actions\" data-kid=\"7\">\n          <button class=\"cover-btn icon-only\" aria-label=\"Edit cover image\" data-kid=\"8\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"9\"><path d=\"M12 20h9\" data-kid=\"10\"></path><path d=\"M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z\" data-kid=\"11\"></path></svg>\n          </button>\n          <button class=\"cover-btn\" data-kid=\"12\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"13\"><path d=\"M3 6h18\" data-kid=\"14\"></path><path d=\"M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\" data-kid=\"15\"></path><path d=\"M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6\" data-kid=\"16\"></path></svg>\n            <span class=\"label-full\" data-kid=\"17\">Remove cover photo</span>\n          </button>\n          <button class=\"cover-btn icon-only\" aria-label=\"More options\" data-kid=\"18\">\n            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" data-kid=\"19\"><circle cx=\"5\" cy=\"12\" r=\"1.6\" data-kid=\"20\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.6\" data-kid=\"21\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.6\" data-kid=\"22\"></circle></svg>\n          </button>\n        </div>\n\n        <div class=\"identity\" data-kid=\"23\">\n          <div class=\"avatar\" role=\"img\" aria-label=\"Priya Kessler — Jake Nackos on Unsplash\" style=\"background:#e4e6ea url('https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&w=200') center/cover no-repeat;\" data-kid=\"24\"></div>\n          <div data-kid=\"25\">\n            <h1 data-kid=\"26\">Priya Kessler</h1>\n            <p data-kid=\"27\">Team Owner</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"body\" data-kid=\"28\">\n        <div class=\"col\" data-kid=\"29\">\n          <h2 data-kid=\"30\">Basic info</h2>\n\n          <div class=\"field\" data-kid=\"31\">\n            <label for=\"fullname\" data-kid=\"32\">Full name</label>\n            <input id=\"fullname\" type=\"text\" value=\"Priya Kessler\" data-kid=\"33\">\n            <p class=\"hint\" data-kid=\"34\">Shown on your public author page and comments</p>\n          </div>\n\n          <div class=\"field\" data-kid=\"35\">\n            <label for=\"email\" data-kid=\"36\">Email</label>\n            <input id=\"email\" type=\"email\" value=\"priya.kessler@meridianhq.com\" data-kid=\"37\">\n            <p class=\"hint\" data-kid=\"38\">Used for sign-in and account notifications</p>\n          </div>\n\n          <div class=\"field\" data-kid=\"39\">\n            <label for=\"slug\" data-kid=\"40\">Slug</label>\n            <input id=\"slug\" type=\"text\" value=\"priya\" data-kid=\"41\">\n            <p class=\"hint\" data-kid=\"42\">meridianhq.com/author/priya</p>\n          </div>\n        </div>\n\n        <div class=\"col\" data-kid=\"43\">\n          <h2 data-kid=\"44\">Details</h2>\n\n          <div class=\"field\" data-kid=\"45\">\n            <label for=\"location\" data-kid=\"46\">Location</label>\n            <input id=\"location\" type=\"text\" placeholder=\"Where are you based?\" data-kid=\"47\">\n            <p class=\"hint\" data-kid=\"48\">Helps teammates know your working hours</p>\n          </div>\n\n          <div class=\"field\" data-kid=\"49\">\n            <label for=\"website\" data-kid=\"50\">Website</label>\n            <input id=\"website\" type=\"url\" placeholder=\"https://yoursite.com\" data-kid=\"51\">\n            <p class=\"hint\" data-kid=\"52\">Link a portfolio, blog, or homepage</p>\n          </div>\n\n          <div class=\"field\" data-kid=\"53\">\n            <label for=\"social\" data-kid=\"54\">Social profile</label>\n            <input id=\"social\" type=\"text\" placeholder=\"@handle\" data-kid=\"55\">\n            <p class=\"hint\" data-kid=\"56\">URL of your public social profile</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"footer\" data-kid=\"57\">\n        <button class=\"btn btn-secondary\" data-kid=\"58\">Cancel</button>\n        <button class=\"btn btn-primary\" data-kid=\"59\">Save &amp; close</button>\n      </div>\n\n    </div>\n  </div>\n\n",
