  "nodes": {
    "node_paste_2e3ee42dd33a": {
      "type": "variant",
      "id": "node_paste_2e3ee42dd33a",
      "label": "Nightfall",
      "html": "<style>\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n    :root {\n      --bg-primary: #0A0F1E;\n      --bg-secondary: #0F1930;\n      --text-primary: #F2EBD8;\n      --text-muted: #8FA0B8;\n      --accent-1: #E8AF4A;\n      --accent-2: #D4637A;\n      --surface-mid: #141C33;\n      --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      background: var(--bg-primary);\n      color: var(--text-primary);\n      font-family: 'Manrope', sans-serif;\n      font-weight: 300;\n      line-height: 1.6;\n      overflow-x: hidden;\n    }\n\n    /* ─── NAV ─────────────────────────────────────────────── */\n\n    #main-nav {\n      position: fixed;\n      top: 0; left: 0; right: 0;\n      z-index: 100;\n      padding: 24px 0;\n      transition: background 400ms ease, padding 400ms ease;\n    }\n    #main-nav.scrolled {\n      background: rgba(10, 15, 30, 0.94);\n      backdrop-filter: blur(14px);\n      -webkit-backdrop-filter: blur(14px);\n      padding: 16px 0;\n    }\n    .nav-inner {\n      max-width: 1440px;\n      margin: 0 auto;\n      padding: 0 6vw;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n    .nav-logo {\n      font-family: 'Italiana', serif;\n      font-weight: 400;\n      font-size: 22px;\n      letter-spacing: 0.06em;\n      color: var(--text-primary);\n      text-decoration: none;\n    }\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 36px;\n    }\n    .nav-links a {\n      color: var(--text-primary);\n      text-decoration: none;\n      font-family: 'Space Mono', monospace;\n      font-size: 10px;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      opacity: 0.75;\n      transition: opacity 200ms;\n    }\n    .nav-links a:hover { opacity: 1; }\n    .nav-links .nav-cta {\n      background: var(--accent-1);\n      color: var(--bg-primary);\n      padding: 8px 20px;\n      opacity: 1;\n    }\n    .nav-links .nav-cta:hover { background: #f0bc5a; }\n\n    /* ─── HERO ────────────────────────────────────────────── */\n\n    .hero {\n      position: relative;\n      width: 100%;\n      height: 100vh;\n      min-height: 600px;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: flex-end;\n      background: var(--bg-primary);\n    }\n    #hero-video {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      will-change: transform, opacity;\n    }\n    .hero-overlay {\n      position: absolute;\n      inset: 0;\n      background: linear-gradient(to bottom,\n        rgba(10,15,30,0.45) 0%,\n        rgba(10,15,30,0.18) 35%,\n        rgba(10,15,30,0.18) 65%,\n        rgba(10,15,30,0.50) 100%);\n    }\n    /* Constellation SVG — upper-left quadrant */\n    .constellation {\n      position: absolute;\n      top: 6%;\n      left: 4%;\n      width: 36vw;\n      max-width: 520px;\n      height: auto;\n      opacity: 0.60;\n      pointer-events: none;\n      z-index: 1;\n    }\n    .constellation-group {\n      animation: slowRotate 120s linear infinite;\n      transform-origin: 250px 200px;\n    }\n    @keyframes slowRotate {\n      to { transform: rotate(360deg); }\n    }\n    /* Vertical rail — far-right strip, rotated 90° */\n    .hero-rail {\n      position: absolute;\n      right: 0;\n      top: 0;\n      bottom: 0;\n      width: 28px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      z-index: 3;\n      pointer-events: none;\n    }\n    .hero-rail span {\n      display: block;\n      font-family: 'Space Mono', monospace;\n      font-size: 9px;\n      letter-spacing: 0.24em;\n      text-transform: uppercase;\n      color: var(--text-muted);\n      opacity: 0.50;\n      white-space: nowrap;\n      transform: rotate(90deg);\n    }\n    /* Hero content block — right-anchored */\n    .hero-content {\n      position: relative;\n      z-index: 2;\n      text-align: right;\n      padding: 0 7vw 0 0;\n      max-width: 54%;\n    }\n    .hero-eyebrow {\n      display: flex;\n      align-items: center;\n      justify-content: flex-end;\n      gap: 10px;\n      font-family: 'Space Mono', monospace;\n      font-size: 10px;\n      letter-spacing: 0.20em;\n      text-transform: uppercase;\n      color: var(--accent-1);\n      margin-bottom: 28px;\n    }\n    .hero-eyebrow::before {\n      content: '✦';\n      font-size: 8px;\n    }\n    .hero-headline {\n      font-family: 'Italiana', serif;\n      font-weight: 400;\n      font-size: clamp(28px, 3.6vw, 50px);\n      line-height: 1.02;\n      letter-spacing: 0.04em;\n      color: var(--text-primary);\n      margin-bottom: 28px;\n      position: relative;\n      overflow: hidden;\n    }\n    /* Wipe-cover block — uses the hero overlay tone, not a new color */\n    .hero-headline::after {\n      content: '';\n      position: absolute;\n      inset: 0;\n      background: #0A0F1E;\n      transform: scaleX(1);\n      transform-origin: right;\n      transition: transform 700ms cubic-bezier(.16,1,.3,1);\n    }\n    .hero-headline.is-in::after {\n      transform: scaleX(0);\n    }\n    .hero-headline .glow {\n      color: var(--accent-1);\n      text-shadow: 0 0 40px rgba(232, 175, 74, 0.55), 0 0 80px rgba(232, 175, 74, 0.25);\n    }\n    .hero-rule {\n      width: 60px;\n      height: 1px;\n      background: var(--accent-1);\n      margin: 0 0 28px auto;\n    }\n    .hero-sub {\n      font-family: 'Manrope', sans-serif;\n      font-size: 16px;\n      font-weight: 300;\n      line-height: 1.68;\n      color: var(--text-primary);\n      opacity: 0.70;\n      margin-bottom: 36px;\n      max-width: 380px;\n      margin-left: auto;\n    }\n    .hero-cta {\n      display: inline-block;\n      background: var(--accent-1);\n      color: var(--bg-primary);\n      font-family: 'Space Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      padding: 14px 28px;\n      text-decoration: none;\n      transition: background 200ms, transform 200ms;\n    }\n    .hero-cta:hover {\n      background: #f0bc5a;\n      transform: translateY(-1px);\n    }\n    .hero-cta:focus-visible {\n      outline: 2px solid var(--accent-1);\n      outline-offset: 3px;\n    }\n    .scroll-indicator {\n      position: absolute;\n      bottom: 36px;\n      left: 50%;\n      transform: translateX(-50%);\n      z-index: 2;\n      opacity: 0.50;\n      animation: scrollBounce 2.2s ease-in-out infinite;\n    }\n    @keyframes scrollBounce {\n      0%, 100% { transform: translateX(-50%) translateY(0); }\n      50% { transform: translateX(-50%) translateY(7px); }\n    }\n\n    /* ─── SECTION 1 — ROUTES (mouse-spotlight-mask-reveal #29) ─ */\n\n    .routes {\n      position: relative;\n      background: var(--bg-secondary);\n      overflow: hidden;\n    }\n    /* Base layer — dim image */\n    .routes-bg-base {\n      position: absolute;\n      inset: 0;\n      background: var(--bg-secondary);\n    }\n    .routes-bg-base img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      opacity: 0.18;\n      filter: grayscale(60%);\n      display: block;\n    }\n    /* Reveal layer — vivid image, masked by spotlight */\n    .routes-bg-reveal {\n      position: absolute;\n      inset: 0;\n      background: var(--bg-secondary);\n      /* mask-image set via JS on mousemove */\n      -webkit-mask-image: radial-gradient(circle at 50% 50%, black 180px, transparent 280px);\n      mask-image: radial-gradient(circle at 50% 50%, black 180px, transparent 280px);\n      transition: -webkit-mask-image 0s, mask-image 0s;\n    }\n    .routes-bg-reveal img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      opacity: 0.75;\n      display: block;\n    }\n    /* Content overlay — always readable */\n    .routes-content {\n      position: relative;\n      z-index: 5;\n      padding: 100px 8vw 100px 6vw;\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 60px;\n      max-width: 1440px;\n      margin: 0 auto;\n      align-items: center;\n    }\n    .routes-text { /* left column */ }\n    .routes-cards-col { /* right column */ }\n    .section-eyebrow {\n      font-family: 'Space Mono', monospace;\n      font-size: 10px;\n      letter-spacing: 0.20em;\n      text-transform: uppercase;\n      color: var(--accent-1);\n      margin-bottom: 20px;\n    }\n    .routes-headline {\n      font-family: 'Fraunces', serif;\n      font-weight: 900;\n      font-style: italic;\n      font-variation-settings: 'SOFT' 100, 'opsz' 144;\n      font-size: clamp(40px, 5vw, 68px);\n      line-height: 1.04;\n      color: var(--text-primary);\n      margin-bottom: 24px;\n      opacity: 0;\n      transform: translateY(30px) skewY(5deg);\n      transition: opacity 700ms var(--ease-expo), transform 700ms var(--ease-expo);\n    }\n    .routes-headline.is-in {\n      opacity: 1;\n      transform: translateY(0) skewY(0deg);\n    }\n    .routes-body {\n      font-family: 'Manrope', sans-serif;\n      font-size: 15px;\n      font-weight: 300;\n      line-height: 1.74;\n      color: var(--text-muted);\n      margin-bottom: 36px;\n      max-width: 380px;\n    }\n    .route-cards {\n      display: flex;\n      flex-direction: column;\n      margin-bottom: 32px;\n    }\n    .route-card {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 18px 12px 18px 20px;\n      border-top: 1px solid rgba(143, 160, 184, 0.18);\n      border-left: 3px solid var(--accent-1);\n      cursor: pointer;\n      opacity: 0;\n      transform: translateX(24px);\n      transition: opacity 600ms var(--ease-expo), transform 600ms var(--ease-expo), background 200ms ease;\n    }\n    .route-card:last-child {\n      border-bottom: 1px solid rgba(143, 160, 184, 0.18);\n    }\n    .route-card:hover { background: rgba(232, 175, 74, 0.07); }\n    .route-card.is-in {\n      opacity: 1;\n      transform: translateX(0);\n    }\n    .route-meta {\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n    }\n    .route-name {\n      font-family: 'Fraunces', serif;\n      font-weight: 700;\n      font-style: italic;\n      font-size: 20px;\n      color: var(--text-primary);\n    }\n    .route-region {\n      font-family: 'Space Mono', monospace;\n      font-size: 9px;\n      letter-spacing: 0.18em;\n      text-transform: uppercase;\n      color: var(--text-muted);\n    }\n    .route-right {\n      display: flex;\n      align-items: center;\n      gap: 18px;\n    }\n    .route-duration {\n      font-family: 'Manrope', sans-serif;\n      font-size: 12px;\n      font-weight: 300;\n      color: var(--text-muted);\n    }\n    .route-arrow {\n      font-size: 16px;\n      color: var(--accent-1);\n    }\n    .section-link {\n      font-family: 'Space Mono', monospace;\n      font-size: 10px;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      color: var(--accent-1);\n      text-decoration: none;\n      transition: opacity 200ms;\n    }\n    .section-link:hover { opacity: 0.7; }\n    .section-link:focus-visible { outline: 2px solid var(--accent-1); outline-offset: 3px; }\n\n    /* Touch fallback: spotlight pulses at center when no hover */\n    @keyframes spotlightPulse {\n      0%   { --mx: 30%; --my: 40%; }\n      25%  { --mx: 70%; --my: 55%; }\n      50%  { --mx: 55%; --my: 65%; }\n      75%  { --mx: 40%; --my: 45%; }\n      100% { --mx: 30%; --my: 40%; }\n    }\n\n    /* ─── SECTION 2 — VOICES (word-mask-image-fill #23) ─────── */\n\n    .voices {\n      background: var(--surface-mid);\n      padding: 120px 8vw;\n      overflow: hidden;\n    }\n    .voices-inner {\n      max-width: 1100px;\n      margin: 0 auto;\n    }\n\n    /* Masked headline words */\n    .word-mask-headline {\n      font-family: 'Fraunces', serif;\n      font-weight: 900;\n      font-style: italic;\n      font-variation-settings: 'SOFT' 100, 'opsz' 144;\n      font-size: clamp(44px, 6vw, 80px);\n      line-height: 1.08;\n      margin-bottom: 72px;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.2em;\n    }\n    .wmw {\n      display: inline-block;\n      /* default: neutral text-muted */\n      color: var(--text-muted);\n      transition: color 500ms var(--ease-expo),\n                  -webkit-text-fill-color 500ms var(--ease-expo);\n      cursor: default;\n    }\n    .wmw.filled {\n      /* gold filled when active */\n      color: var(--accent-1);\n      background: linear-gradient(135deg, #E8AF4A 30%, #F2EBD8 80%);\n      -webkit-background-clip: text;\n      background-clip: text;\n      -webkit-text-fill-color: transparent;\n    }\n\n    .voice-block {\n      margin-bottom: 56px;\n      opacity: 0;\n      transform: translateY(20px);\n      transition: opacity 800ms var(--ease-expo), transform 800ms var(--ease-expo);\n    }\n    .voice-block.is-in {\n      opacity: 1;\n      transform: translateY(0);\n    }\n    .voice-primary-block {\n      max-width: 820px;\n      transition-delay: 0ms;\n    }\n    .voice-secondary-block {\n      max-width: 600px;\n      margin-left: auto;\n      text-align: right;\n      transition-delay: 150ms;\n    }\n    .voice-tertiary-block {\n      max-width: 460px;\n      margin: 0 auto;\n      text-align: center;\n      transition-delay: 300ms;\n    }\n    .voice-quote-primary {\n      font-family: 'Fraunces', serif;\n      font-weight: 700;\n      font-style: italic;\n      font-size: clamp(26px, 3vw, 40px);\n      line-height: 1.2;\n      color: var(--accent-1);\n      margin-bottom: 14px;\n    }\n    .voice-quote-secondary {\n      font-family: 'Fraunces', serif;\n      font-weight: 700;\n      font-style: italic;\n      font-size: clamp(20px, 2.2vw, 28px);\n      line-height: 1.28;\n      color: var(--text-primary);\n      margin-bottom: 10px;\n    }\n    .voice-quote-tertiary {\n      font-family: 'Manrope', sans-serif;\n      font-weight: 300;\n      font-style: italic;\n      font-size: 18px;\n      line-height: 1.58;\n      color: var(--text-muted);\n      margin-bottom: 8px;\n    }\n    .voice-cite {\n      font-family: 'Space Mono', monospace;\n      font-size: 10px;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      color: var(--text-muted);\n      opacity: 0.65;\n    }\n\n    /* ─── SECTION 3 — NIGHT CROSSINGS (tilt-card-grid-3d #25) ─ */\n\n    .crossings {\n      background: var(--bg-primary);\n      padding: 120px 6vw;\n    }\n    .crossings-header {\n      max-width: 1440px;\n      margin: 0 auto 80px auto;\n    }\n    .crossings-eyebrow {\n      font-family: 'Space Mono', monospace;\n      font-size: 10px;\n      letter-spacing: 0.20em;\n      text-transform: uppercase;\n      color: var(--accent-1);\n      margin-bottom: 20px;\n    }\n    .crossings-headline {\n      font-family: 'Fraunces', serif;\n      font-weight: 900;\n      font-style: italic;\n      font-variation-settings: 'SOFT' 100, 'opsz' 144;\n      font-size: clamp(38px, 5vw, 64px);\n      line-height: 1.06;\n      color: var(--text-primary);\n      opacity: 0;\n      letter-spacing: 0.4em;\n      transition: letter-spacing 1000ms var(--ease-expo), opacity 800ms var(--ease-expo);\n    }\n    .crossings-headline.is-in {\n      opacity: 1;\n      letter-spacing: 0.01em;\n    }\n    /* 3D perspective parent */\n    .crossing-grid {\n      max-width: 1440px;\n      margin: 0 auto;\n      perspective: 1500px;\n      perspective-origin: 50% 50%;\n    }\n    .crossing-cards-inner {\n      display: grid;\n      grid-template-columns: 44fr 32fr 24fr;\n      gap: 28px;\n      align-items: start;\n      padding-right: 2vw;\n    }\n    .crossing-card {\n      opacity: 0;\n      transform: translateY(32px);\n      transition: opacity 700ms var(--ease-expo), transform 700ms var(--ease-expo);\n      will-change: transform;\n      transform-style: preserve-3d;\n    }\n    .crossing-card.is-in {\n      opacity: 1;\n      /* translateY reset handled; tilt applied on top */\n    }\n    .card-2 {\n      margin-top: 80px;\n      border: 1px solid var(--accent-2);\n      padding: 40px 32px;\n      background: var(--bg-secondary);\n    }\n    .card-3 { margin-top: 160px; }\n    .crossing-card-image-wrap {\n      background: var(--surface-mid);\n      overflow: hidden;\n    }\n    .crossing-card-image {\n      width: 100%;\n      display: block;\n      object-fit: cover;\n    }\n    .card-1 .crossing-card-image { aspect-ratio: 2/3; }\n    .card-3 .crossing-card-image { aspect-ratio: 3/4; }\n    .crossing-card-body { padding: 24px 0 0 0; }\n    .card-2 .crossing-card-body { padding: 0; }\n    .crossing-coords {\n      font-family: 'Space Mono', monospace;\n      font-size: 9px;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      color: var(--accent-1);\n      margin-bottom: 12px;\n    }\n    .crossing-title {\n      font-family: 'Fraunces', serif;\n      font-weight: 700;\n      font-style: italic;\n      font-size: 26px;\n      line-height: 1.18;\n      color: var(--text-primary);\n      margin-bottom: 12px;\n    }\n    .card-2 .crossing-title { font-size: 30px; }\n    .crossing-body {\n      font-family: 'Manrope', sans-serif;\n      font-size: 14px;\n      font-weight: 300;\n      line-height: 1.72;\n      color: var(--text-muted);\n    }\n    .crossing-body + .crossing-body { margin-top: 14px; }\n\n    /* ─── FOOTER ──────────────────────────────────────────── */\n\n    footer {\n      background: var(--bg-primary);\n      padding: 0 6vw 60px 6vw;\n    }\n    .footer-top-rule {\n      height: 1px;\n      background: linear-gradient(90deg, transparent 0%, var(--accent-1) 30%, var(--accent-1) 70%, transparent 100%);\n      margin-bottom: 80px;\n    }\n    .footer-inner {\n      max-width: 1440px;\n      margin: 0 auto;\n      display: grid;\n      grid-template-columns: 1.8fr 1.6fr 1.3fr;\n      gap: 60px;\n      align-items: start;\n    }\n    .footer-logo {\n      display: block;\n      font-family: 'Italiana', serif;\n      font-weight: 400;\n      font-size: clamp(52px, 7vw, 100px);\n      line-height: 0.95;\n      letter-spacing: 0.03em;\n      color: var(--text-primary);\n      text-decoration: none;\n      margin-bottom: 16px;\n    }\n    .footer-tagline {\n      font-family: 'Manrope', sans-serif;\n      font-weight: 300;\n      font-style: italic;\n      font-size: 17px;\n      color: var(--text-muted);\n    }\n    .footer-nav {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 40px;\n    }\n    .footer-col-label {\n      font-family: 'Space Mono', monospace;\n      font-size: 9px;\n      letter-spacing: 0.20em;\n      text-transform: uppercase;\n      color: var(--accent-1);\n      margin-bottom: 20px;\n    }\n    .footer-links-list {\n      list-style: none;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n    .footer-links-list a {\n      font-family: 'Manrope', sans-serif;\n      font-size: 14px;\n      font-weight: 300;\n      color: var(--text-primary);\n      text-decoration: none;\n      opacity: 0.80;\n      transition: opacity 200ms;\n    }\n    .footer-links-list a:hover { opacity: 1; }\n    .footer-links-list a:focus-visible { outline: 2px solid var(--accent-1); outline-offset: 2px; }\n    .footer-links-list .star-bullet::before {\n      content: '✦ ';\n      color: var(--accent-1);\n      font-size: 7px;\n      vertical-align: middle;\n    }\n    .footer-cta-box {\n      border: 1px solid var(--accent-1);\n      padding: 36px 28px;\n      opacity: 0;\n      transform: translateX(30px);\n      transition: opacity 700ms var(--ease-expo), transform 700ms var(--ease-expo);\n    }\n    .footer-cta-box.is-in {\n      opacity: 1;\n      transform: translateX(0);\n    }\n    .footer-cta-copy {\n      font-family: 'Fraunces', serif;\n      font-weight: 700;\n      font-style: italic;\n      font-size: 20px;\n      line-height: 1.48;\n      color: var(--text-primary);\n      margin-bottom: 24px;\n    }\n    .footer-cta-btn {\n      display: inline-block;\n      background: var(--accent-1);\n      color: var(--bg-primary);\n      font-family: 'Space Mono', monospace;\n      font-size: 10px;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      padding: 12px 22px;\n      text-decoration: none;\n      transition: background 200ms;\n    }\n    .footer-cta-btn:hover { background: #f0bc5a; }\n    .footer-cta-btn:focus-visible { outline: 2px solid var(--bg-primary); outline-offset: -3px; }\n    .footer-bottom {\n      max-width: 1440px;\n      margin: 60px auto 0 auto;\n      padding-top: 24px;\n      border-top: 1px solid rgba(143, 160, 184, 0.12);\n      display: flex;\n      justify-content: space-between;\n      font-family: 'Manrope', sans-serif;\n      font-size: 11px;\n      font-weight: 300;\n      color: var(--text-muted);\n      opacity: 0.55;\n    }\n\n    /* ─── MOBILE ─────────────────────────────────────────── */\n\n    @media (max-width: 768px) {\n      .nav-links a:not(.nav-cta) { display: none; }\n      .hero-rail { display: none; }\n\n      .hero-content {\n        max-width: 92%;\n        padding: 0 20px;\n      }\n\n      /* Routes — single column, spotlight still works */\n      .routes-content {\n        grid-template-columns: 1fr;\n        padding: 60px 20px;\n        min-height: auto;\n      }\n\n      /* Voices */\n      .voices { padding: 80px 20px; }\n      .voice-secondary-block {\n        margin-left: 0;\n        text-align: left;\n      }\n      .voice-tertiary-block {\n        margin: 0;\n        text-align: left;\n      }\n\n      /* Crossings — remove tilt, stack vertically */\n      .crossings { padding: 80px 20px; }\n      .crossings-header { max-width: none; }\n      .crossing-cards-inner {\n        grid-template-columns: 1fr;\n      }\n      .card-2,\n      .card-3 {\n        margin-top: 0;\n      }\n      /* No 3D tilt on touch — data-tilt-disabled applied by JS */\n\n      .footer-inner {\n        grid-template-columns: 1fr;\n        gap: 40px;\n      }\n      .footer-nav {\n        grid-template-columns: 1fr 1fr;\n        gap: 24px;\n      }\n      .footer-cta-box {\n        transform: none;\n        opacity: 0;\n      }\n    }\n\n    /* ─── REDUCED MOTION ──────────────────────────────────── */\n\n      </style>\n<link href=\"https://fonts.googleapis.com/css2?family=Italiana&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Manrope:wght@300;400;500&family=Space+Mono:wght@400&display=swap\" rel=\"stylesheet\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n\n\n  \n  <nav id=\"main-nav\" aria-label=\"Main navigation\" data-kid=\"0\">\n    <div class=\"nav-inner\" data-kid=\"1\">\n      <a class=\"nav-logo\" href=\"#\" data-kid=\"2\">Horizon</a>\n      <div class=\"nav-links\" data-kid=\"3\">\n        <a href=\"#routes\" data-kid=\"4\">Expeditions</a>\n        <a href=\"#voices\" data-kid=\"5\">Dispatches</a>\n        <a href=\"#\" data-kid=\"6\">About</a>\n        <a href=\"#\" class=\"nav-cta\" data-kid=\"7\">Begin →</a>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"hero\" id=\"hero\" aria-label=\"Hero\" data-kid=\"8\">\n    <video id=\"hero-video\" autoplay loop muted playsinline poster=\"https://kombai-assets.b-cdn.net/generated_assets/a6a3f100-283a-4cf8-9be9-44c4db7bb4be/be6b8511195d41a6b185d26dd0b98018.png\" data-kid=\"9\">\n      <source src=\"https://kombai-assets.b-cdn.net/generated_assets/a6a3f100-283a-4cf8-9be9-44c4db7bb4be/b965adbcc68e48439b63c2c7e377aeda.mp4\" type=\"video/mp4\" data-kid=\"10\">\n    </video>\n    <div class=\"hero-overlay\" aria-hidden=\"true\" data-kid=\"11\"></div>\n\n    \n    <svg class=\"constellation\" viewBox=\"0 0 500 400\" preserveAspectRatio=\"xMidYMid meet\" aria-hidden=\"true\" focusable=\"false\" data-kid=\"12\">\n      <g class=\"constellation-group\" data-kid=\"13\">\n        <line x1=\"120\" y1=\"90\" x2=\"210\" y2=\"132\" stroke=\"#E8AF4A\" stroke-width=\"0.6\" opacity=\"0.35\" data-kid=\"14\"></line>\n        <line x1=\"210\" y1=\"132\" x2=\"296\" y2=\"106\" stroke=\"#E8AF4A\" stroke-width=\"0.6\" opacity=\"0.30\" data-kid=\"15\"></line>\n        <line x1=\"296\" y1=\"106\" x2=\"372\" y2=\"162\" stroke=\"#F2EBD8\" stroke-width=\"0.4\" opacity=\"0.22\" data-kid=\"16\"></line>\n        <line x1=\"210\" y1=\"132\" x2=\"188\" y2=\"232\" stroke=\"#F2EBD8\" stroke-width=\"0.4\" opacity=\"0.20\" data-kid=\"17\"></line>\n        <line x1=\"188\" y1=\"232\" x2=\"270\" y2=\"292\" stroke=\"#F2EBD8\" stroke-width=\"0.4\" opacity=\"0.18\" data-kid=\"18\"></line>\n        <line x1=\"82\" y1=\"280\" x2=\"188\" y2=\"232\" stroke=\"#F2EBD8\" stroke-width=\"0.4\" opacity=\"0.18\" data-kid=\"19\"></line>\n        <line x1=\"388\" y1=\"242\" x2=\"428\" y2=\"182\" stroke=\"#F2EBD8\" stroke-width=\"0.3\" opacity=\"0.18\" data-kid=\"20\"></line>\n        <line x1=\"428\" y1=\"182\" x2=\"462\" y2=\"212\" stroke=\"#F2EBD8\" stroke-width=\"0.3\" opacity=\"0.18\" data-kid=\"21\"></line>\n        <circle cx=\"120\" cy=\"90\" r=\"2.5\" fill=\"#E8AF4A\" opacity=\"0.85\" data-kid=\"22\"></circle>\n        <circle cx=\"210\" cy=\"132\" r=\"3.5\" fill=\"#E8AF4A\" opacity=\"1.0\" data-kid=\"23\"></circle>\n        <circle cx=\"296\" cy=\"106\" r=\"2.0\" fill=\"#E8AF4A\" opacity=\"0.75\" data-kid=\"24\"></circle>\n        <circle cx=\"372\" cy=\"162\" r=\"1.8\" fill=\"#F2EBD8\" opacity=\"0.60\" data-kid=\"25\"></circle>\n        <circle cx=\"188\" cy=\"232\" r=\"1.5\" fill=\"#F2EBD8\" opacity=\"0.55\" data-kid=\"26\"></circle>\n        <circle cx=\"270\" cy=\"292\" r=\"1.5\" fill=\"#F2EBD8\" opacity=\"0.45\" data-kid=\"27\"></circle>\n        <circle cx=\"82\" cy=\"280\" r=\"2.0\" fill=\"#F2EBD8\" opacity=\"0.50\" data-kid=\"28\"></circle>\n        <circle cx=\"428\" cy=\"182\" r=\"1.2\" fill=\"#F2EBD8\" opacity=\"0.50\" data-kid=\"29\"></circle>\n        <circle cx=\"462\" cy=\"212\" r=\"1.0\" fill=\"#F2EBD8\" opacity=\"0.40\" data-kid=\"30\"></circle>\n        <circle cx=\"388\" cy=\"242\" r=\"1.5\" fill=\"#F2EBD8\" opacity=\"0.45\" data-kid=\"31\"></circle>\n        <circle cx=\"50\" cy=\"58\" r=\"0.8\" fill=\"#F2EBD8\" opacity=\"0.30\" data-kid=\"32\"></circle>\n        <circle cx=\"164\" cy=\"38\" r=\"0.8\" fill=\"#F2EBD8\" opacity=\"0.28\" data-kid=\"33\"></circle>\n        <circle cx=\"342\" cy=\"52\" r=\"1.0\" fill=\"#F2EBD8\" opacity=\"0.30\" data-kid=\"34\"></circle>\n        <circle cx=\"472\" cy=\"88\" r=\"0.8\" fill=\"#F2EBD8\" opacity=\"0.32\" data-kid=\"35\"></circle>\n        <circle cx=\"492\" cy=\"312\" r=\"0.7\" fill=\"#F2EBD8\" opacity=\"0.22\" data-kid=\"36\"></circle>\n        <circle cx=\"28\" cy=\"332\" r=\"0.7\" fill=\"#F2EBD8\" opacity=\"0.28\" data-kid=\"37\"></circle>\n        <circle cx=\"338\" cy=\"342\" r=\"0.8\" fill=\"#F2EBD8\" opacity=\"0.22\" data-kid=\"38\"></circle>\n        <circle cx=\"418\" cy=\"314\" r=\"1.0\" fill=\"#E8AF4A\" opacity=\"0.38\" data-kid=\"39\"></circle>\n        <circle cx=\"152\" cy=\"318\" r=\"0.8\" fill=\"#F2EBD8\" opacity=\"0.25\" data-kid=\"40\"></circle>\n        <circle cx=\"60\" cy=\"160\" r=\"0.8\" fill=\"#F2EBD8\" opacity=\"0.32\" data-kid=\"41\"></circle>\n        <circle cx=\"476\" cy=\"48\" r=\"0.9\" fill=\"#F2EBD8\" opacity=\"0.28\" data-kid=\"42\"></circle>\n      </g>\n    </svg>\n\n    \n    <div class=\"hero-rail\" aria-hidden=\"true\" data-kid=\"43\"><span data-kid=\"44\">DARK SKY EXPEDITIONS · 64°N · 140°E</span></div>\n\n    <div class=\"hero-content\" data-kid=\"45\">\n      <p class=\"hero-eyebrow\" data-kid=\"46\">Expeditions at the edge of the charted world</p>\n      <h1 class=\"hero-headline\" aria-label=\"Where the night goes to work.\" data-kid=\"47\">\n        Where the <span class=\"glow\" data-kid=\"48\">night</span><br data-kid=\"49\">goes to work.\n      </h1>\n      <div class=\"hero-rule\" aria-hidden=\"true\" data-kid=\"50\"></div>\n      <p class=\"hero-sub\" data-kid=\"51\">Elite wilderness expeditions shaped by darkness, silence, and the spaces between stars.</p>\n      <a href=\"#routes\" class=\"hero-cta\" data-kid=\"52\">Begin Your Expedition →</a>\n    </div>\n\n    <div class=\"scroll-indicator\" aria-hidden=\"true\" data-kid=\"53\">\n      <svg width=\"20\" height=\"28\" viewBox=\"0 0 20 28\" fill=\"none\" data-kid=\"54\">\n        <path d=\"M10 2v18M2 16l8 8 8-8\" stroke=\"#E8AF4A\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"55\"></path>\n      </svg>\n    </div>\n  </section>\n\n  \n  <section class=\"routes\" id=\"routes\" aria-label=\"Expedition Routes\" data-kid=\"56\">\n    \n    <div class=\"routes-bg-base\" aria-hidden=\"true\" data-kid=\"57\">\n      <img src=\"https://kombai-assets.b-cdn.net/generated_assets/a6a3f100-283a-4cf8-9be9-44c4db7bb4be/b01137f8a6c945c48713a36ea4581457.png\" alt loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"58\">\n    </div>\n    \n    <div class=\"routes-bg-reveal\" id=\"routes-reveal\" aria-hidden=\"true\" data-kid=\"59\">\n      <img src=\"https://kombai-assets.b-cdn.net/generated_assets/a6a3f100-283a-4cf8-9be9-44c4db7bb4be/b01137f8a6c945c48713a36ea4581457.png\" alt loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"60\">\n    </div>\n    \n    <div class=\"routes-content\" data-kid=\"61\">\n      <div class=\"routes-text\" data-kid=\"62\">\n        <p class=\"section-eyebrow\" data-kid=\"63\">The Expeditions</p>\n        <h2 class=\"routes-headline\" id=\"routes-headline\" data-kid=\"64\">Not a tour.<br data-kid=\"65\">Not a package.</h2>\n        <p class=\"routes-body\" data-kid=\"66\">An expedition shaped around your capacity for wonder. Three continents, one standard: the dark frontier.</p>\n        <a href=\"#\" class=\"section-link\" data-kid=\"67\">View all expeditions →</a>\n      </div>\n      <div class=\"routes-cards-col\" data-kid=\"68\">\n        <div class=\"route-cards\" id=\"route-cards-container\" data-kid=\"69\">\n          <div class=\"route-card\" data-kid=\"70\">\n            <div class=\"route-meta\" data-kid=\"71\">\n              <span class=\"route-name\" data-kid=\"72\">Northern Lights Passage</span>\n              <span class=\"route-region\" data-kid=\"73\">Iceland</span>\n            </div>\n            <div class=\"route-right\" data-kid=\"74\">\n              <span class=\"route-duration\" data-kid=\"75\">14 nights</span>\n              <span class=\"route-arrow\" data-kid=\"76\">→</span>\n            </div>\n          </div>\n          <div class=\"route-card\" data-kid=\"77\">\n            <div class=\"route-meta\" data-kid=\"78\">\n              <span class=\"route-name\" data-kid=\"79\">Atacama Night Trek</span>\n              <span class=\"route-region\" data-kid=\"80\">Chile</span>\n            </div>\n            <div class=\"route-right\" data-kid=\"81\">\n              <span class=\"route-duration\" data-kid=\"82\">9 nights</span>\n              <span class=\"route-arrow\" data-kid=\"83\">→</span>\n            </div>\n          </div>\n          <div class=\"route-card\" data-kid=\"84\">\n            <div class=\"route-meta\" data-kid=\"85\">\n              <span class=\"route-name\" data-kid=\"86\">Namibian Dark Sky Reserve</span>\n              <span class=\"route-region\" data-kid=\"87\">Namibia</span>\n            </div>\n            <div class=\"route-right\" data-kid=\"88\">\n              <span class=\"route-duration\" data-kid=\"89\">11 nights</span>\n              <span class=\"route-arrow\" data-kid=\"90\">→</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"voices\" id=\"voices\" aria-label=\"Traveller Voices\" data-kid=\"91\">\n    <div class=\"voices-inner\" data-kid=\"92\">\n      \n      <p class=\"word-mask-headline\" id=\"wm-headline\" aria-label=\"They chose the dark.\" data-kid=\"93\">\n        <span class=\"wmw\" data-wm=\"0\" data-kid=\"94\">They</span>\n        <span class=\"wmw\" data-wm=\"1\" data-kid=\"95\">chose</span>\n        <span class=\"wmw\" data-wm=\"2\" data-kid=\"96\">the</span>\n        <span class=\"wmw\" data-wm=\"3\" data-kid=\"97\">dark.</span>\n      </p>\n\n      \n      <div class=\"voice-block voice-primary-block\" data-kid=\"98\">\n        <blockquote class=\"voice-quote-primary\" data-kid=\"99\">\"The sky reminded me I was nowhere near home.\"</blockquote>\n        <p class=\"voice-cite\" data-kid=\"100\">— Mara K., Iceland Expedition 2024</p>\n      </div>\n      <div class=\"voice-block voice-secondary-block\" data-kid=\"101\">\n        <blockquote class=\"voice-quote-secondary\" data-kid=\"102\">\"Fourteen nights. Zero regrets.\"</blockquote>\n        <p class=\"voice-cite\" data-kid=\"103\">— James O., Atacama Night Trek 2023</p>\n      </div>\n      <div class=\"voice-block voice-tertiary-block\" data-kid=\"104\">\n        <blockquote class=\"voice-quote-tertiary\" data-kid=\"105\">\"Every horizon crossed left us more certain of the next.\"</blockquote>\n        <p class=\"voice-cite\" data-kid=\"106\">— The Rivas family, Namibia 2024</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"crossings\" id=\"crossings\" aria-label=\"Night Crossings\" data-kid=\"107\">\n    <div class=\"crossings-header\" data-kid=\"108\">\n      <p class=\"crossings-eyebrow\" data-kid=\"109\">Field Dispatches</p>\n      <h2 class=\"crossings-headline\" id=\"crossings-headline\" data-kid=\"110\">Three crossings.<br data-kid=\"111\">One standard.</h2>\n    </div>\n    <div class=\"crossing-grid\" id=\"crossing-grid\" data-kid=\"112\">\n      <div class=\"crossing-cards-inner\" id=\"crossing-cards-container\" data-kid=\"113\">\n        <div class=\"crossing-card card-1\" data-card-z=\"0\" data-kid=\"114\">\n          <div class=\"crossing-card-image-wrap\" data-kid=\"115\">\n            <img class=\"crossing-card-image\" src=\"https://kombai-assets.b-cdn.net/generated_assets/a6a3f100-283a-4cf8-9be9-44c4db7bb4be/c5d9c4a8505f4b26992893f27f0fc54a.png\" alt=\"Night hiker on Bolivian salt flat under starfield\" loading=\"lazy\" onerror=\"this.style.display='none';this.parentElement.style.minHeight='200px'\" data-kid=\"116\">\n          </div>\n          <div class=\"crossing-card-body\" data-kid=\"117\">\n            <p class=\"crossing-coords\" data-kid=\"118\">64°21′S · 30°14′W</p>\n            <h3 class=\"crossing-title\" data-kid=\"119\">The Bolivian Meridian</h3>\n            <p class=\"crossing-body\" data-kid=\"120\">Twelve days on the world's largest mirror. The salt reflects every star above — you walk through the sky.</p>\n          </div>\n        </div>\n        <div class=\"crossing-card card-2\" data-card-z=\"-40\" data-kid=\"121\">\n          <div class=\"crossing-card-body\" data-kid=\"122\">\n            <p class=\"crossing-coords\" data-kid=\"123\">23°52′S · 69°01′W</p>\n            <h3 class=\"crossing-title\" data-kid=\"124\">Atacama: Where the Sky Begins</h3>\n            <p class=\"crossing-body\" data-kid=\"125\">At 5,000 metres, you stop trying to name what you see and start listening to what the silence is saying.</p>\n            <p class=\"crossing-body\" data-kid=\"126\">Nine nights. No phones after sunset. Every expedition is designed to succeed the extraordinary imagination.</p>\n          </div>\n        </div>\n        <div class=\"crossing-card card-3\" data-card-z=\"-80\" data-kid=\"127\">\n          <div class=\"crossing-card-image-wrap\" data-kid=\"128\">\n            <img class=\"crossing-card-image\" src=\"https://kombai-assets.b-cdn.net/generated_assets/a6a3f100-283a-4cf8-9be9-44c4db7bb4be/3679332516594d40876204839de71551.png\" alt=\"Mountain base camp tents glowing under starry sky\" loading=\"lazy\" onerror=\"this.style.display='none';this.parentElement.style.minHeight='180px'\" data-kid=\"129\">\n          </div>\n          <div class=\"crossing-card-body\" data-kid=\"130\">\n            <p class=\"crossing-coords\" data-kid=\"131\">41°50′N · 79°11′E</p>\n            <h3 class=\"crossing-title\" data-kid=\"132\">Tian Shan Night Watch</h3>\n            <p class=\"crossing-body\" data-kid=\"133\">Eleven nights at high altitude. Unfiltered sky above, silence below.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer aria-label=\"Site footer\" data-kid=\"134\">\n    <div class=\"footer-top-rule\" aria-hidden=\"true\" data-kid=\"135\"></div>\n    <div class=\"footer-inner\" data-kid=\"136\">\n      <div class=\"footer-brand\" data-kid=\"137\">\n        <a class=\"footer-logo\" href=\"#\" data-kid=\"138\">Horizon</a>\n        <p class=\"footer-tagline\" data-kid=\"139\">Where the night goes to work.</p>\n      </div>\n      <div class=\"footer-nav\" data-kid=\"140\">\n        <div data-kid=\"141\">\n          <p class=\"footer-col-label\" data-kid=\"142\">Expeditions</p>\n          <ul class=\"footer-links-list\" data-kid=\"143\">\n            <li data-kid=\"144\"><a href=\"#\" class=\"star-bullet\" data-kid=\"145\">Northern Lights Passage</a></li>\n            <li data-kid=\"146\"><a href=\"#\" class=\"star-bullet\" data-kid=\"147\">Atacama Night Trek</a></li>\n            <li data-kid=\"148\"><a href=\"#\" class=\"star-bullet\" data-kid=\"149\">Namibian Dark Sky Reserve</a></li>\n            <li data-kid=\"150\"><a href=\"#\" class=\"star-bullet\" data-kid=\"151\">Tian Shan Night Watch</a></li>\n            <li data-kid=\"152\"><a href=\"#\" class=\"star-bullet\" data-kid=\"153\">View All</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"154\">\n          <p class=\"footer-col-label\" data-kid=\"155\">Company</p>\n          <ul class=\"footer-links-list\" data-kid=\"156\">\n            <li data-kid=\"157\"><a href=\"#\" class=\"star-bullet\" data-kid=\"158\">About Horizon</a></li>\n            <li data-kid=\"159\"><a href=\"#\" class=\"star-bullet\" data-kid=\"160\">Dispatches</a></li>\n            <li data-kid=\"161\"><a href=\"#\" class=\"star-bullet\" data-kid=\"162\">Field Notes</a></li>\n            <li data-kid=\"163\"><a href=\"#\" class=\"star-bullet\" data-kid=\"164\">Contact</a></li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"footer-cta-box\" id=\"footer-cta\" data-kid=\"165\">\n        <p class=\"footer-cta-copy\" data-kid=\"166\">Ready to go somewhere maps don't show?</p>\n        <a href=\"#\" class=\"footer-cta-btn\" data-kid=\"167\">Begin an Expedition →</a>\n      </div>\n    </div>\n    <div class=\"footer-bottom\" data-kid=\"168\">\n      <span data-kid=\"169\">© 2025 Horizon Expeditions</span>\n      <span data-kid=\"170\">Est. 2012 · 2,300+ Crossings Guided</span>\n    </div>\n  </footer>\n\n  <script data-kid=\"171\">\n    // ─── HERO ENTRANCE — mask-reveal wipe ───────────────────\n    const heroHeadline = document.querySelector('.hero-headline');\n    requestAnimationFrame(() => {\n      requestAnimationFrame(() => {\n        if (heroHeadline) heroHeadline.classList.add('is-in');\n      });\n    });\n\n    // ─── SINGLE RAF SCROLL LOOP ─────────────────────────────\n    const mainNav      = document.getElementById('main-nav');\n    const heroVideo    = document.getElementById('hero-video');\n    const wmHeadline   = document.getElementById('wm-headline');\n    const wmWords      = wmHeadline ? wmHeadline.querySelectorAll('.wmw') : [];\n    let scrollY = 0, ticking = false;\n\n    function getTop(el) {\n      return el.getBoundingClientRect().top + window.scrollY;\n    }\n\n    function update() {\n      // Nav scroll\n      mainNav.classList.toggle('scrolled', scrollY > 60);\n\n      // Hero video dim + scale\n      const vp = Math.min(scrollY / (window.innerHeight * 0.6), 1);\n      if (heroVideo) {\n        heroVideo.style.opacity = String(1 - vp * 0.55);\n        heroVideo.style.transform = `scale(${1 + vp * 0.06})`;\n      }\n\n      // Word-mask fill (Section 2 — #23)\n      if (wmWords.length) {\n        const voicesTop    = getTop(document.getElementById('voices'));\n        const voicesHeight = document.getElementById('voices').offsetHeight;\n        const progress     = Math.max(0, Math.min(1, (scrollY - voicesTop + window.innerHeight * 0.7) / (voicesHeight * 0.6)));\n        const totalWords   = wmWords.length;\n        wmWords.forEach((w, i) => {\n          const threshold = (i + 0.5) / totalWords;\n          if (progress >= threshold) {\n            w.classList.add('filled');\n          } else {\n            w.classList.remove('filled');\n          }\n        });\n      }\n\n      ticking = false;\n    }\n\n    window.addEventListener('scroll', () => {\n      scrollY = window.scrollY;\n      if (!ticking) {\n        requestAnimationFrame(update);\n        ticking = true;\n      }\n    }, { passive: true });\n\n    // ─── SPOTLIGHT (#29) ───────────────────────────────────\n    const routesSection = document.querySelector('.routes');\n    const routesReveal  = document.getElementById('routes-reveal');\n    let routesMx = 50, routesMy = 50;\n    let spotlightTicking = false;\n\n    const isTouchDevice = () => window.matchMedia('(hover: none)').matches;\n\n    if (routesSection && routesReveal) {\n      if (!isTouchDevice()) {\n        routesSection.addEventListener('mousemove', (e) => {\n          if (!spotlightTicking) {\n            requestAnimationFrame(() => {\n              const rect = routesSection.getBoundingClientRect();\n              const mx = ((e.clientX - rect.left) / rect.width)  * 100;\n              const my = ((e.clientY - rect.top)  / rect.height) * 100;\n              routesReveal.style.webkitMaskImage =\n                `radial-gradient(circle at ${mx}% ${my}%, black 180px, transparent 280px)`;\n              routesReveal.style.maskImage =\n                `radial-gradient(circle at ${mx}% ${my}%, black 180px, transparent 280px)`;\n              spotlightTicking = false;\n            });\n            spotlightTicking = true;\n          }\n        });\n\n        // Hide reveal when mouse leaves\n        routesSection.addEventListener('mouseleave', () => {\n          routesReveal.style.webkitMaskImage =\n            'radial-gradient(circle at -999px -999px, black 180px, transparent 280px)';\n          routesReveal.style.maskImage =\n            'radial-gradient(circle at -999px -999px, black 180px, transparent 280px)';\n        });\n      } else {\n        // Touch fallback: animate spotlight in sin/cos loop\n        let angle = 0;\n        function pulseSpotlight() {\n          angle += 0.008;\n          const mx = 50 + Math.sin(angle * 1.3) * 28;\n          const my = 50 + Math.cos(angle * 0.9) * 22;\n          routesReveal.style.webkitMaskImage =\n            `radial-gradient(circle at ${mx}% ${my}%, black 160px, transparent 260px)`;\n          routesReveal.style.maskImage =\n            `radial-gradient(circle at ${mx}% ${my}%, black 160px, transparent 260px)`;\n          requestAnimationFrame(pulseSpotlight);\n        }\n        pulseSpotlight();\n      }\n    }\n\n    // ─── 3D TILT (#25) ─────────────────────────────────────\n    const crossingGrid  = document.getElementById('crossing-grid');\n    const crossingCards = document.querySelectorAll('.crossing-card');\n    let tiltTicking = false;\n\n    if (crossingGrid && !isTouchDevice()) {\n      crossingGrid.addEventListener('mousemove', (e) => {\n        if (!tiltTicking) {\n          requestAnimationFrame(() => {\n            const rect = crossingGrid.getBoundingClientRect();\n            const cx   = rect.left + rect.width  / 2;\n            const cy   = rect.top  + rect.height / 2;\n            const dx   = (e.clientX - cx) / (rect.width  / 2);\n            const dy   = (e.clientY - cy) / (rect.height / 2);\n\n            crossingCards.forEach((card, i) => {\n              if (!card.classList.contains('is-in')) return;\n              const baseZ = parseFloat(card.dataset.cardZ) || 0;\n              card.style.transform =\n                `translateY(0px) translateZ(${baseZ}px) rotateX(${-dy * 6}deg) rotateY(${dx * 6}deg)`;\n            });\n            tiltTicking = false;\n          });\n          tiltTicking = true;\n        }\n      });\n\n      crossingGrid.addEventListener('mouseleave', () => {\n        crossingCards.forEach(card => {\n          if (!card.classList.contains('is-in')) return;\n          const baseZ = parseFloat(card.dataset.cardZ) || 0;\n          card.style.transform =\n            `translateY(0px) translateZ(${baseZ}px) rotateX(0deg) rotateY(0deg)`;\n        });\n      });\n    }\n\n    // ─── INTERSECTION OBSERVERS ─────────────────────────────\n    const io = new IntersectionObserver((entries) => {\n      entries.forEach(e => {\n        if (e.isIntersecting) {\n          e.target.classList.add('is-in');\n          io.unobserve(e.target);\n        }\n      });\n    }, { threshold: 0.02, rootMargin: '0px 0px -40px 0px' });\n\n    document.querySelectorAll(\n      '#routes-headline, .voice-block, #crossings-headline, #footer-cta'\n    ).forEach(el => io.observe(el));\n\n    // Route cards stagger\n    const ioRoutes = new IntersectionObserver((entries) => {\n      entries.forEach(e => {\n        if (e.isIntersecting) {\n          e.target.querySelectorAll('.route-card').forEach((card, i) => {\n            setTimeout(() => card.classList.add('is-in'), i * 70);\n          });\n          ioRoutes.unobserve(e.target);\n        }\n      });\n    }, { threshold: 0.04, rootMargin: '0px 0px -20px 0px' });\n\n    const routeContainer = document.getElementById('route-cards-container');\n    if (routeContainer) ioRoutes.observe(routeContainer);\n\n    // Crossing cards — stagger + apply z-separation on entry\n    const ioCrossings = new IntersectionObserver((entries) => {\n      entries.forEach(e => {\n        if (e.isIntersecting) {\n          e.target.querySelectorAll('.crossing-card').forEach((card, i) => {\n            const baseZ = parseFloat(card.dataset.cardZ) || 0;\n            setTimeout(() => {\n              card.classList.add('is-in');\n              card.style.transform = `translateY(0) translateZ(${baseZ}px)`;\n            }, i * 100);\n          });\n          ioCrossings.unobserve(e.target);\n        }\n      });\n    }, { threshold: 0.02, rootMargin: '0px 0px -20px 0px' });\n\n    const crossingContainer = document.getElementById('crossing-cards-container');\n    if (crossingContainer) ioCrossings.observe(crossingContainer);\n  </script>\n",
